---
import Icon from './Icon.astro';
import { waLink } from '../data/site';

interface Props {
  nama: string;
  ukuran?: string;
  perluKonfirmasi?: boolean;
  foto?: string;
  placeholderEmoji?: string;
}

const { nama, ukuran, perluKonfirmasi = false, foto, placeholderEmoji = '🌱' } = Astro.props;

const pesanWa = `Halo Ardelia Bibit, saya mau tanya stok & harga ${nama}`;
---

<article class="produk-card">
  <div class="produk-photo">
    {
      foto ? (
        <img src={foto} alt={`Bibit ${nama} di nursery Ardelia Bibit`} loading="lazy" decoding="async" width="700" height="700" />
      ) : (
        <>
          <span class="produk-photo-emoji" aria-hidden="true">{placeholderEmoji}</span>
          <span class="produk-photo-label">Foto menyusul</span>
        </>
      )
    }
    {perluKonfirmasi && <span class="produk-badge">Konfirmasi stok</span>}
  </div>

  <div class="produk-body">
    <h3>{nama}</h3>
    {ukuran && <p class="produk-ukuran">{ukuran}</p>}
    <a class="produk-wa" href={waLink(pesanWa)} target="_blank" rel="noopener">
      <Icon name="whatsapp" size={16} />
      Tanya Stok &amp; Harga
    </a>
  </div>
</article>

<style>
  .produk-card {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .produk-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 26px rgba(22, 74, 74, 0.1);
  }

  .produk-photo {
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, var(--color-mist), #e7ecdf);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    position: relative;
    overflow: hidden;
  }

  .produk-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .produk-photo-emoji {
    font-size: 28px;
    opacity: 0.55;
  }

  .produk-photo-label {
    font-size: 11px;
    color: var(--color-charcoal-soft);
    font-weight: 500;
  }

  .produk-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    background: var(--color-burnt);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .produk-body {
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .produk-body h3 {
    font-size: 14.5px;
    font-weight: 600;
    font-family: var(--font-body);
    color: var(--color-charcoal);
    line-height: 1.3;
  }

  .produk-ukuran {
    font-size: 12px;
    color: var(--color-charcoal-soft);
  }

  .produk-wa {
    margin-top: auto;
    padding-top: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-leaf-dark);
  }

  .produk-wa:hover {
    color: var(--color-teal-dark);
  }
</style>
