---
import Icon from './Icon.astro';
import { waLink } from '../data/site';

interface Props {
  nama: string;
  deskripsi?: string;
  perluKonfirmasi?: boolean;
  foto?: string;
  placeholderEmoji?: string;
}

const { nama, deskripsi, perluKonfirmasi = false, foto, placeholderEmoji = '🌱' } = Astro.props;

const pesanWa = `Halo Ardelia Bibit, saya mau tanya stok & harga ${nama}`;

// Versi kecil (maks sisi 400px) dibuat khusus untuk kartu produk yang
// kecil ini — browser di HP otomatis pakai versi ini, desktop tetap
// pakai foto aslinya lewat srcset. Lihat playbook §QA performa Agustus 2026.
const fotoSmall = foto?.replace(/\.webp$/, '-sm.webp');
---

<article class="produk-card">
  <div class="produk-photo">
    {
      foto ? (
        <img
          src={foto}
          srcset={`${fotoSmall} 400w, ${foto} 640w`}
          sizes="(max-width: 480px) 45vw, (max-width: 900px) 30vw, 260px"
          alt={`Bibit ${nama} di nursery Ardelia Bibit`}
          loading="lazy"
          decoding="async"
          width="700"
          height="700"
        />
      ) : (
        <>
          <span class="produk-photo-emoji" aria-hidden="true">{placeholderEmoji}</span>
          <span class="produk-photo-label">Foto menyusul</span>
        </>
      )
    }
    {perluKonfirmasi && <span class="produk-badge">Konfirmasi stok</span>}
  </div>

  <div class="produk-body">
    <div class="produk-name-wrap">
      <h3>{nama}</h3>
    </div>
    {deskripsi && (
      <div class="produk-desc-wrap">
        <p class="produk-deskripsi">{deskripsi}</p>
      </div>
    )}
    <p class="produk-cta-note">Ukuran &amp; harga menyesuaikan stok</p>
    <a class="produk-wa btn btn-outline" href={waLink(pesanWa)} target="_blank" rel="noopener">
      <Icon name="whatsapp" size={15} />
      <span class="produk-wa-full">Tanya Stok &amp; Harga</span>
      <span class="produk-wa-short">Tanya Harga</span>
    </a>
  </div>
</article>

<style>
  .produk-card {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  @media (hover: hover) {
    .produk-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 26px rgba(22, 74, 74, 0.1);
    }
  }

  .produk-photo {
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, var(--color-mist), var(--color-mist-deep));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    position: relative;
    overflow: hidden;
  }

  .produk-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .produk-photo-emoji {
    font-size: 28px;
    opacity: 0.55;
  }

  .produk-photo-label {
    font-size: 11px;
    color: var(--color-charcoal-soft);
    font-weight: 500;
  }

  .produk-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    background: var(--color-burnt);
    color: var(--color-paper);
    font-size: 10px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .produk-body {
    padding: 12px 14px 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4px;
    flex: 1;
  }

  /* Nama produk direserve tinggi 2 baris (min-height) supaya kartu tetap
     seragam meski ada nama panjang ("Kelapa Gading Kuning"). Untuk nama
     pendek 1 kata ("Petai"), teks di-bottom-align lewat wrapper flex ini
     supaya nempel ke deskripsi di bawahnya — bukan nempel ke atas dengan
     ruang kosong di bawah (itu penyebab jarak nama↔deskripsi kelihatan
     lebih lebar dari jarak deskripsi↔CTA sebelumnya). */
  .produk-name-wrap {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 2.5em;
  }

  .produk-body h3 {
    font-size: 13.5px;
    font-weight: 600;
    font-family: var(--font-body);
    color: var(--color-charcoal);
    line-height: 1.25;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Deskripsi 1 kalimat per produk. Dinaikkan dari 2 → 3 baris supaya
     mayoritas deskripsi (rata-rata ±87 karakter) terbaca utuh tanpa
     kepotong "..." di tengah kalimat. Wrapper bottom-align sama seperti
     nama produk, untuk deskripsi pendek yang cuma makan 1-2 baris —
     supaya tetap nempel rapi ke baris CTA di bawahnya. text-wrap: pretty
     sudah otomatis berlaku (base style `p` di global.css). */
  .produk-desc-wrap {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 4.05em;
  }

  .produk-deskripsi {
    font-size: 11px;
    color: var(--color-charcoal-soft);
    line-height: 1.35;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Pengganti field `ukuran` statis — teks universal, sama di semua kartu,
     supaya tidak pernah basi kalau ukuran/harga stok berubah (harga & ukuran
     memang sengaja tidak dicantumkan statis, lihat kebijakan di
     PROJECT_KNOWLEDGE.md §1 dan FAQ "Kenapa harga tidak dicantumkan"). */
  .produk-cta-note {
    font-size: 10px;
    font-style: italic;
    color: var(--color-charcoal-soft);
    opacity: 0.75;
    line-height: 1.25;
  }

  .produk-wa {
    margin-top: auto;
    width: 100%;
    justify-content: center;
    gap: 5px;
    padding: 8px 8px;
    font-size: 12px;
    line-height: 1.2;
    border-width: 1.5px;
    white-space: nowrap;
  }

  .produk-wa-short {
    display: none;
  }

  /* Di layar sempit (grid 2 kolom), teks penuh "Tanya Stok & Harga" kepaksa
     wrap 2 baris dan bikin tombolnya keliatan gede/gemuk — ganti versi
     singkat khusus di sini. Tablet/desktop (kartu lebih lebar) tetap teks lengkap. */
  @media (max-width: 480px) {
    .produk-wa {
      padding: 7px 6px;
      font-size: 11.5px;
      gap: 4px;
    }

    .produk-wa-full {
      display: none;
    }

    .produk-wa-short {
      display: inline;
    }
  }
</style>
