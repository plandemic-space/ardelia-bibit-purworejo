---
interface Props {
  eyebrow: string;
  title: string;
  /*
   * titleMain/titleLocation (opsional) — cara menampilkan H1 yang sama
   * persis (kata & tanda baca tidak berubah) dalam 2 baris visual:
   * klausa utama (besar) + klausa lokasi (lebih kecil, warna aksen).
   * titleMain + " " + titleLocation harus sama persis dengan `title`
   * supaya teks H1 yang dibaca Google/screen reader tetap identik —
   * ini murni styling, bukan perubahan copywriting/SEO text.
   * Kalau tidak diisi, h1 tampil seperti sebelumnya (1 baris/wrap alami).
   */
  titleMain?: string;
  titleLocation?: string;
  subtitle?: string;
}

const { eyebrow, title, titleMain, titleLocation, subtitle } = Astro.props;
const hasSplitTitle = Boolean(titleMain && titleLocation);
---

<section class="page-intro">
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1>
      {hasSplitTitle ? (
        <>
          <span class="title-main">{titleMain}</span>{' '}
          <span class="title-location">{titleLocation}</span>
        </>
      ) : (
        title
      )}
    </h1>
    {subtitle && <p class="page-intro-sub">{subtitle}</p>}
  </div>
</section>

<style>
  /*
   * Dulu ada 2 varian: polos (mist background) & foto hero (dipakai cuma
   * di halaman Artikel). Varian foto dihapus 2 Agu 2026 per permintaan
   * owner — biar semua halaman konsisten (satu gaya intro yang sama di
   * semua tempat, termasuk center-align di semua ukuran layar) dan biar
   * halaman Artikel gak nge-load 1 foto hero besar yang nambah beban
   * loading. File foto lamanya (hero-artikel.webp) sudah DIHAPUS dari
   * /public/images/artikel/ per beres-beres 2 Agu 2026 (sempat dibiarin
   * dulu, sekarang beneran dibersihin sesuai catatan lama).
   */
  .page-intro {
    padding: 40px 0 24px;
    background: var(--color-mist);
  }

  .page-intro .wrap {
    text-align: center;
  }

  .page-intro h1 {
    font-size: clamp(28px, 3.6vw, 40px);
    margin: 12px 0 12px;
  }

  /* Dipakai hanya kalau prop titleMain/titleLocation diisi (lihat
     komentar Props di atas) — teks H1 tidak berubah, cuma dipecah
     jadi 2 baris visual dengan hierarki ukuran/warna. */
  .page-intro h1 .title-main {
    display: block;
    font-size: clamp(26px, 3.4vw, 38px);
  }

  .page-intro h1 .title-location {
    display: block;
    font-size: clamp(14px, 1.7vw, 17px);
    font-weight: 400;
    color: var(--color-teal);
    margin-top: 6px;
  }

  .page-intro-sub {
    color: var(--color-charcoal-soft);
    /* 860px (bukan 640px) — dilebarin 2 Agu 2026 khusus biar subtitle
       katalog (paling panjang, ~335 karakter) kebagi rata jadi ~3 baris
       daripada 4 baris yang terlalu padat. Halaman lain (Cara Beli,
       Kontak, dll) subtitle-nya jauh lebih pendek jadi tetap 1 baris
       walau batasnya dilebarin — gak ada efek samping. Satu angka ini
       dipakai semua 5 halaman biar tetap 1 sumber kebenaran, bukan
       override khusus per halaman. Sempat dicoba 820px tapi hasil
       render aslinya (screenshot owner) masih 4 baris + 1 kata nyendiri
       di baris terakhir ("cepat.") — dinaikkan lagi ke 860px. Pencegah
       kata nyendiri sekarang ditangani global lewat `text-wrap: pretty`
       di base style `p` (lihat global.css), jadi gak perlu diulang di
       sini. */
    max-width: 860px;
    margin: 0 auto;
    font-size: 15.5px;
  }
</style>
