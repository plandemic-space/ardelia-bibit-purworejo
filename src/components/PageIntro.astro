---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  /** Opsional — kalau diisi, page-intro jadi hero foto dengan overlay gelap */
  image?: string;
}

const { eyebrow, title, subtitle, image } = Astro.props;
---

<section class:list={['page-intro', { 'page-intro-photo': !!image }]}>
  {image && (
    <div class="page-intro-bg">
      <img src={image} alt="" loading="eager" decoding="async" />
    </div>
  )}
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {subtitle && <p class="page-intro-sub">{subtitle}</p>}
  </div>
</section>

<style>
  .page-intro {
    padding: 48px 0 32px;
    background: var(--color-mist);
  }

  .page-intro h1 {
    font-size: clamp(28px, 3.6vw, 40px);
    margin: 12px 0 12px;
  }

  .page-intro-sub {
    color: var(--color-charcoal-soft);
    max-width: 560px;
    font-size: 15.5px;
  }

  .page-intro-photo {
    position: relative;
    padding: 64px 0;
    background: var(--color-teal-dark);
    overflow: hidden;
    isolation: isolate;
  }

  .page-intro-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .page-intro-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }

  .page-intro-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(15, 51, 41, 0.92) 0%, rgba(15, 51, 41, 0.55) 65%, rgba(15, 51, 41, 0.35) 100%);
  }

  .page-intro-photo .eyebrow {
    color: var(--color-leaf);
  }

  .page-intro-photo h1 {
    color: #fff;
  }

  .page-intro-photo .page-intro-sub {
    color: rgba(255, 255, 255, 0.85);
  }
</style>
