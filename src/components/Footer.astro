---
import Icon from './Icon.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();

// Turunkan handle TikTok & nama halaman Facebook dari URL di site.ts,
// biar tetap satu sumber data (bukan hardcode ulang di sini).
const tiktokHandle = `@${new URL(site.social.tiktok).pathname.replace(/^\/@?/, '')}`;
const facebookLabel = site.name;
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">
          <img src="/images/logo/logo-ardelia-bibit.jpg" alt={`Logo ${site.name}`} width="34" height="34" />
          <span>{site.name}</span>
        </div>
        <p class="footer-tagline">{site.tagline}</p>
      </div>

      <div>
        <p class="footer-heading">Jelajahi</p>
        <ul class="footer-list">
          <li><a href="/katalog">Katalog Bibit</a></li>
          <li><a href="/cara-beli">Cara Beli</a></li>
          <li><a href="/artikel">Artikel</a></li>
          <li><a href="/dokumentasi">Dokumentasi Pengiriman</a></li>
          <li><a href="/tentang">Tentang Kami</a></li>
        </ul>
      </div>

      <div>
        <p class="footer-heading">Kontak &amp; Pengiriman</p>
        <ul class="footer-list footer-list-icon">
          <li>
            <Icon name="whatsapp" size={16} />
            <a href={site.contact.whatsappLink} target="_blank" rel="noopener">{site.contact.whatsappDisplay}</a>
          </li>
          <li>
            <Icon name="youtube" size={16} />
            <a href={site.social.youtube} target="_blank" rel="noopener">{site.name}</a>
          </li>
          <li>
            <Icon name="tiktok" size={16} />
            <a href={site.social.tiktok} target="_blank" rel="noopener">{tiktokHandle}</a>
          </li>
          <li>
            <Icon name="facebook" size={16} />
            <a href={site.social.facebook} target="_blank" rel="noopener">{facebookLabel}</a>
          </li>
          <li>
            <Icon name="map-pin" size={16} />
            <a href={site.contact.googleMapsUrl} target="_blank" rel="noopener">
              {site.contact.address.street}, {site.contact.address.district},{' '}
              {site.contact.address.regency} →
            </a>
          </li>
        </ul>
        <p class="footer-shipping">
          <Icon name="truck" size={14} />
          Kirim ke seluruh Indonesia — dikemas rapi sesuai jenis bibit.
        </p>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} {site.name}. Semua hak cipta dilindungi.</span>
      <span>Melayani sepenuh hati dari Purworejo</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-teal-dark);
    color: rgba(255, 255, 255, 0.88);
    padding: 56px 0 24px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 0.55fr 1.25fr;
    gap: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    color: #fff;
    margin-bottom: 14px;
  }

  .footer-brand img {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
  }

  .footer-tagline {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.68);
    max-width: 300px;
  }

  .footer-heading {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-burnt-onteal);
    margin: 0 0 16px;
  }

  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-list a {
    font-size: 14.5px;
    color: rgba(255, 255, 255, 0.78);
    transition: color 0.15s;
  }

  @media (hover: hover) {
    .footer-list a:hover {
      color: var(--color-leaf);
    }
  }

  .footer-list-icon li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .footer-list-icon :global(svg) {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-leaf);
  }

  .footer-shipping {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 12.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.6);
    margin: 16px 0 0;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .footer-shipping :global(svg) {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-leaf);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 22px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 880px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-grid > div:first-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
