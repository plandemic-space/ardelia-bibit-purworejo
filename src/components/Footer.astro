---
import Icon from './Icon.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">

    <div class="footer-grid">

      <!-- Brand -->
      <div>
        <div class="footer-brand">
          <img
            src="/images/logo/logo-ardelia-bibit.jpg"
            alt={`Logo ${site.name}`}
            width="34"
            height="34"
          />
          <span>{site.name}</span>
        </div>

        <p class="footer-tagline">
          Nursery bibit tanaman terpercaya dari Kemiri, Purworejo.
          Menyediakan bibit buah unggul, tanaman keras, tanaman hias,
          dan rempah berkualitas dengan pengiriman ke seluruh Indonesia.
        </p>

        <div class="footer-social">
          <a href={site.social.youtube} target="_blank" rel="noopener">
            <Icon name="youtube" size={20} />
          </a>

          <a href={site.social.facebook} target="_blank" rel="noopener">
            <Icon name="facebook" size={20} />
          </a>

          <a href={site.social.tiktok} target="_blank" rel="noopener">
            <Icon name="tiktok" size={20} />
          </a>
        </div>
      </div>

      <!-- Hubungi -->
      <div>
        <p class="footer-heading">Hubungi Kami</p>

        <ul>
          <li>
            <a href={`tel:+${site.contact.whatsappNumber}`}>
              {site.contact.whatsappDisplay}
            </a>
          </li>

          <li>
            <a href={site.contact.googleMapsUrl} target="_blank" rel="noopener">
              Lihat Lokasi di Google Maps
            </a>
          </li>

          <li>
            <a href={site.social.youtube} target="_blank">YouTube</a>
          </li>

          <li>
            <a href={site.social.facebook} target="_blank">Facebook</a>
          </li>

          <li>
            <a href={site.social.tiktok} target="_blank">TikTok</a>
          </li>
        </ul>
      </div>

      <!-- Alamat -->
      <div>
        <p class="footer-heading">Kirim Dari</p>

        <ul>
          <li>Dsn. Ngemplak</li>
          <li>{site.contact.address.district}</li>
          <li>{site.contact.address.regency}</li>
          <li>{site.contact.address.province}</li>
        </ul>
      </div>

    </div>

    <div class="footer-bottom">
      <span>
        © {year} {site.name}. Semua hak dilindungi.
      </span>

      <span>
        Melayani pengiriman bibit ke seluruh Indonesia.
      </span>
    </div>

  </div>
</footer>

<style>
  .footer-grid{
    display:grid;
    grid-template-columns:1.4fr 1fr 1fr;
    gap:32px;
    padding-bottom:40px;
    border-bottom:1px solid rgba(255,255,255,.14);
  }

  @media (max-width:880px){
    .footer-grid{
      grid-template-columns:1fr;
    }
  }
</style>
