---
import { site } from '../data/site';

const year = new Date().getFullYear();

// Turunkan handle TikTok & nama halaman Facebook dari URL di site.ts,
// biar tetap satu sumber data (bukan hardcode ulang di sini).
const tiktokHandle = `@${new URL(site.social.tiktok).pathname.replace(/^\/@?/, '')}`;
const facebookLabel = site.name;
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">
          <img src="/images/logo/logo-ardelia-bibit.jpg" alt={`Logo ${site.name}`} width="34" height="34" />
          <span>{site.name}</span>
        </div>
        <p class="footer-tagline">{site.tagline}</p>
      </div>

      <div>
        <p class="footer-heading">Kontak</p>
        <ul class="footer-list">
          <li><a href={`tel:+${site.contact.whatsappNumber}`}>WhatsApp: {site.contact.whatsappDisplay}</a></li>
          <li><a href={site.social.tiktok} target="_blank" rel="noopener">TikTok: {tiktokHandle}</a></li>
          <li><a href={site.social.facebook} target="_blank" rel="noopener">Facebook: {facebookLabel}</a></li>
          <li>
            <a href={site.contact.googleMapsUrl} target="_blank" rel="noopener">Lihat lokasi di Google Maps →</a>
          </li>
        </ul>
      </div>

      <div>
        <p class="footer-heading">Kirim Dari</p>
        <p class="footer-address">
          {site.contact.address.street},<br />
          {site.contact.address.district}, {site.contact.address.regency},<br />
          {site.contact.address.province} {site.contact.address.postalCode}
        </p>
        <p class="footer-note">Chat WA dibalas cepat setiap hari</p>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} {site.name}. Semua hak cipta dilindungi.</span>
      <span>Melayani sepenuh hati dari Purworejo</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-teal-dark);
    color: rgba(255, 255, 255, 0.88);
    padding: 56px 0 24px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 32px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    color: #fff;
    margin-bottom: 14px;
  }

  .footer-brand img {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
  }

  .footer-tagline {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.68);
    max-width: 320px;
  }

  .footer-heading {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-burnt);
    margin: 0 0 16px;
  }

  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-list a {
    font-size: 14.5px;
    color: rgba(255, 255, 255, 0.78);
    transition: color 0.15s;
  }

  .footer-list a:hover {
    color: var(--color-leaf);
  }

  .footer-address {
    font-size: 14.5px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.78);
    margin: 0 0 16px;
  }

  .footer-note {
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 22px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 880px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
