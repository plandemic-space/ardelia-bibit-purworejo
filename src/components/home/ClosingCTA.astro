---
import WhatsAppButton from '../WhatsAppButton.astro';
---

<section class="closing">
  <div class="wrap">
    <div class="closing-card">
      <div class="closing-bg">
        <img src="/images/owner/owner-yarohim-1.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" />
      </div>
      <div class="closing-inner">
        <div class="closing-text">
          <h2>Masih Bingung Memilih Bibit?</h2>
          <p>Ceritakan lokasi dan kebutuhan Anda, kami bantu memilih bibit yang sesuai.</p>
        </div>
        <WhatsAppButton label="Chat WhatsApp Sekarang" variant="outline" class="btn-on-dark" />
      </div>
    </div>
  </div>
</section>

<style>
  .closing {
    background: var(--color-ivory);
    padding: 32px 0 44px;
  }

  .closing-card {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-teal-dark);
  }

  .closing-bg {
    position: absolute;
    inset: 0;
  }

  .closing-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
  }

  .closing-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(15, 51, 41, 0.96) 0%, rgba(15, 51, 41, 0.82) 100%);
  }

  .closing-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    padding: 30px 36px;
  }

  .closing-text h2 {
    font-size: clamp(18px, 2.1vw, 24px);
    color: #fff;
    max-width: 480px;
    margin-bottom: 4px;
  }

  .closing-text p {
    color: rgba(255, 255, 255, 0.75);
    font-size: 13.5px;
    max-width: 440px;
  }

  .closing-inner :global(.btn-on-dark) {
    border-color: rgba(255, 255, 255, 0.5);
    color: #fff;
  }

  .closing-inner :global(.btn-on-dark:hover) {
    background: #fff;
    color: var(--color-teal-dark);
  }

  @media (max-width: 780px) {
    .closing-inner {
      flex-direction: column;
      text-align: center;
      padding: 32px 28px;
    }
  }
</style>
