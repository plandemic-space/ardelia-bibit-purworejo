---
import WhatsAppButton from '../WhatsAppButton.astro';
---

<section class="closing">
  <div class="wrap closing-inner">
    <div class="closing-text">
      <h2>Masih Bingung Memilih Bibit?</h2>
      <p>Ceritakan lokasi dan kebutuhan Anda, kami bantu memilih bibit yang sesuai.</p>
    </div>
    <WhatsAppButton label="Chat WhatsApp Sekarang" />
  </div>
</section>

<style>
  .closing {
    background: var(--color-teal-dark);
  }

  .closing-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .closing-text h2 {
    font-size: clamp(22px, 2.6vw, 30px);
    color: #fff;
    max-width: 480px;
    margin-bottom: 6px;
  }

  .closing-text p {
    color: rgba(255, 255, 255, 0.75);
    font-size: 14.5px;
    max-width: 460px;
  }

  @media (max-width: 780px) {
    .closing-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
