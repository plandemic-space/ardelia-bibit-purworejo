---
import WhatsAppButton from '../WhatsAppButton.astro';
---

<section class="closing">
  <div class="wrap">
    <div class="closing-card">
      <div class="closing-text">
        <span class="closing-icon" aria-hidden="true">🌱</span>
        <div>
          <h2>Masih Bingung Pilih Bibit?</h2>
          <p>Chat WhatsApp, kami bantu pilihkan yang cocok.</p>
        </div>
      </div>
      <WhatsAppButton label="Chat WhatsApp Sekarang" variant="outline" size="sm" class="btn-on-dark" />
    </div>
  </div>
</section>

<style>
  .closing {
    background: var(--color-ivory);
    padding: 12px 0 24px;
  }

  .closing-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    background: var(--color-teal-dark);
    border-radius: var(--radius);
    padding: 14px 22px;
  }

  .closing-text {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .closing-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    font-size: 16px;
  }

  .closing-text h2 {
    font-size: 15px;
    color: #fff;
    line-height: 1.3;
    margin-bottom: 1px;
  }

  .closing-text p {
    color: rgba(255, 255, 255, 0.72);
    font-size: 12px;
    white-space: nowrap;
  }

  .closing-card :global(.btn-on-dark) {
    flex-shrink: 0;
    border-color: rgba(255, 255, 255, 0.5);
    color: #fff;
  }

  .closing-card :global(.btn-on-dark:hover) {
    background: #fff;
    color: var(--color-teal-dark);
  }

  @media (max-width: 620px) {
    .closing-card {
      flex-direction: column;
      text-align: center;
      padding: 20px 18px;
    }

    .closing-text {
      flex-direction: column;
    }

    .closing-text p {
      white-space: normal;
    }
  }
</style>
