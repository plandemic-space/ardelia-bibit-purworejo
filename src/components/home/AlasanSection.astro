---
/**
 * "Kenapa Memilih Ardelia Bibit" — grid 2x2, dipasangkan side-by-side
 * dengan CaraMemesan di index.astro (pola dari mockup homepage).
 * Item ke-4 (Pengiriman Fleksibel) memakai klaim yang sama dengan
 * /cara-beli.astro (opsi ambil sendiri / dikirim, sesuaikan ukuran) —
 * bukan klaim baru.
 */
const alasan = [
  {
    icon: '🌱',
    title: 'Bibit Terseleksi',
    desc: 'Setiap bibit dipilih dan dirawat sebelum dijual.',
  },
  {
    icon: '💬',
    title: 'Konsultasi Dulu',
    desc: 'Belum yakin? Kami bantu memilih yang terbaik.',
  },
  {
    icon: '📍',
    title: 'Nursery Bisa Dikunjungi',
    desc: 'Lihat kondisi bibit secara langsung sebelum membeli.',
  },
  {
    icon: '🚚',
    title: 'Pengiriman Fleksibel',
    desc: 'Menyesuaikan ukuran bibit dan lokasi tujuan.',
  },
];
---

<div class="alasan-col">
  <div class="col-head">
    <p class="eyebrow">Kenapa Memilih Kami</p>
    <h2>Kenapa Memilih Ardelia Bibit?</h2>
  </div>

  <div class="alasan-grid">
    {
      alasan.map((item) => (
        <div class="alasan-card">
          <div class="alasan-icon" aria-hidden="true">{item.icon}</div>
          <div class="alasan-copy">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .col-head {
    margin-bottom: 24px;
    text-align: center;
  }

  .col-head .eyebrow {
    justify-content: center;
  }

  .col-head h2 {
    font-size: clamp(20px, 2.4vw, 26px);
    margin: 10px 0 0;
  }

  .alasan-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .alasan-card {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .alasan-icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 10px;
    background: var(--color-mist);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
  }

  .alasan-card h3 {
    font-size: 14.5px;
    margin-bottom: 4px;
  }

  .alasan-card p {
    font-size: 13px;
    color: var(--color-charcoal-soft);
    line-height: 1.5;
  }

  @media (max-width: 480px) {
    .alasan-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
