---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';

/**
 * Bar 4 poin di bawah hero (pola dari mockup homepage). Sengaja dibuat
 * BEDA isinya dari AlasanSection ("Kenapa Memilih Ardelia Bibit?") yang
 * ada lebih ke bawah di halaman ini — supaya pengunjung tidak baca klaim
 * yang sama dua kali dalam satu scroll. Semua klaim di sini tetap
 * terverifikasi di tempat lain di situs:
 * - Pengiriman Aman → lihat /dokumentasi ("dikemas rapi ... aman sampai tujuan")
 * - Ramah & Jujur → lihat /tentang ("melayani pelanggan dengan ramah dan jujur")
 * Jumlah varietas dihitung otomatis dari data/produk.json supaya tidak pernah basi.
 */
const semuaProduk = await getCollection('produk');
const totalVarietas = semuaProduk.length;

const items = [
  { icon: 'grass', title: `${totalVarietas}+ Varietas`, desc: 'Pilihan bibit lengkap untuk berbagai kebutuhan' },
  { icon: 'truck', title: 'Pengiriman Aman', desc: 'Dikemas rapi, aman sampai tujuan' },
  { icon: 'check', title: 'Ramah & Jujur', desc: 'Terbuka soal kondisi bibit ke pembeli' },
  { icon: 'map-pin', title: 'Bisa Dikunjungi', desc: 'Nursery terbuka untuk dilihat langsung' },
];
---

<section class="trust-bar">
  <div class="wrap trust-grid">
    {
      items.map((item) => (
        <div class="trust-item">
          <span class="trust-icon" aria-hidden="true">
            <Icon name={item.icon} size={20} />
          </span>
          <span class="trust-copy">
            <b>{item.title}</b>
            <span>{item.desc}</span>
          </span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .trust-bar {
    padding: 0;
    margin-top: -8px;
    position: relative;
    z-index: 1;
  }

  .trust-grid {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    box-shadow: 0 12px 32px rgba(15, 51, 41, 0.08);
  }

  .trust-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 22px 20px;
    border-right: 1px solid var(--color-line);
  }

  .trust-item:last-child {
    border-right: none;
  }

  .trust-icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 10px;
    background: var(--color-mist);
    color: var(--color-leaf-dark);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .trust-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .trust-copy b {
    font-size: 14.5px;
    color: var(--color-charcoal);
  }

  .trust-copy span {
    font-size: 12.5px;
    color: var(--color-charcoal-soft);
    line-height: 1.4;
  }

  @media (max-width: 880px) {
    .trust-grid {
      grid-template-columns: 1fr 1fr;
    }

    .trust-item:nth-child(2) {
      border-right: none;
    }

    .trust-item:nth-child(1),
    .trust-item:nth-child(2) {
      border-bottom: 1px solid var(--color-line);
    }
  }

  @media (max-width: 520px) {
    .trust-grid {
      grid-template-columns: 1fr;
    }

    .trust-item {
      border-right: none !important;
      border-bottom: 1px solid var(--color-line);
    }

    .trust-item:last-child {
      border-bottom: none;
    }
  }
</style>
