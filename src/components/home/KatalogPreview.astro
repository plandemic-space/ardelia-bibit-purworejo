---
import { getCollection } from 'astro:content';
import ProdukCard from '../ProdukCard.astro';
import Icon from '../Icon.astro';
import { kategoriBibit } from '../../data/nav';

/**
 * Preview katalog di homepage — mekanisme filter chip ala jualpohon.com
 * (referensi: mockup v7, sudah direview & di-acc). Cuma tampilkan sampel
 * produk (bukan 48 sekaligus) supaya homepage tetap ringan & tidak
 * bertele-tele; link "Lihat Katalog Lengkap" di bawah untuk sisanya.
 */
const semuaProduk = await getCollection('produk');
const totalVarietas = semuaProduk.length;

const jumlahPerGrup = (slug: string) => semuaProduk.filter((p) => p.data.grup === slug).length;

// Sampel terkurasi per grup, urut sesuai kategoriBibit (buah → hias → kayu
// → rempah → perkebunan → pakan ternak). Item PERTAMA di tiap grup dipakai
// sebagai wakil tetap di tab "Semua" (bukan acak) — supaya urutannya selalu
// konsisten: foto 1 = buah, foto 2 = hias, dst. Sengaja tidak memakai foto
// yang sudah dipakai KategoriPreview di atasnya, biar tidak dobel.
const idTerkurasi = [
  'durian-bawor', 'durian-musang-king', 'mangga-kiojay', 'manggis',
  'pucuk-merah', 'palem-merah', 'kelapa-gading-kuning',
  'jati', 'mahoni', 'jabon',
  'jeruk-purut', 'cabe-jawa',
  'lada-perdu',
  'indigofera',
];
const produkSampel = idTerkurasi
  .map((id) => semuaProduk.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

// Satu wakil tetap per grup, urut sesuai kategoriBibit — inilah yang tampil
// duluan di tab "Semua".
const wakilPerGrup = kategoriBibit
  .map((kat) => produkSampel.find((p) => p.data.grup === kat.slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<section class="katalog-preview">
  <div class="wrap">
    <div class="katalog-head">
      <p class="eyebrow">Katalog Bibit</p>
      <h2>Cari Bibit Sesuai Kebutuhan Anda</h2>
    </div>

    <div class="filter-bar" data-filter-bar>
      <button class="chip is-active" type="button" data-filter="semua">
        Semua <span>{totalVarietas}</span>
      </button>
      {
        kategoriBibit.map((kat) => (
          <button class="chip" type="button" data-filter={kat.slug}>
            <Icon name={kat.icon} size={15} /> {kat.label} <span>{jumlahPerGrup(kat.slug)}</span>
          </button>
        ))
      }
    </div>

    <div class="preview-grid" data-preview-grid>
      {
        produkSampel.map((item) => (
          <div
            class="preview-item"
            data-grup={item!.data.grup}
            data-id={item!.id}
            data-wakil={wakilPerGrup.some((w) => w!.id === item!.id) ? 'true' : 'false'}
          >
            <ProdukCard
              nama={item!.data.nama}
              perluKonfirmasi={item!.data.perluKonfirmasi}
              foto={item!.data.foto}
              placeholderEmoji={item!.data.placeholderEmoji}
            />
          </div>
        ))
      }
    </div>

    <p class="katalog-cta">
      <a class="btn btn-outline" href="/katalog">Lihat Katalog Lengkap ({totalVarietas} Varietas) →</a>
    </p>
  </div>
</section>

<style>
  .katalog-preview {
    background: var(--color-mist);
  }

  .katalog-head {
    max-width: 640px;
    margin: 0 auto 24px;
    text-align: center;
  }

  .katalog-head .eyebrow {
    justify-content: center;
  }

  .katalog-head h2 {
    font-size: clamp(24px, 3vw, 32px);
    margin: 12px 0 0;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-bottom: 26px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-charcoal-soft);
    cursor: pointer;
    transition: 0.15s;
  }

  .chip span {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--color-charcoal-soft);
    background: var(--color-mist);
    border-radius: 999px;
    padding: 1px 7px;
  }

  .chip:hover {
    border-color: var(--color-teal);
    color: var(--color-teal-dark);
  }

  .chip.is-active {
    background: var(--color-teal-dark);
    border-color: var(--color-teal-dark);
    color: #fff;
  }

  .chip.is-active span {
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
  }

  .preview-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 14px;
    margin-bottom: 28px;
  }

  .katalog-cta {
    text-align: center;
  }

  @media (max-width: 980px) {
    .preview-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 700px) {
    .preview-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 480px) {
    .preview-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
  }
</style>

<script>
  // Filter ringan khusus preview homepage (independen dari filter di /katalog)
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter-bar] [data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-preview-grid] [data-grup]');

  function tampilkanWakilTetap() {
    // Tab "Semua": satu produk wakil per kategori, urutannya tetap
    // (buah → hias → kayu → rempah → perkebunan → pakan ternak), tidak acak.
    items.forEach((item) => {
      item.style.display = item.dataset.wakil === 'true' ? '' : 'none';
    });
  }

  function tampilkanKategori(slug: string) {
    let visibleCount = 0;
    items.forEach((item) => {
      const match = item.dataset.grup === slug;
      item.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });

    // Fail-safe: jangan sampai grid kosong total kalau ada mismatch data.
    if (visibleCount === 0) {
      items.forEach((item) => {
        item.style.display = '';
      });
    }
  }

  // Tampilan awal: tab "Semua" dengan 1 wakil tetap per kategori.
  tampilkanWakilTetap();

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const slug = chip.dataset.filter ?? 'semua';
      if (slug === 'semua') {
        tampilkanWakilTetap();
      } else {
        tampilkanKategori(slug);
      }
      chips.forEach((c) => c.classList.toggle('is-active', c === chip));
    });
  });
</script>
