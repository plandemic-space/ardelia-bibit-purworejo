---
import { getCollection } from 'astro:content';
import ProdukCard from '../ProdukCard.astro';
import Icon from '../Icon.astro';
import { kategoriBibit } from '../../data/nav';

/**
 * Preview katalog di homepage — mekanisme filter chip ala jualpohon.com.
 *
 * Sistem "rolling": setiap kategori punya pool produk (semua varietas di
 * grup itu yang sudah punya foto asli). Di client-side:
 * - Tab "Semua" -> 1 produk dipilih ACAK dari tiap kategori (6 kategori =
 *   6 kartu), supaya kombinasinya bervariasi tiap kali halaman dimuat,
 *   tapi tetap mewakili keenam kategori.
 * - Tab kategori (mis. "Bibit Buah") -> tampilkan 6 produk ACAK dari pool
 *   kategori itu. Kalau pool kategori itu <= 6 varietas, semuanya tampil
 *   apa adanya (tidak ada yang perlu dirolling) — otomatis mulai rolling
 *   begitu variestasnya bertambah jadi 7+.
 *
 * Semua produk (bukan cuma sampel) dirender ke DOM (hidden by default)
 * supaya pool rolling-nya benar-benar mencakup seluruh varietas per
 * kategori; link "Lihat Katalog Lengkap" tetap ada untuk yang mau lihat
 * semuanya sekaligus dalam 1 halaman.
 */
const semuaProduk = await getCollection('produk');
const totalVarietas = semuaProduk.length;

const poolPerGrup: Record<string, typeof semuaProduk> = {};
for (const kat of kategoriBibit) {
  poolPerGrup[kat.slug] = semuaProduk.filter(
    (p) => p.data.grup === kat.slug && p.data.fotoTersedia && p.data.foto
  );
}

const jumlahPerGrup = (slug: string) => poolPerGrup[slug]?.length ?? 0;

// Urut sesuai kategoriBibit (buah -> hias -> kayu -> rempah -> perkebunan ->
// pakan ternak) supaya urutan tampil di grid selalu konsisten per kategori.
const semuaItemUntukRender = kategoriBibit.flatMap((kat) => poolPerGrup[kat.slug] ?? []);
---

<section class="katalog-preview">
  <div class="wrap">
    <div class="katalog-head">
      <p class="eyebrow">Katalog Bibit</p>
      <h2>Cari Bibit Sesuai Kebutuhan Anda</h2>
    </div>

    <div class="filter-bar" data-filter-bar>
      <button class="chip is-active" type="button" data-filter="semua">
        Semua <span>{totalVarietas}</span>
      </button>
      {
        kategoriBibit.map((kat) => (
          <button class="chip" type="button" data-filter={kat.slug}>
            <Icon name={kat.icon} size={15} /> {kat.label} <span>{jumlahPerGrup(kat.slug)}</span>
          </button>
        ))
      }
    </div>

    <div
      class="preview-grid"
      data-preview-grid
      data-grup-order={JSON.stringify(kategoriBibit.map((k) => k.slug))}
    >
      {
        semuaItemUntukRender.map((item) => (
          <div class="preview-item" data-grup={item.data.grup} data-id={item.id} style="display:none">
            <ProdukCard
              nama={item.data.nama}
              deskripsi={item.data.deskripsi}
              perluKonfirmasi={item.data.perluKonfirmasi}
              foto={item.data.foto}
              placeholderEmoji={item.data.placeholderEmoji}
            />
          </div>
        ))
      }
    </div>

    <p class="katalog-cta">
      <a class="btn btn-outline" href="/katalog">Lihat Katalog Lengkap ({totalVarietas} Varietas) →</a>
    </p>
  </div>
</section>

<style>
  .katalog-preview {
    background: var(--color-mist);
  }

  .katalog-head {
    max-width: 640px;
    margin: 0 auto 24px;
    text-align: center;
  }

  .katalog-head .eyebrow {
    justify-content: center;
  }

  .katalog-head h2 {
    font-size: clamp(24px, 3vw, 32px);
    margin: 12px 0 0;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-bottom: 26px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-charcoal-soft);
    cursor: pointer;
    transition: 0.15s;
  }

  .chip span {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--color-charcoal-soft);
    background: var(--color-mist);
    border-radius: 999px;
    padding: 1px 7px;
  }

  @media (hover: hover) {
    .chip:hover {
      border-color: var(--color-teal);
      color: var(--color-teal-dark);
    }
  }

  .chip.is-active {
    background: var(--color-teal-dark);
    border-color: var(--color-teal-dark);
    color: var(--color-paper);
  }

  .chip.is-active span {
    background: rgba(255, 255, 255, 0.18);
    color: var(--color-paper);
  }

  .preview-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 14px;
    margin-bottom: 28px;
  }

  .katalog-cta {
    text-align: center;
  }

  @media (max-width: 980px) {
    .preview-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 700px) {
    .preview-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 480px) {
    .preview-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
  }
</style>

<script>
  // Filter + "rolling" ringan khusus preview homepage (independen dari
  // filter lengkap di /katalog).
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter-bar] [data-filter]');
  const grid = document.querySelector<HTMLElement>('[data-preview-grid]');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-preview-grid] [data-grup]'));

  const grupOrder: string[] = grid?.dataset.grupOrder ? JSON.parse(grid.dataset.grupOrder) : [];

  const MAKS_TAMPIL = 6;

  function acak<T>(arr: T[]): T[] {
    const hasil = [...arr];
    for (let i = hasil.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [hasil[i], hasil[j]] = [hasil[j], hasil[i]];
    }
    return hasil;
  }

  function sembunyikanSemua() {
    items.forEach((item) => {
      item.style.display = 'none';
    });
  }

  function tampilkanSemua() {
    // Tab "Semua": 1 produk dipilih ACAK dari tiap kategori (rolling),
    // urutan kartu tetap ikut urutan kategori (buah -> hias -> ... ).
    sembunyikanSemua();
    grupOrder.forEach((slug) => {
      const poolKategori = items.filter((item) => item.dataset.grup === slug);
      if (poolKategori.length === 0) return;
      const pilihan = poolKategori[Math.floor(Math.random() * poolKategori.length)];
      pilihan.style.display = '';
    });
  }

  function tampilkanKategori(slug: string) {
    const poolKategori = items.filter((item) => item.dataset.grup === slug);
    sembunyikanSemua();

    if (poolKategori.length === 0) {
      // Fail-safe: jangan sampai grid kosong total kalau ada mismatch data.
      items.forEach((item) => {
        item.style.display = '';
      });
      return;
    }

    // <= 6 varietas: tampilkan semuanya apa adanya (tidak perlu dirolling).
    // > 6 varietas: pilih 6 ACAK dari pool (rolling), otomatis aktif begitu
    // varietas kategori itu bertambah jadi 7+.
    const tampil = poolKategori.length <= MAKS_TAMPIL ? poolKategori : acak(poolKategori).slice(0, MAKS_TAMPIL);
    tampil.forEach((item) => {
      item.style.display = '';
    });
  }

  // Tampilan awal: tab "Semua", rolling 1 produk acak per kategori.
  tampilkanSemua();

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const slug = chip.dataset.filter ?? 'semua';
      if (slug === 'semua') {
        tampilkanSemua();
      } else {
        tampilkanKategori(slug);
      }
      chips.forEach((c) => c.classList.toggle('is-active', c === chip));
    });
  });
</script>
