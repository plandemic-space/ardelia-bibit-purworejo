---
import { getCollection } from 'astro:content';
import { kategoriBibit } from '../../data/nav';

/**
 * Foto per kategori diambil otomatis dari semua produk (grup) yang sudah
 * punya foto asli — bukan cuma 1 foto tetap. Di client-side, satu foto
 * dipilih ACAK dari pool tiap kali halaman dimuat (lihat <script> di bawah),
 * supaya tampilannya bervariasi tapi tetap representasi kategori yang benar.
 */
const semuaProduk = await getCollection('produk');

const fotoPerKategori: Record<string, string[]> = {};
for (const kat of kategoriBibit) {
  const fotos = semuaProduk
    .filter((p) => p.data.grup === kat.slug && p.data.fotoTersedia && p.data.foto)
    .map((p) => p.data.foto as string);
  if (fotos.length > 0) fotoPerKategori[kat.slug] = fotos;
}

// Sementara cuma tampilkan kategori yang sudah punya minimal 1 foto asli.
const kategoriDenganFoto = kategoriBibit.filter((kat) => fotoPerKategori[kat.slug]);
---

<section class="kategori">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Jelajahi Berdasarkan Kebutuhan</p>
      <h2>{kategoriDenganFoto.length} Kategori Bibit, Puluhan Varietas Spesifik</h2>
      <p>
        Nama varietas kami tulis spesifik — misalnya Durian Bawor vs Musang
        King, atau Alpukat Miki vs Aligator — supaya tidak keliru saat pesan.
      </p>
    </div>

    <div class="kategori-grid">
      {
        kategoriDenganFoto.map((kat) => {
          const fotos = fotoPerKategori[kat.slug];
          return (
            <a class="kategori-card" href={kat.href}>
              <span class="kategori-photo" data-fotos={JSON.stringify(fotos)}>
                <img src={fotos[0]} alt={kat.label} loading="lazy" decoding="async" data-kategori-img />
              </span>
              <span class="kategori-info">
                <b>{kat.label}</b>
              </span>
            </a>
          );
        })
      }
    </div>

    <p class="kategori-cta">
      <a class="btn btn-outline" href="/katalog">Lihat Katalog Lengkap →</a>
    </p>
  </div>
</section>

<style>
  .kategori {
    background: var(--color-mist);
  }

  .kategori-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
    margin-bottom: 32px;
  }

  .kategori-card {
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .kategori-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(22, 74, 74, 0.12);
  }

  .kategori-photo {
    aspect-ratio: 1 / 1;
    background: var(--color-mist);
    display: block;
    overflow: hidden;
  }

  .kategori-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
    /* Zoom seragam supaya semua foto (apa pun framing aslinya) kelihatan
       rapat/senada, tidak ada yang terasa "nge-frame" sendiri karena banyak
       ruang kosong di sekitar tanamannya. */
    transform: scale(1.18);
    transform-origin: center;
  }

  .kategori-info {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 10px 8px;
    flex: 1;
  }

  .kategori-info b {
    font-size: 12.5px;
    line-height: 1.3;
    color: var(--color-charcoal);
  }

  .kategori-cta {
    text-align: center;
  }

  @media (max-width: 880px) {
    .kategori-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 520px) {
    .kategori-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  // Pilih 1 foto acak dari pool tiap kategori, setiap halaman dimuat/reload —
  // supaya pengunjung tidak melulu lihat foto yang sama, tapi tetap dalam
  // kategori yang benar (pool foto sudah difilter per grup produk).
  const photoEls = document.querySelectorAll<HTMLElement>('[data-fotos]');
  photoEls.forEach((el) => {
    const raw = el.dataset.fotos;
    if (!raw) return;
    try {
      const fotos: string[] = JSON.parse(raw);
      if (fotos.length <= 1) return;
      const pilihan = fotos[Math.floor(Math.random() * fotos.length)];
      const img = el.querySelector<HTMLImageElement>('[data-kategori-img]');
      if (img && pilihan) img.src = pilihan;
    } catch {
      // Data rusak — biarkan foto default (server-rendered) tampil.
    }
  });
</script>
