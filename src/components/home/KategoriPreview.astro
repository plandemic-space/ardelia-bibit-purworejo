---
import { kategoriBibit } from '../../data/nav';

/** Foto representatif per kategori — dipilih yang gaya framing-nya senada
 * (fokus ke satu tanaman, background blur) supaya tidak ada yang terasa
 * "ngganjel" dibanding yang lain. Sengaja beda dari foto yang dipakai di
 * KatalogPreview di bawahnya, supaya tidak ada foto dobel di satu halaman. */
const fotoPerKategori: Record<string, string> = {
  'bibit-buah': '/images/produk/alpukat-aligator.webp',
  'tanaman-hias': '/images/produk/palem-kuning.webp',
  'pohon-kayu': '/images/produk/sengon-albasia.webp',
  rempah: '/images/produk/pala.webp',
  perkebunan: '/images/produk/petai.webp',
  'pakan-ternak': '/images/produk/kaliandra.webp',
};

// Sementara cuma tampilkan kategori yang sudah punya foto asli (belum ada
// placeholder di section ini) — jumlahnya dihitung otomatis biar tidak perlu
// diubah manual tiap kali foto baru ditambahkan.
const kategoriDenganFoto = kategoriBibit.filter((kat) => fotoPerKategori[kat.slug]);
---

<section class="kategori">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Jelajahi Berdasarkan Kebutuhan</p>
      <h2>{kategoriDenganFoto.length} Kategori Bibit, Puluhan Varietas Spesifik</h2>
      <p>
        Nama varietas kami tulis spesifik — misalnya Durian Bawor vs Musang
        King, atau Alpukat Miki vs Aligator — supaya tidak keliru saat pesan.
      </p>
    </div>

    <div class="kategori-grid">
      {
        kategoriDenganFoto.map((kat) => (
          <a class="kategori-card" href={kat.href}>
            <span class="kategori-photo">
              <img src={fotoPerKategori[kat.slug]} alt={kat.label} loading="lazy" decoding="async" />
            </span>
            <span class="kategori-info">
              <b>{kat.label}</b>
            </span>
          </a>
        ))
      }
    </div>

    <p class="kategori-cta">
      <a class="btn btn-outline" href="/katalog">Lihat Katalog Lengkap →</a>
    </p>
  </div>
</section>

<style>
  .kategori {
    background: var(--color-mist);
  }

  .kategori-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
    margin-bottom: 32px;
  }

  .kategori-card {
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .kategori-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(22, 74, 74, 0.12);
  }

  .kategori-photo {
    aspect-ratio: 1 / 1;
    background: var(--color-mist);
    display: block;
  }

  .kategori-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
  }

  .kategori-info {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 10px 8px;
    flex: 1;
  }

  .kategori-info b {
    font-size: 12.5px;
    line-height: 1.3;
    color: var(--color-charcoal);
  }

  .kategori-cta {
    text-align: center;
  }

  @media (max-width: 880px) {
    .kategori-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 520px) {
    .kategori-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
