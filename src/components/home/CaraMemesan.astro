---
/**
 * Versi ringkas dari 4 langkah di /cara-beli — teksnya sama persis dengan
 * halaman itu supaya tidak ada klaim yang berbeda antara homepage & halaman
 * detail. Dipasangkan side-by-side dengan AlasanSection di index.astro
 * (pola dari mockup homepage).
 */
const langkah = [
  { no: '1', title: 'Pilih Bibit', desc: 'Lihat katalog, atau langsung chat kalau sudah tahu mau tanam apa.' },
  { no: '2', title: 'Chat WhatsApp', desc: 'Kami infokan stok, ukuran, dan harga saat itu juga.' },
  { no: '3', title: 'Sepakati Pengiriman', desc: 'Diambil sendiri atau dikirim, dibicarakan langsung di chat.' },
  { no: '4', title: 'Bibit Siap', desc: 'Setelah sepakat, bibit kami siapkan untuk diambil atau dikirim.' },
];
---

<div class="cara-col">
  <div class="col-head">
    <p class="eyebrow">Cara Memesan</p>
    <h2>Prosesnya Sederhana, Semua Lewat Chat</h2>
  </div>

  <div class="cara-list">
    {
      langkah.map((item, i) => (
        <>
          <div class="cara-step">
            <span class="cara-no">{item.no}</span>
            <div class="cara-copy">
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          </div>
          {i < langkah.length - 1 && <span class="cara-connector" aria-hidden="true" />}
        </>
      ))
    }
  </div>

  <p class="cara-cta">
    <a class="btn btn-outline" href="/cara-beli">Selengkapnya Soal Cara Beli →</a>
  </p>
</div>

<style>
  .col-head {
    margin-bottom: 24px;
    text-align: center;
  }

  .col-head .eyebrow {
    justify-content: center;
  }

  .col-head h2 {
    font-size: clamp(20px, 2.4vw, 26px);
    margin: 10px 0 0;
  }

  .cara-list {
    display: flex;
    flex-direction: column;
    margin-bottom: 24px;
  }

  .cara-step {
    display: flex;
    gap: 14px;
  }

  .cara-no {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--color-teal);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
  }

  .cara-copy h3 {
    font-size: 14.5px;
    margin-bottom: 3px;
  }

  .cara-copy p {
    font-size: 13px;
    color: var(--color-charcoal-soft);
    line-height: 1.5;
  }

  .cara-connector {
    width: 2px;
    height: 18px;
    margin: 2px 0 2px 14px;
    background: var(--color-line);
  }

  .cara-cta {
    text-align: center;
  }
</style>
