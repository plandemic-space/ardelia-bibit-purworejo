---
/**
 * Kolase foto aktivitas nursery — dipasangkan side-by-side dengan
 * CeritaSingkat di index.astro (pola dari mockup homepage). Foto yang
 * dipakai di sini unik untuk section ini (tidak dipakai ulang di section
 * homepage lain).
 */
---

<div class="aktivitas-col">
  <div class="col-head">
    <p class="eyebrow">Di Balik Layar</p>
    <h2>Aktivitas di Nursery</h2>
  </div>

  <div class="aktivitas-grid">
    <figure class="aktivitas-item">
      <img src="/images/galeri/menyemai-bibit.webp" alt="Menyemai bibit di nursery" loading="lazy" decoding="async" />
      <figcaption>Menyemai bibit</figcaption>
    </figure>

    <figure class="aktivitas-item">
      <img src="/images/galeri/menyeleksi-bibit.webp" alt="Menyeleksi bibit di nursery" loading="lazy" decoding="async" />
      <figcaption>Menyeleksi bibit</figcaption>
    </figure>

    <figure class="aktivitas-item">
      <img src="/images/galeri/pengunjung-nursery-2.webp" alt="Pengunjung di nursery" loading="lazy" decoding="async" />
      <figcaption>Pengunjung nursery</figcaption>
    </figure>

    <figure class="aktivitas-item">
      <img src="/images/galeri/pengiriman-truk.webp" alt="Pengiriman bibit menggunakan truk" loading="lazy" decoding="async" />
      <figcaption>Pengiriman bibit</figcaption>
    </figure>
  </div>
</div>

<style>
  .col-head {
    margin-bottom: 20px;
    text-align: center;
  }

  .col-head .eyebrow {
    justify-content: center;
  }

  .col-head h2 {
    font-size: clamp(20px, 2.4vw, 26px);
    margin: 10px 0 0;
  }

  .aktivitas-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .aktivitas-grid figure {
    margin: 0;
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--color-mist);
  }

  .aktivitas-grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .aktivitas-grid figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 8px 10px;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--color-paper);
    background: linear-gradient(to top, rgba(14, 53, 41, 0.78), transparent);
  }

  @media (max-width: 480px) {
    .aktivitas-grid {
      gap: 8px;
    }
  }
</style>
