---
import Icon from '../Icon.astro';
import WhatsAppButton from '../WhatsAppButton.astro';

/**
 * Pola hero: kolase multi-foto (bukan 1 foto tunggal) — dipilih sesuai
 * playbook §2b karena positioning Ardelia Bibit "palugada, banyak kategori
 * sekaligus".
 */
const collageTiles = [
  { src: '/images/produk/mahoni.webp', alt: 'Bibit mahoni dalam polybag di nursery', label: 'Kayu Keras', big: true },
  { src: '/images/produk/pucuk-merah.webp', alt: 'Bibit pucuk merah siap tanam', label: 'Tanaman Hias' },
  { src: '/images/hero/area-nursery.webp', alt: 'Area nursery Ardelia Bibit dengan bibit tersusun rapi', label: 'Area Nursery' },
  { src: '/images/owner/owner-yarohim-2.webp', alt: 'Pak Yarohim merawat bibit di kebun', label: 'Pak Yarohim Merawat Bibit' },
];
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <span class="hero-badge"><Icon name="leaf" size={14} /> Nursery di Kemiri, Purworejo</span>
      <h1>Bibit Tanaman Unggul untuk Kebun &amp; Penghijauan Anda</h1>
      <p class="hero-sub">
        Menyediakan bibit buah, kayu keras, tanaman hias, rempah, tanaman
        perkebunan, hingga pakan ternak. Kami bantu Anda memilih bibit yang
        sesuai untuk pekarangan, kebun, maupun penghijauan.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/katalog">Jelajahi Katalog</a>
        <WhatsAppButton
          variant="outline"
          label="Chat WhatsApp"
          message="Halo Ardelia Bibit, saya belum tahu mau pilih bibit apa — boleh dibantu?"
        />
      </div>
      <ul class="hero-stats">
        <li>
          <b>48+</b>
          <span>Varietas Bibit</span>
        </li>
        <li>
          <b>6</b>
          <span>Kategori Tanaman</span>
        </li>
        <li>
          <b>Bisa</b>
          <span>Dikunjungi Langsung</span>
        </li>
      </ul>
    </div>

    <div class="hero-collage">
      {
        collageTiles.map((tile) => (
          <div class={`collage-tile ${tile.big ? 'is-big' : ''}`}>
            <img src={tile.src} alt={tile.alt} loading="eager" decoding="async" />
            <span class="collage-caption" aria-hidden="true">{tile.label}</span>
          </div>
        ))
      }
      <div class="hero-floating-badge">
        <span class="badge-icon"><Icon name="shield-check" size={18} /></span>
        <div>
          <b>Bibit Berkualitas</b>
          <span>Diseleksi &amp; dirawat dengan baik</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 56px 0 64px;
    background: linear-gradient(180deg, var(--color-mist) 0%, var(--color-ivory) 65%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 52px;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: var(--color-mist);
    color: var(--color-leaf-dark);
    font-size: 13px;
    font-weight: 700;
    padding: 7px 14px;
    border-radius: 999px;
    margin-bottom: 18px;
  }

  .hero-copy h1 {
    font-size: clamp(32px, 4.2vw, 50px);
    line-height: 1.12;
    margin: 0 0 20px;
    letter-spacing: -0.01em;
  }

  .hero-sub {
    font-size: 17px;
    color: var(--color-charcoal-soft);
    max-width: 480px;
    margin-bottom: 26px;
  }

  .hero-cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 34px;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 22px 0 0;
    border-top: 1px solid var(--color-line);
  }

  .hero-stats li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero-stats b {
    font-family: var(--font-display);
    font-size: 26px;
    color: var(--color-teal-dark);
    line-height: 1;
  }

  .hero-stats span {
    font-size: 13px;
    color: var(--color-charcoal-soft);
    font-weight: 500;
  }

  /* --- Kolase 4 foto --- */
  .hero-collage {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    grid-template-rows: 1fr 1fr;
    gap: 14px;
    height: 420px;
  }

  .collage-tile {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 14px 32px rgba(14, 53, 53, 0.18);
    background: var(--color-mist);
  }

  .collage-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .collage-tile.is-big {
    grid-row: 1 / 3;
  }

  .collage-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 20px 14px 10px;
    background: linear-gradient(180deg, rgba(14, 53, 53, 0) 0%, rgba(14, 53, 53, 0.75) 100%);
    color: #fff;
    font-size: 12.5px;
    font-weight: 600;
  }

  .hero-floating-badge {
    position: absolute;
    left: -18px;
    bottom: -22px;
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    box-shadow: 0 16px 32px rgba(15, 42, 33, 0.16);
    padding: 14px 18px;
    max-width: 240px;
  }

  .hero-floating-badge .badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-mist);
    color: var(--color-leaf-dark);
    flex-shrink: 0;
  }

  .hero-floating-badge b {
    display: block;
    font-size: 13.5px;
    color: var(--color-teal-dark);
  }

  .hero-floating-badge span {
    display: block;
    font-size: 12px;
    color: var(--color-charcoal-soft);
    margin-top: 1px;
  }

  @media (max-width: 880px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-collage {
      height: 320px;
      margin-top: 8px;
    }

    .hero-floating-badge {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .hero-collage {
      grid-template-columns: 1fr 1fr;
      height: 260px;
    }
  }
</style>
