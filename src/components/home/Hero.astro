---
import WhatsAppButton from '../WhatsAppButton.astro';

/**
 * Pola hero: kolase multi-foto (bukan 1 foto tunggal) — dipilih sesuai
 * playbook §2b karena positioning Ardelia Bibit "palugada, banyak kategori
 * sekaligus".
 */
const collageTiles = [
  { role: 'nursery', src: '/images/hero/hero-ribuan-bibit-tersedia.webp', alt: 'Ribuan bibit tersedia di nursery Ardelia Bibit', label: 'Ribuan Bibit Tersedia' },
  { role: 'owner', src: '/images/hero/hero-siap-membantu-anda.webp', alt: 'Tim Ardelia Bibit siap membantu Anda memilih bibit', label: 'Siap Membantu Anda' },
  { role: 'produk', src: '/images/hero/hero-bibit-pilihan.webp', alt: 'Bibit pilihan Ardelia Bibit', label: 'Bibit Pilihan' },
  { role: 'kirim', src: '/images/hero/hero-siap-kirim.webp', alt: 'Bibit Ardelia Bibit siap dikirim', label: 'Siap Kirim' },
];
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Ardelia Bibit &middot; Kemiri, Purworejo</p>
      <h1>Mulai Menanam dari Satu Bibit</h1>
      <p class="hero-sub">
        Nursery kami menyediakan aneka bibit tanaman — dari buah, kayu
        keras, tanaman hias, rempah, sampai pakan ternak — untuk kebun,
        pekarangan, atau penghijauan Anda.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/katalog">Jelajahi Katalog</a>
        <WhatsAppButton
          variant="outline"
          label="Chat via WhatsApp"
          message="Halo Ardelia Bibit, saya belum tahu mau pilih bibit apa — boleh dibantu?"
        />
      </div>
    </div>

    <div class="hero-collage">
      {
        collageTiles.map((tile) => (
          <div class={`collage-tile tile-${tile.role}`}>
            <img src={tile.src} alt={tile.alt} loading="eager" decoding="async" />
            <span class="collage-caption" aria-hidden="true">{tile.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 24px 0 28px;
    background: linear-gradient(180deg, var(--color-mist) 0%, var(--color-ivory) 65%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 40px;
    align-items: center;
  }

  .hero-copy h1 {
    font-size: clamp(32px, 4.2vw, 50px);
    line-height: 1.1;
    margin: 12px 0 16px;
    letter-spacing: -0.01em;
  }

  .hero-sub {
    font-size: 17px;
    color: var(--color-charcoal-soft);
    max-width: 560px;
    margin-bottom: 22px;
  }

  .hero-cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  /* --- Kolase 4 foto: 4 kotak sejajar sama besar (2x2), sesuai mockup --- */
  .hero-collage {
    position: relative;
    width: min(100%, 360px);
    aspect-ratio: 1 / 1;
    margin-left: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
    gap: 14px;
  }

  .collage-tile {
    position: relative;
    min-width: 0;
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 14px 32px rgba(14, 53, 53, 0.18);
    background: var(--color-mist);
  }

  .collage-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .collage-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 20px 14px 10px;
    background: linear-gradient(180deg, rgba(14, 53, 53, 0) 0%, rgba(14, 53, 53, 0.75) 100%);
    color: #fff;
    font-size: 12.5px;
    font-weight: 600;
  }

  @media (max-width: 880px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-collage {
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
