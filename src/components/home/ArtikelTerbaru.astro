---
/**
 * Preview 3 artikel terbaru — dipasangkan side-by-side dengan
 * DokumentasiPreview di index.astro (pola dari mockup homepage).
 * Versi ringkas: foto + judul saja (tanpa deskripsi/tanggal) supaya
 * tetap ringkas berdampingan dengan DokumentasiPreview.
 */
import Icon from '../Icon.astro';
import { getArtikelTerbit } from '../../lib/artikel';

const terbaru = (await getArtikelTerbit()).slice(0, 3);
---

<div class="artikel-col">
  <div class="col-head">
    <p class="eyebrow">Tips &amp; Perawatan</p>
    <h2>Artikel Terbaru</h2>
  </div>

  <div class="artikel-terbaru-grid">
    {
      terbaru.map((entry) => (
        <a class="artikel-mini" href={`/artikel/${entry.id}`}>
          {entry.data.coverImage ? (
            <div class="artikel-mini-cover">
              <img src={entry.data.coverImage} alt={entry.data.title} loading="lazy" decoding="async" />
            </div>
          ) : (
            <div class="artikel-mini-cover artikel-mini-cover-emoji">
              <Icon name="leaf" size={22} />
            </div>
          )}
          <div class="artikel-mini-body">
            <h3>{entry.data.title}</h3>
            <span class="artikel-mini-readmore">Baca Selengkapnya →</span>
          </div>
        </a>
      ))
    }
  </div>

  <p class="artikel-cta">
    <a class="btn btn-outline" href="/artikel">Lihat Semua Artikel →</a>
  </p>
</div>

<style>
  .col-head {
    margin-bottom: 20px;
    text-align: center;
  }

  .col-head .eyebrow {
    justify-content: center;
  }

  .col-head h2 {
    font-size: clamp(20px, 2.4vw, 26px);
    margin: 10px 0 0;
  }

  .artikel-terbaru-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 20px;
  }

  .artikel-mini {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .artikel-mini-cover {
    aspect-ratio: 4 / 3;
    background: var(--color-mist);
    overflow: hidden;
  }

  .artikel-mini-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .artikel-mini-cover-emoji {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-leaf-dark);
    opacity: 0.5;
  }

  .artikel-mini-body {
    padding: 10px 2px 0;
  }

  .artikel-mini-body h3 {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-charcoal);
    min-height: 2.7em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .artikel-mini-readmore {
    display: inline-block;
    margin-top: 6px;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--color-teal-dark);
  }

  .artikel-cta {
    text-align: center;
  }

  @media (max-width: 560px) {
    .artikel-terbaru-grid {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 8px;
    }
  }
</style>
