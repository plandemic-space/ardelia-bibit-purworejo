---
/**
 * Preview 3 artikel terbaru — dipasangkan side-by-side dengan
 * DokumentasiPreview di index.astro (pola dari mockup homepage).
 */
import { getCollection } from 'astro:content';
import ArtikelCard from '../ArtikelCard.astro';

const semuaArtikel = await getCollection('artikel');
const terbaru = semuaArtikel
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

<div class="artikel-col">
  <div class="col-head col-head-row">
    <div>
      <p class="eyebrow">Tips & Perawatan</p>
      <h2>Artikel Terbaru</h2>
    </div>
    <a class="col-link" href="/artikel">Lihat Semua Artikel →</a>
  </div>

  <div class="artikel-terbaru-grid">
    {
      terbaru.map((entry) => (
        <ArtikelCard
          title={entry.data.title}
          description={entry.data.description}
          publishDate={entry.data.publishDate}
          href={`/artikel/${entry.id}`}
          coverImage={entry.data.coverImage}
        />
      ))
    }
  </div>
</div>

<style>
  .col-head {
    margin-bottom: 20px;
  }

  .col-head h2 {
    font-size: clamp(20px, 2.4vw, 26px);
    margin: 10px 0 0;
  }

  .col-head-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }

  .col-link {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-teal-dark);
    white-space: nowrap;
  }

  .artikel-terbaru-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  @media (max-width: 560px) {
    .artikel-terbaru-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
