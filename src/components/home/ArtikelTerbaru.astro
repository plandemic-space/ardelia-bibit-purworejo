---
import { getCollection } from 'astro:content';
import ArtikelCard from '../ArtikelCard.astro';

const semuaArtikel = await getCollection('artikel');
const terbaru = semuaArtikel
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

<section class="artikel-terbaru">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Tips & Perawatan</p>
      <h2>Artikel Terbaru</h2>
    </div>

    <div class="artikel-terbaru-grid">
      {
        terbaru.map((entry) => (
          <ArtikelCard
            title={entry.data.title}
            description={entry.data.description}
            publishDate={entry.data.publishDate}
            href={`/artikel/${entry.id}`}
            coverImage={entry.data.coverImage}
          />
        ))
      }
    </div>

    <p class="artikel-terbaru-cta">
      <a class="btn btn-outline" href="/artikel">Lihat Semua Artikel →</a>
    </p>
  </div>
</section>

<style>
  .artikel-terbaru-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 28px;
  }

  .artikel-terbaru-cta {
    text-align: center;
  }

  @media (max-width: 780px) {
    .artikel-terbaru-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
