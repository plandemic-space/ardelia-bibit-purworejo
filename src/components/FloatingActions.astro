---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<div class="floating-actions">
  <button
    type="button"
    id="back-to-top"
    class="fab fab-top"
    aria-label="Kembali ke atas halaman"
  >
    <Icon name="arrow-up" size={20} />
  </button>

  <a
    class="fab fab-wa"
    href={site.contact.whatsappLink}
    target="_blank"
    rel="noopener"
    aria-label={`Chat WhatsApp ${site.name}`}
  >
    <Icon name="whatsapp" size={26} />
  </a>
</div>

<script>
  const backToTop = document.getElementById('back-to-top');

  const toggleVisibility = () => {
    if (!backToTop) return;
    backToTop.classList.toggle('is-visible', window.scrollY > 400);
  };

  toggleVisibility();
  window.addEventListener('scroll', toggleVisibility, { passive: true });

  backToTop?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>

<style>
  .floating-actions {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .fab {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22);
    transition: transform 0.15s, opacity 0.15s;
  }

  @media (hover: hover) {
    .fab:hover {
      transform: translateY(-2px);
    }
  }

  .fab-top {
    width: 42px;
    height: 42px;
    background: var(--color-teal-dark);
    color: #fff;
    border: none;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
  }

  .fab-top.is-visible {
    opacity: 1;
    visibility: visible;
  }

  /* Hijau resmi WhatsApp dipakai apa adanya (bukan warna brand situs) —
     supaya tombol langsung dikenali sebagai chat WA, lihat catatan di chat. */
  .fab-wa {
    width: 56px;
    height: 56px;
    background: #25d366;
    color: #fff;
  }

  @media (max-width: 520px) {
    .floating-actions {
      right: 14px;
      bottom: 14px;
    }
  }
</style>
