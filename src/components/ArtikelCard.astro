---
interface Props {
  title: string;
  description: string;
  publishDate: Date;
  href: string;
  coverImage?: string;
}

const { title, description, publishDate, href, coverImage } = Astro.props;

const tanggal = publishDate.toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<a class="artikel-card" href={href}>
  {
    coverImage ? (
      <div class="artikel-cover artikel-cover-photo">
        <img src={coverImage} alt={title} loading="lazy" decoding="async" />
      </div>
    ) : (
      <div class="artikel-cover">
        <span aria-hidden="true">🌱</span>
      </div>
    )
  }
  <div class="artikel-body">
    <span class="artikel-date">{tanggal}</span>
    <h3>{title}</h3>
    <p>{description}</p>
    <span class="artikel-readmore">Baca selengkapnya →</span>
  </div>
</a>

<style>
  .artikel-card {
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  @media (hover: hover) {
    .artikel-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(22, 74, 74, 0.12);
    }
  }

  .artikel-cover {
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, var(--color-mist), #e7ecdf);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    opacity: 0.7;
  }

  .artikel-cover-photo {
    opacity: 1;
    overflow: hidden;
  }

  .artikel-cover-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .artikel-body {
    flex: 1;
    padding: 18px 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .artikel-date {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-burnt-text);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .artikel-body h3 {
    font-size: 17px;
    line-height: 1.35;
    color: var(--color-charcoal);
  }

  .artikel-body p {
    font-size: 13.5px;
    color: var(--color-charcoal-soft);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .artikel-readmore {
    margin-top: auto;
    padding-top: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-teal-dark);
  }
</style>
