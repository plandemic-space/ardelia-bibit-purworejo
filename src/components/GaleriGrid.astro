---
interface Tile {
  emoji?: string;
  image?: string;
  alt?: string;
  label: string;
}

interface Props {
  tiles: Tile[];
}

const { tiles } = Astro.props;
---

<div class="galeri-grid">
  {
    tiles.map((tile) =>
      tile.image ? (
        <div class="galeri-tile galeri-tile-photo">
          <img src={tile.image} alt={tile.alt ?? tile.label} loading="lazy" decoding="async" />
          <span class="galeri-caption" aria-hidden="true">{tile.label}</span>
        </div>
      ) : (
        <div class="galeri-tile">
          <span class="galeri-emoji" aria-hidden="true">{tile.emoji}</span>
          <span class="galeri-label">{tile.label}</span>
        </div>
      )
    )
  }
</div>

<style>
  .galeri-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  .galeri-tile {
    aspect-ratio: 1;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--color-mist), #e7ecdf);
    border: 1px dashed var(--color-line);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-align: center;
    padding: 10px;
  }

  .galeri-tile-photo {
    position: relative;
    border: 1px solid var(--color-line);
    padding: 0;
    overflow: hidden;
  }

  .galeri-tile-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .galeri-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 10px 10px 8px;
    background: linear-gradient(180deg, rgba(14, 53, 53, 0) 0%, rgba(14, 53, 53, 0.75) 100%);
    color: #fff;
    font-size: 11.5px;
    font-weight: 600;
  }

  .galeri-emoji {
    font-size: 30px;
    opacity: 0.6;
  }

  .galeri-label {
    font-size: 11.5px;
    font-weight: 500;
    color: var(--color-charcoal-soft);
  }

  @media (max-width: 780px) {
    .galeri-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 480px) {
    .galeri-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
