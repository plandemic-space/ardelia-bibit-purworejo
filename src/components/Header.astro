---
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { site } from '../data/site';
import { navUtama } from '../data/nav';
---

<header class="site-header">
  <div class="nav wrap">
    <a class="brand" href="/" aria-label={`${site.name} — Beranda`}>
      <img src="/images/logo/logo-ardelia-bibit.jpg" alt={`Logo ${site.name}`} width="34" height="34" />
      <span>{site.name}</span>
    </a>

    <!-- Navigasi desktop — flat, sesuai mockup (tanpa dropdown) -->
    <nav class="nav-links" aria-label="Navigasi utama">
      <a href="/katalog">Katalog</a>
      <a href="/tentang">Tentang Kami</a>
      <a href="/artikel">Artikel</a>
      <a href="/cara-beli">Cara Beli</a>
      <a href="/kontak">Kontak</a>
    </nav>

    <div class="nav-right">
      <button class="search-toggle" type="button" aria-label="Cari">
        <Icon name="search" size={19} />
      </button>
      <WhatsAppButton label="Chat via WhatsApp" />
      <button
        class="menu-toggle"
        type="button"
        aria-label="Buka menu navigasi"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        data-menu-toggle
      >
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>
</header>

<!-- Drawer mobile: menutupi gap dari mockup v4 yang cuma display:none tanpa pengganti -->
<div class="drawer-backdrop" data-drawer-backdrop hidden></div>
<aside id="mobile-drawer" class="drawer" data-drawer aria-hidden="true">
  <div class="drawer-head">
    <a class="brand" href="/">
      <img src="/images/logo/logo-ardelia-bibit.jpg" alt={`Logo ${site.name}`} width="30" height="30" />
      <span>{site.name}</span>
    </a>
    <button class="drawer-close" type="button" aria-label="Tutup menu" data-drawer-close>
      <Icon name="close" size={22} />
    </button>
  </div>

  <nav class="drawer-nav" aria-label="Navigasi mobile">
    {navUtama.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <div class="drawer-foot">
    <WhatsAppButton label="Chat WhatsApp Sekarang" class="drawer-wa" />
  </div>
</aside>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 249, 244, 0.94);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--color-line);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    color: var(--color-teal-dark);
  }

  .brand img {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
  }

  /* --- Navigasi desktop + mega menu --- */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--color-charcoal-soft);
  }

  .nav-links > a:hover {
    color: var(--color-teal);
  }

  /* --- Sisi kanan: search + tombol WA + toggle mobile --- */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    padding: 4px;
    color: var(--color-teal-dark);
    cursor: pointer;
  }

  .search-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 4px;
    color: var(--color-charcoal-soft);
    cursor: pointer;
  }

  .search-toggle:hover {
    color: var(--color-teal-dark);
  }

  /* --- Drawer mobile --- */
  .drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(14, 53, 53, 0.45);
    z-index: 60;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .drawer-backdrop.is-visible {
    opacity: 1;
  }

  .drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(320px, 84vw);
    background: var(--color-ivory);
    z-index: 61;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.25s ease;
    box-shadow: -12px 0 32px rgba(14, 53, 53, 0.18);
  }

  .drawer.is-open {
    transform: translateX(0);
  }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px;
    border-bottom: 1px solid var(--color-line);
  }

  .drawer-close {
    background: none;
    border: none;
    color: var(--color-teal-dark);
    padding: 6px;
    cursor: pointer;
  }

  .drawer-nav {
    display: flex;
    flex-direction: column;
    padding: 12px 8px;
    overflow-y: auto;
  }

  .drawer-nav a {
    padding: 14px 16px;
    font-size: 15.5px;
    font-weight: 600;
    color: var(--color-charcoal);
    border-radius: 10px;
  }

  .drawer-nav a:hover,
  .drawer-nav a:focus-visible {
    background: var(--color-mist);
    color: var(--color-teal-dark);
  }

  .drawer-foot {
    margin-top: auto;
    padding: 18px 20px 24px;
    border-top: 1px solid var(--color-line);
  }

  .drawer-foot :global(.drawer-wa) {
    width: 100%;
    justify-content: center;
  }

  /* --- Breakpoint: sembunyikan nav desktop, tampilkan toggle --- */
  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 480px) {
    .nav-right :global(.btn-primary) {
      display: none;
    }
  }
</style>

<script>
  // Interaksi drawer mobile: buka/tutup + kunci scroll body saat drawer aktif.
  // Mega menu desktop murni CSS (:hover / :focus-within), tidak butuh JS.
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  const backdrop = document.querySelector<HTMLElement>('[data-drawer-backdrop]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-drawer-close]');

  function openDrawer() {
    if (!drawer || !backdrop || !toggle) return;
    drawer.classList.add('is-open');
    backdrop.hidden = false;
    requestAnimationFrame(() => backdrop.classList.add('is-visible'));
    drawer.setAttribute('aria-hidden', 'false');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    if (!drawer || !backdrop || !toggle) return;
    drawer.classList.remove('is-open');
    backdrop.classList.remove('is-visible');
    drawer.setAttribute('aria-hidden', 'true');
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setTimeout(() => {
      backdrop.hidden = true;
    }, 200);
  }

  toggle?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDrawer();
  });

  // Tutup drawer otomatis kalau layar diperbesar melewati breakpoint mobile
  const mq = window.matchMedia('(max-width: 900px)');
  mq.addEventListener('change', (e) => {
    if (!e.matches) closeDrawer();
  });
</script>
