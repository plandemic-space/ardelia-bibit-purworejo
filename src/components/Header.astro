---
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { site } from '../data/site';
import { navUtama } from '../data/nav';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<header class="site-header" data-site-header>
  <div class="nav wrap">
    <a class="brand" href="/" aria-label={`${site.name} — Beranda`}>
      <img src="/images/logo/logo-ardelia-bibit.jpg" alt={`Logo ${site.name}`} width="34" height="34" />
      <span>{site.name}</span>
    </a>

    <!-- Navigasi desktop — flat, sesuai mockup (tanpa dropdown), pakai navUtama supaya selalu sinkron dengan drawer mobile -->
    <nav class="nav-links" aria-label="Navigasi utama">
      {
        navUtama.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class={isActive(item.href) ? 'is-active' : ''}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-right">
      <div class="search-wrap" data-search-wrap>
        <form class="search-form" action="/katalog" method="get" data-search-form>
          <button type="button" class="search-clear" aria-label="Tutup pencarian" data-search-close>
            <Icon name="close" size={14} />
          </button>
          <input
            type="search"
            name="cari"
            placeholder="Cari bibit..."
            aria-label="Cari bibit"
            data-search-input
          />
        </form>
        <button class="search-toggle" type="button" aria-label="Cari" aria-expanded="false" data-search-toggle>
          <Icon name="search" size={18} />
        </button>
      </div>
      <button
        class="menu-toggle"
        type="button"
        aria-label="Buka menu navigasi"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        data-menu-toggle
      >
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>
</header>

<!-- Drawer mobile: menutupi gap dari mockup v4 yang cuma display:none tanpa pengganti -->
<div class="drawer-backdrop" data-drawer-backdrop hidden></div>
<aside id="mobile-drawer" class="drawer" data-drawer aria-hidden="true" inert>
  <div class="drawer-head">
    <a class="brand" href="/">
      <img src="/images/logo/logo-ardelia-bibit.jpg" alt={`Logo ${site.name}`} width="30" height="30" />
      <span>{site.name}</span>
    </a>
    <button class="drawer-close" type="button" aria-label="Tutup menu" data-drawer-close>
      <Icon name="close" size={22} />
    </button>
  </div>

  <nav class="drawer-nav" aria-label="Navigasi mobile">
    {navUtama.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <div class="drawer-foot">
    <WhatsAppButton label="Chat WhatsApp Sekarang" class="drawer-wa" />
  </div>
</aside>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 249, 244, 0.7);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid transparent;
    box-shadow: none;
    transition: background-color 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .site-header.is-scrolled {
    background: rgba(250, 249, 244, 0.96);
    border-bottom-color: var(--color-line);
    box-shadow: 0 4px 16px rgba(14, 53, 53, 0.08);
  }

  .nav {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 16px 24px;
  }

  .brand {
    justify-self: start;
  }

  .nav-links {
    justify-self: center;
  }

  .nav-right {
    justify-self: end;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    color: var(--color-teal-dark);
  }

  .brand img {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
  }

  /* --- Navigasi desktop + mega menu --- */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--color-charcoal-soft);
  }

  .nav-links > a {
    position: relative;
    padding: 4px 0;
  }

  @media (hover: hover) {
    .nav-links > a:hover {
      color: var(--color-teal);
    }
  }

  .nav-links > a.is-active {
    color: var(--color-teal-dark);
    font-weight: 700;
  }

  .nav-links > a.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-teal);
  }

  /* --- Sisi kanan: search + toggle mobile --- */
  .nav-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
    min-width: 160px;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    padding: 4px;
    color: var(--color-teal-dark);
    cursor: pointer;
  }

  .search-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: 50%;
    background: none;
    border: none;
    color: var(--color-charcoal-soft);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  @media (hover: hover) {
    .search-toggle:hover {
      background: var(--color-mist);
      color: var(--color-teal-dark);
    }
  }

  .search-wrap.is-open .search-toggle {
    background: var(--color-mist);
    color: var(--color-teal-dark);
  }

  .search-form {
    position: absolute;
    top: 50%;
    right: 38px;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    width: 0;
    overflow: hidden;
    background: var(--color-paper);
    border: 1px solid transparent;
    border-radius: 999px;
    opacity: 0;
    transition: width 0.22s ease, opacity 0.15s ease, border-color 0.15s ease;
    pointer-events: none;
  }

  .search-wrap.is-open .search-form {
    width: 200px;
    opacity: 1;
    border-color: var(--color-line);
    box-shadow: 0 8px 20px rgba(14, 53, 53, 0.1);
    pointer-events: auto;
  }

  .search-clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    background: none;
    border: none;
    color: var(--color-charcoal-soft);
    cursor: pointer;
  }

  @media (hover: hover) {
    .search-clear:hover {
      color: var(--color-teal-dark);
    }
  }

  .search-form input {
    min-width: 0;
    flex: 1;
    border: none;
    background: transparent;
    padding: 6px 12px 6px 0;
    font-size: 14px;
    font-family: inherit;
    color: var(--color-charcoal);
  }

  .search-form input:focus {
    outline: none;
  }

  /* --- Drawer mobile --- */
  .drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(14, 53, 53, 0.45);
    z-index: 60;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .drawer-backdrop.is-visible {
    opacity: 1;
  }

  .drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(320px, 84vw);
    background: var(--color-ivory);
    z-index: 61;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.25s ease;
    box-shadow: -12px 0 32px rgba(14, 53, 53, 0.18);
  }

  .drawer.is-open {
    transform: translateX(0);
  }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px;
    border-bottom: 1px solid var(--color-line);
  }

  .drawer-close {
    background: none;
    border: none;
    color: var(--color-teal-dark);
    padding: 6px;
    cursor: pointer;
  }

  .drawer-nav {
    display: flex;
    flex-direction: column;
    padding: 12px 8px;
    overflow-y: auto;
  }

  .drawer-nav a {
    padding: 14px 16px;
    font-size: 15.5px;
    font-weight: 600;
    color: var(--color-charcoal);
    border-radius: 10px;
  }

  .drawer-nav a:focus-visible {
    background: var(--color-mist);
    color: var(--color-teal-dark);
  }

  @media (hover: hover) {
    .drawer-nav a:hover {
      background: var(--color-mist);
      color: var(--color-teal-dark);
    }
  }

  .drawer-foot {
    margin-top: auto;
    padding: 18px 20px 24px;
    border-top: 1px solid var(--color-line);
  }

  .drawer-foot :global(.drawer-wa) {
    width: 100%;
    justify-content: center;
  }

  /* --- Breakpoint: sembunyikan nav desktop, tampilkan toggle --- */
  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 480px) {
    .search-wrap.is-open .search-form {
      width: min(200px, 60vw);
    }
  }
</style>

<script>
  // Interaksi drawer mobile: buka/tutup + kunci scroll body saat drawer aktif.
  // Mega menu desktop murni CSS (:hover / :focus-within), tidak butuh JS.
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  const backdrop = document.querySelector<HTMLElement>('[data-drawer-backdrop]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-drawer-close]');

  // Header berubah solid + shadow begitu halaman sudah di-scroll
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  function updateScrollState() {
    if (!header) return;
    header.classList.toggle('is-scrolled', window.scrollY > 8);
  }
  // Baca window.scrollY ditunda ke requestAnimationFrame (bukan langsung saat
  // script jalan) supaya gak "forced reflow" — baca properti geometri pas
  // style/layout awal belum settle. Lihat catatan PageSpeed 1 Agu 2026.
  requestAnimationFrame(updateScrollState);
  window.addEventListener('scroll', updateScrollState, { passive: true });

  // Toggle kotak pencarian di navbar — submit mengarahkan ke /katalog?cari=...
  const searchWrap = document.querySelector<HTMLElement>('[data-search-wrap]');
  const searchToggle = document.querySelector<HTMLButtonElement>('[data-search-toggle]');
  const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');
  const searchClose = document.querySelector<HTMLButtonElement>('[data-search-close]');

  function openSearch() {
    if (!searchWrap || !searchToggle) return;
    searchWrap.classList.add('is-open');
    searchToggle.setAttribute('aria-expanded', 'true');
    searchInput?.focus();
  }

  function closeSearch() {
    if (!searchWrap || !searchToggle) return;
    searchWrap.classList.remove('is-open');
    searchToggle.setAttribute('aria-expanded', 'false');
  }

  searchToggle?.addEventListener('click', () => {
    if (searchWrap?.classList.contains('is-open')) {
      closeSearch();
    } else {
      openSearch();
    }
  });

  searchClose?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    closeSearch();
  });

  document.addEventListener('click', (e) => {
    if (!searchWrap?.classList.contains('is-open')) return;
    if (!(e.target instanceof Node)) return;
    if (!searchWrap.contains(e.target)) closeSearch();
  });

  function openDrawer() {
    if (!drawer || !backdrop || !toggle) return;
    drawer.classList.add('is-open');
    backdrop.hidden = false;
    requestAnimationFrame(() => backdrop.classList.add('is-visible'));
    drawer.setAttribute('aria-hidden', 'false');
    drawer.removeAttribute('inert');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    if (!drawer || !backdrop || !toggle) return;
    drawer.classList.remove('is-open');
    backdrop.classList.remove('is-visible');
    drawer.setAttribute('aria-hidden', 'true');
    drawer.setAttribute('inert', '');
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setTimeout(() => {
      backdrop.hidden = true;
    }, 200);
  }

  toggle?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeDrawer();
      closeSearch();
    }
  });

  // Tutup drawer otomatis kalau layar diperbesar melewati breakpoint mobile
  const mq = window.matchMedia('(max-width: 900px)');
  mq.addEventListener('change', (e) => {
    if (!e.matches) closeDrawer();
  });
</script>
