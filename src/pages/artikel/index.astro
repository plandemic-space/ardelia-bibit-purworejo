---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ArtikelCard from '../../components/ArtikelCard.astro';
import Icon from '../../components/Icon.astro';
import { estimasiWaktuBaca } from '../../lib/readingTime';
import { getArtikelTerbit } from '../../lib/artikel';
import { kategoriBibit } from '../../data/nav';

const semuaArtikel = await getArtikelTerbit();

// Filter kategori — pola sama persis dengan /katalog (chip desktop +
// dropdown mobile, client-side murni). Label chip diambil dari
// `kategoriBibit` (nav.ts), BUKAN dari `relatedCategoryLabel` per-artikel,
// supaya konsisten satu sumber label per kategori (ditemukan 1 artikel,
// "Harga Cengkeh", pakai label "Rempah & Bumbu" beda dari label resmi
// "Rempah & Tanaman Obat" di nav.ts — relatedCategoryLabel tetap dipakai
// apa adanya untuk badge di ArtikelCard, tidak diubah, cuma tidak dipakai
// untuk chip filter ini).
const jumlahPerKategori = (slug: string) =>
  semuaArtikel.filter((a) => a.data.relatedCategorySlug === slug).length;
---

<Layout
  title="Artikel Edukasi Tanaman — Ardelia Bibit"
  description="Tips dan panduan praktis seputar menanam dan merawat bibit — dari bibit buah, kayu keras, sampai tanaman hias — ditulis oleh Ardelia Bibit."
  breadcrumbs={[{ name: 'Artikel', path: '/artikel' }]}
>
  <PageIntro
    eyebrow="Artikel"
    title="Tips Menanam & Merawat Bibit"
    subtitle="Catatan praktis dari pengalaman kami di nursery — supaya bibit yang Anda beli tumbuh maksimal, bukan cuma sekadar tertanam."
  />

  <section class="artikel-index">
    <div class="wrap">
      <h2 class="visually-hidden">Semua Artikel</h2>
      {
        semuaArtikel.length > 0 && (
          <>
            <button
              class="filter-toggle"
              type="button"
              data-filter-toggle
              aria-expanded="false"
              aria-controls="filter-bar-panel"
            >
              <span>Kategori: <strong data-filter-toggle-label>Semua</strong></span>
              <Icon name="chevron-down" size={14} class="filter-toggle-icon" />
            </button>

            <div
              class="filter-bar"
              role="group"
              aria-label="Filter kategori artikel"
              data-filter-bar
              id="filter-bar-panel"
            >
              <button class="filter-chip is-active" type="button" data-filter="semua">
                <span class="filter-chip-label">Semua</span>
                <span class="filter-chip-count">{semuaArtikel.length}</span>
              </button>
              {kategoriBibit
                .filter((kat) => jumlahPerKategori(kat.slug) > 0)
                .map((kat) => (
                  <button class="filter-chip" type="button" data-filter={kat.slug}>
                    <Icon name={kat.icon} size={15} />
                    <span class="filter-chip-label">{kat.label}</span>
                    <span class="filter-chip-count">{jumlahPerKategori(kat.slug)}</span>
                  </button>
                ))}
            </div>

            <p class="filter-empty" data-filter-empty hidden>
              Belum ada artikel di kategori ini.
            </p>
          </>
        )
      }
      {
        semuaArtikel.length > 0 ? (
          <div class="artikel-grid" data-artikel-grid>
            {semuaArtikel.map((entry) => (
              <div class="artikel-item" data-kategori={entry.data.relatedCategorySlug ?? ''}>
                <ArtikelCard
                  title={entry.data.title}
                  description={entry.data.description}
                  href={`/artikel/${entry.id}`}
                  coverImage={entry.data.coverImage}
                  readingMinutes={estimasiWaktuBaca(entry.body ?? '')}
                  categoryLabel={entry.data.relatedCategoryLabel}
                />
              </div>
            ))}
          </div>
        ) : (
          <p class="artikel-empty">Artikel belum tersedia — nantikan tips pertama kami di sini.</p>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .artikel-index {
    padding-top: 48px;
  }

  /* Filter chip/dropdown — style disalin dari /katalog (katalog.astro)
     supaya pola filter terasa konsisten di seluruh situs, bukan komponen
     visual baru. Cuma dipakai di sini untuk kategori (tidak ada sort/search
     seperti katalog, artikel sudah urut terbaru-dulu secara default). */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-charcoal-soft);
    cursor: pointer;
    transition: 0.15s;
  }

  .filter-chip-count {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--color-charcoal-soft);
    background: var(--color-mist);
    border-radius: 999px;
    padding: 1px 7px;
  }

  .filter-chip.is-active .filter-chip-count {
    background: rgba(255, 255, 255, 0.18);
    color: var(--color-paper);
  }

  .filter-toggle {
    display: none;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 12px 16px;
    border-radius: 12px;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-charcoal);
    cursor: pointer;
    margin-bottom: 16px;
    text-align: left;
  }

  .filter-toggle strong {
    color: var(--color-teal-dark);
    font-weight: 700;
  }

  .filter-toggle :global(.filter-toggle-icon) {
    flex-shrink: 0;
    color: var(--color-charcoal-soft);
    transition: transform 0.15s ease;
  }

  .filter-toggle[aria-expanded='true'] :global(.filter-toggle-icon) {
    transform: rotate(180deg);
  }

  @media (hover: hover) {
    .filter-chip:hover {
      border-color: var(--color-teal);
      color: var(--color-teal-dark);
    }
  }

  .filter-chip.is-active {
    background: var(--color-teal-dark);
    border-color: var(--color-teal-dark);
    color: var(--color-paper);
  }

  .filter-empty {
    text-align: center;
    padding: 40px 0;
    color: var(--color-charcoal-soft);
  }

  @media (max-width: 780px) {
    .filter-toggle {
      display: flex;
    }

    .filter-bar {
      display: none;
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 4px;
      margin: 0 0 20px;
      padding: 8px;
      border: 1px solid var(--color-line);
      border-radius: 12px;
      background: var(--color-paper);
    }

    .filter-bar.is-open {
      display: flex;
    }

    .filter-chip {
      width: 100%;
      justify-content: space-between;
      border: none;
      border-radius: 8px;
      padding: 11px 12px;
    }

    @media (hover: hover) {
      .filter-chip:not(.is-active):hover {
        background: var(--color-mist);
        color: var(--color-charcoal);
      }
    }
  }

  .artikel-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  /* Wrapper filter (data-kategori) di sekitar ArtikelCard — perlu height:100%
     supaya CSS Grid stretch (default align-items: stretch) benar-benar
     diteruskan sampai ke <a class="artikel-card"> di dalamnya (pola sama
     dengan fix .produk-card di ProdukCard.astro, item 0.5 hotfix #4) —
     tanpa ini kartu di baris yang sama berpotensi tidak sejajar tingginya
     kalau deskripsi/judul antar artikel beda panjang. */
  .artikel-item {
    height: 100%;
  }

  .artikel-item :global(.artikel-card) {
    height: 100%;
  }

  .artikel-empty {
    text-align: center;
    padding: 60px 0;
    color: var(--color-charcoal-soft);
  }

  @media (max-width: 880px) {
    .artikel-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .artikel-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Filter grid artikel berdasarkan kategori — murni client-side, tanpa
  // reload. Pola disalin dari katalog.astro (chip filter + dropdown
  // mobile), disederhanakan (tidak ada sort/search di sini).
  //
  // PENTING: script ini TIDAK pakai define:vars, jadi boleh dikompilasi
  // Astro secara normal — tapi tetap dijaga tanpa syntax TypeScript murni
  // supaya konsisten & aman kalau nanti ada yang copy-paste ke pola
  // define:vars lain (lihat catatan bug lama di katalog.astro).
  const chips = document.querySelectorAll('[data-filter]');
  const items = document.querySelectorAll('[data-artikel-grid] [data-kategori]');
  const emptyMsg = document.querySelector('[data-filter-empty]');

  const filterToggle = document.querySelector('[data-filter-toggle]');
  const filterBar = document.querySelector('[data-filter-bar]');
  const filterToggleLabel = document.querySelector('[data-filter-toggle-label]');

  function closeFilterPanel() {
    filterBar?.classList.remove('is-open');
    filterToggle?.setAttribute('aria-expanded', 'false');
  }

  function openFilterPanel() {
    filterBar?.classList.add('is-open');
    filterToggle?.setAttribute('aria-expanded', 'true');
  }

  function applyFilter(slug: string) {
    let visibleCount = 0;
    items.forEach((item) => {
      const el = item as HTMLElement;
      const match = slug === 'semua' || el.dataset.kategori === slug;
      el.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });

    chips.forEach((chip) => {
      chip.classList.toggle('is-active', (chip as HTMLElement).dataset.filter === slug);
    });

    const activeChip =
      Array.from(chips).find((c) => (c as HTMLElement).dataset.filter === slug) ??
      Array.from(chips).find((c) => (c as HTMLElement).dataset.filter === 'semua');
    if (filterToggleLabel && activeChip) {
      filterToggleLabel.textContent =
        activeChip.querySelector('.filter-chip-label')?.textContent ?? 'Semua';
    }

    if (emptyMsg) (emptyMsg as HTMLElement).hidden = visibleCount !== 0;
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const slug = (chip as HTMLElement).dataset.filter ?? 'semua';
      applyFilter(slug);
      closeFilterPanel();
    });
  });

  filterToggle?.addEventListener('click', () => {
    if (filterBar?.classList.contains('is-open')) {
      closeFilterPanel();
    } else {
      openFilterPanel();
    }
  });

  document.addEventListener('click', (e) => {
    if (!filterBar || !filterToggle) return;
    const target = e.target as Node;
    if (!filterBar.contains(target) && !filterToggle.contains(target)) {
      closeFilterPanel();
    }
  });
</script>
