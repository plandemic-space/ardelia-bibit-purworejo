---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import ArtikelCard from '../../components/ArtikelCard.astro';
import Icon from '../../components/Icon.astro';
import { kategoriBibit } from '../../data/nav';
import { site } from '../../data/site';
import { estimasiWaktuBaca } from '../../lib/readingTime';
import { getArtikelTerbit } from '../../lib/artikel';

export async function getStaticPaths() {
  // Cuma artikel yang publishDate-nya udah lewat yang dapat halaman —
  // draf dengan tanggal masa depan gak digenerate sama sekali (404 kalau
  // ditebak manual), bukan cuma disembunyiin dari daftar.
  const artikelTerbit = await getArtikelTerbit();
  return artikelTerbit.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const waktuBaca = estimasiWaktuBaca(entry.body ?? '');

const relatedKategori = entry.data.relatedCategorySlug
  ? kategoriBibit.find((k) => k.slug === entry.data.relatedCategorySlug)
  : undefined;

// Artikel lain yang sudah tayang, diurutkan terbaru dulu — dipakai untuk
// artikel terkait & navigasi sebelumnya/selanjutnya
const semuaArtikel = await getArtikelTerbit();
const posisiSekarang = semuaArtikel.findIndex((a) => a.id === entry.id);
const artikelSebelumnya = semuaArtikel[posisiSekarang + 1]; // lebih lama
const artikelSelanjutnya = semuaArtikel[posisiSekarang - 1]; // lebih baru

// Artikel terkait: prioritaskan kategori yang sama, exclude diri sendiri, maksimal 3
const artikelTerkait = semuaArtikel
  .filter((a) => a.id !== entry.id)
  .sort((a, b) => {
    const aSama = a.data.relatedCategorySlug === entry.data.relatedCategorySlug ? 0 : 1;
    const bSama = b.data.relatedCategorySlug === entry.data.relatedCategorySlug ? 0 : 1;
    return aSama - bSama;
  })
  .slice(0, 3);

// Ad-hoc (5 Agu 2026) — "Baca juga" manual, beda dari artikelTerkait di atas
// (yang auto by kategori). Dipilih sendiri per-artikel lewat frontmatter
// `relatedManual` (array slug). Match cuma dicari di `semuaArtikel`, yang
// isinya SUDAH difilter getArtikelTerbit() — jadi slug tujuan yang masih
// hold (publishDate belum lewat) otomatis tidak ketemu & tidak dirender,
// tanpa perlu guard tambahan. Begitu artikel tujuannya lewat tanggal
// terbit & situs di-build ulang, link ini otomatis muncul sendiri.
const manualRelated = (entry.data.relatedManual ?? [])
  .map((slug) => semuaArtikel.find((a) => a.id === slug))
  .filter((a): a is (typeof semuaArtikel)[number] => Boolean(a));

const urlArtikelIni = `${site.url}/artikel/${entry.id}`;

// Item 1.1 (E-E-A-T) — artikel yang ditandai `writtenByOwner: true` di
// frontmatter pakai schema Person untuk Pak Yarohim (pengalaman nursery
// langsung), selain itu tetap Organization (artikel jenis berita/tren/
// studi kasus dari sumber luar, bukan pengalaman pribadi pemilik).
const authorSchema = entry.data.writtenByOwner
  ? {
      '@type': 'Person',
      name: site.owner,
      jobTitle: 'Pemilik & Pengelola Nursery Ardelia Bibit',
      worksFor: { '@type': 'Organization', name: site.name },
    }
  : { '@type': 'Organization', name: site.name };

// Item 1.4 — schema HowTo tambahan (berdampingan dengan Article di atas,
// bukan pengganti), cuma dirender kalau artikel punya `howToSteps` terisi
// di frontmatter. Sebagian besar artikel (berita/tren/perbandingan) tidak
// akan punya field ini sama sekali dan tetap seperti sebelumnya.
const howToSchema =
  entry.data.howToSteps && entry.data.howToSteps.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'HowTo',
        name: entry.data.title,
        description: entry.data.description,
        ...(entry.data.coverImage && {
          image: new URL(entry.data.coverImage, site.url).toString(),
        }),
        step: entry.data.howToSteps.map((s) => ({
          '@type': 'HowToStep',
          name: s.name,
          text: s.text,
        })),
      }
    : null;
---

<Layout
  title={`${entry.data.seoTitle ?? entry.data.title} | Ardelia Bibit`}
  description={entry.data.description}
  breadcrumbs={[
    { name: 'Artikel', path: '/artikel' },
    { name: entry.data.title, path: `/artikel/${entry.id}` },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    ...(entry.data.coverImage && { image: new URL(entry.data.coverImage, site.url).toString() }),
    datePublished: entry.data.publishDate.toISOString(),
    author: authorSchema,
    publisher: { '@type': 'Organization', name: site.name },
    mainEntityOfPage: urlArtikelIni,
  })} />

  {howToSchema && <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />}

  <article class="artikel-detail">
    <div class="wrap artikel-head">
      <a class="back-link" href="/artikel">← Semua Artikel</a>
      <p class="artikel-date">{waktuBaca} menit baca</p>
      <h1>{entry.data.title}</h1>
      <p class="artikel-lead">{entry.data.description}</p>
    </div>

    <div class="wrap">
      {
        entry.data.coverImage ? (
          <div class="artikel-cover-big artikel-cover-photo">
            <img src={entry.data.coverImage} alt={entry.data.title} loading="lazy" decoding="async" />
          </div>
        ) : (
          <div class="artikel-cover-big">
            <span aria-hidden="true">🌱</span>
          </div>
        )
      }
    </div>

    <div class="wrap">
      <div class="prose">
        <Content />
      </div>

      {
        manualRelated.length > 0 && (
          <p class="baca-juga">
            Baca juga:{' '}
            {manualRelated.map((a, i) => (
              <>
                <a href={`/artikel/${a.id}`}>{a.data.title}</a>
                {i < manualRelated.length - 1 && ', '}
              </>
            ))}
          </p>
        )
      }

      {
        relatedKategori && (
          <div class="related-box">
            <div>
              <p class="related-eyebrow">Baca Katalog Terkait</p>
              <h3>{relatedKategori.label}</h3>
              <p>{relatedKategori.description}</p>
            </div>
            <a class="btn btn-primary" href={relatedKategori.href}>
              Lihat Katalog →
            </a>
          </div>
        )
      }

      <div class="artikel-share">
        <span>Bagikan artikel ini:</span>
        <a
          href={`https://wa.me/?text=${encodeURIComponent(`${entry.data.title} — ${urlArtikelIni}`)}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Bagikan ke WhatsApp"
          class="share-btn"
        >
          <Icon name="whatsapp" size={16} />
        </a>
        <button type="button" class="share-btn" data-copy-link={urlArtikelIni} aria-label="Salin link artikel">
          <Icon name="link" size={16} />
        </button>
      </div>

      {
        (artikelSebelumnya || artikelSelanjutnya) && (
          <nav class="artikel-nav" aria-label="Navigasi artikel">
            {artikelSebelumnya ? (
              <a href={`/artikel/${artikelSebelumnya.id}`} class="artikel-nav-link artikel-nav-prev">
                <span>← Artikel Sebelumnya</span>
                <strong>{artikelSebelumnya.data.title}</strong>
              </a>
            ) : (
              <span />
            )}
            {artikelSelanjutnya && (
              <a href={`/artikel/${artikelSelanjutnya.id}`} class="artikel-nav-link artikel-nav-next">
                <span>Artikel Selanjutnya →</span>
                <strong>{artikelSelanjutnya.data.title}</strong>
              </a>
            )}
          </nav>
        )
      }

      {
        artikelTerkait.length > 0 && (
          <div class="artikel-terkait">
            <h2>Artikel Terkait</h2>
            <div class="artikel-terkait-grid">
              {artikelTerkait.map((a) => (
                <ArtikelCard
                  title={a.data.title}
                  description={a.data.description}
                  href={`/artikel/${a.id}`}
                  coverImage={a.data.coverImage}
                  readingMinutes={estimasiWaktuBaca(a.body ?? '')}
                  categoryLabel={a.data.relatedCategoryLabel}
                />
              ))}
            </div>
          </div>
        )
      }

      <div class="artikel-cta">
        <p>Masih ada pertanyaan soal bibitnya?</p>
        <WhatsAppButton message={`Halo Ardelia Bibit, saya baru baca artikel "${entry.data.title}" dan mau tanya lebih lanjut`} label="Tanya via WhatsApp" />
      </div>
    </div>
  </article>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.dataset.copyLink;
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
        btn.setAttribute('data-copied', 'true');
        setTimeout(() => btn.removeAttribute('data-copied'), 1800);
      } catch {
        // Clipboard API tidak tersedia — abaikan diam-diam, tombol WA share tetap jalan
      }
    });
  });
</script>

<style>
  .artikel-head {
    padding: 40px 0 28px;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  .back-link {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-teal-dark);
  }

  .artikel-date {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-burnt-text);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin: 18px 0 10px;
  }

  .artikel-head h1 {
    font-size: clamp(26px, 3.4vw, 38px);
    line-height: 1.2;
    margin-bottom: 12px;
  }

  .artikel-lead {
    font-size: 16px;
    color: var(--color-charcoal-soft);
    line-height: 1.6;
  }

  .artikel-cover-big {
    aspect-ratio: 21 / 9;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--color-mist), var(--color-mist-deep));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 42px;
    opacity: 0.7;
    margin-bottom: 36px;
  }

  .artikel-cover-photo {
    opacity: 1;
    overflow: hidden;
  }

  .artikel-cover-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .related-box {
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
    margin-top: 44px;
    padding: 24px;
    background: var(--color-mist);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .related-eyebrow {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-burnt-text);
    margin-bottom: 6px;
  }

  .related-box h3 {
    font-size: 17px;
    margin-bottom: 4px;
  }

  .related-box p {
    font-size: 13.5px;
    color: var(--color-charcoal-soft);
  }

  .artikel-cta {
    max-width: 720px;
    margin: 40px auto 60px;
    padding-top: 28px;
    border-top: 1px solid var(--color-line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .prose {
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  /* "Baca juga" manual (relatedManual) — sengaja dipisah dari .prose (bukan
     bagian dari markdown body lagi) supaya render-nya bisa kondisional per
     link (lihat manualRelated di frontmatter script). Gaya disamakan
     dengan paragraf artikel biasa (bukan box mencolok) karena isinya cuma
     1-2 link tambahan, bukan CTA utama. */
  .baca-juga {
    max-width: 720px;
    margin: 20px auto 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-charcoal);
  }

  .baca-juga a {
    color: var(--color-teal-dark);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .artikel-cta p {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--color-charcoal);
  }

  .artikel-share {
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
    margin-top: 32px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .artikel-share span {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-charcoal-soft);
  }

  .share-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--color-mist);
    color: var(--color-teal-dark);
    border: none;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  @media (hover: hover) {
    .share-btn:hover {
      background: var(--color-mist-hover);
    }
  }

  .share-btn[data-copied]::after {
    content: 'Link disalin';
    position: absolute;
    margin-top: -38px;
    margin-left: -8px;
    background: var(--color-teal-dark);
    color: var(--color-paper);
    font-size: 11.5px;
    padding: 4px 8px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .artikel-nav {
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--color-line);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .artikel-nav-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13.5px;
  }

  .artikel-nav-next {
    text-align: right;
    grid-column: 2;
  }

  .artikel-nav-link span {
    color: var(--color-burnt-text);
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .artikel-nav-link strong {
    color: var(--color-teal-dark);
    font-weight: 600;
    line-height: 1.35;
  }

  .artikel-terkait {
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
    margin-top: 52px;
    padding-top: 40px;
    border-top: 1px solid var(--color-line);
  }

  .artikel-terkait h2 {
    font-size: 22px;
    margin-bottom: 20px;
  }

  .artikel-terkait-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 720px) {
    .artikel-nav {
      grid-template-columns: 1fr;
    }

    .artikel-nav-next {
      text-align: left;
      grid-column: 1;
    }

    .artikel-terkait-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
