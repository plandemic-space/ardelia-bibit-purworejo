---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import GaleriGrid from '../components/GaleriGrid.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

const galeriTiles = [
  { image: '/images/produk/alpukat-aligator.webp', alt: 'Bibit alpukat tersusun rapi di area nursery', label: 'Area Nursery' },
  { image: '/images/galeri/rak-pembibitan.webp', alt: 'Rak pembibitan bibit jabon di nursery Ardelia Bibit', label: 'Rak Pembibitan' },
  { image: '/images/produk/jati.webp', alt: 'Bibit jati dalam polybag', label: 'Koleksi Kayu Keras' },
  { image: '/images/produk/pucuk-merah.webp', alt: 'Bibit pucuk merah', label: 'Tanaman Hias' },
  { image: '/images/galeri/proses-packing.webp', alt: 'Proses packing bibit jabon sebelum dikirim', label: 'Proses Packing' },
  { image: '/images/galeri/pengiriman.webp', alt: 'Pengiriman bibit kelapa gading kuning ke luar kota', label: 'Pengiriman Keluar Kota' },
  { image: '/images/owner/owner-yarohim-2.webp', alt: 'Pak Yarohim di kebun bibit', label: 'Pak Yarohim di Kebun' },
  { image: '/images/galeri/kunjungan-pembeli.webp', alt: 'Pengunjung mencoba melihat bibit pucuk merah di nursery', label: 'Kunjungan Pembeli' },
];

const nilaiKami = [
  { emoji: '🌱', text: 'Merawat setiap bibit dengan perhatian.' },
  { emoji: '🤝', text: 'Melayani pelanggan dengan ramah dan jujur.' },
  { emoji: '📦', text: 'Berusaha mengirim bibit dalam kondisi terbaik.' },
  { emoji: '📷', text: 'Mengutamakan dokumentasi asli dan informasi yang transparan.' },
  { emoji: '🌿', text: 'Terus belajar dan berkembang mengikuti kebutuhan pelanggan.' },
];
---

<Layout
  title="Tentang Kami — Ardelia Bibit"
  description="Cerita di balik Ardelia Bibit, nursery bibit tanaman milik Yarohim di Kemiri, Purworejo — dari bibit buah, kayu keras, sampai tanaman hias."
  breadcrumbs={[{ name: 'Tentang Kami', path: '/tentang' }]}
>
  <PageIntro
    eyebrow="Tentang Kami"
    title="Tentang Ardelia Bibit"
    subtitle="Merawat bibit dengan sepenuh hati, melayani pelanggan dengan jujur."
  />

  <section class="cerita-lengkap">
    <div class="wrap cerita-grid">
      <div class="cerita-photo">
        <img src="/images/owner/owner-yarohim-1.webp" alt="Pak Yarohim, pemilik Ardelia Bibit" loading="lazy" decoding="async" />
      </div>

      <div class="cerita-text">
        <p>
          Perjalanan Ardelia Bibit di dunia pembibitan dimulai sekitar tahun
          2010. Selama bertahun-tahun, kami lebih banyak melayani pelanggan
          melalui komunikasi langsung, rekomendasi dari mulut ke mulut, serta
          WhatsApp.
        </p>
        <p>
          Fokus kami sejak awal bukan membangun kehadiran di internet,
          melainkan merawat bibit dengan baik dan membantu pelanggan
          mendapatkan tanaman yang sesuai dengan kebutuhannya. Karena itulah,
          sebagian besar perjalanan kami terdokumentasi dalam percakapan
          dengan pelanggan, bukan di media sosial atau website.
        </p>
        <p>
          Seiring berkembangnya teknologi dan semakin banyak orang mencari
          bibit secara online, kami mulai membangun website ini sebagai
          langkah baru agar informasi tentang produk, dokumentasi pengiriman,
          dan cara menghubungi kami menjadi lebih mudah diakses oleh siapa
          saja.
        </p>
        <p>
          Hingga saat ini, Ardelia Bibit menyediakan berbagai jenis bibit
          tanaman, mulai dari bibit buah, tanaman hias, tanaman perkebunan,
          pohon kayu, rempah, hingga tanaman pakan. Setiap bibit dipilih dan
          dirawat dengan perhatian agar sampai ke tangan pelanggan dalam
          kondisi yang baik.
        </p>
        <p>
          Bagi kami, kepercayaan dibangun melalui proses, bukan sekadar
          kata-kata. Karena itu, kami berkomitmen menampilkan foto asli,
          memberikan informasi yang jelas, dan terus menambah dokumentasi
          pengiriman sebagai bukti aktivitas nursery kami.
        </p>
        <p>
          Website ini memang baru. Semangat kami dalam merawat bibit telah
          tumbuh jauh lebih dulu.
        </p>
        <WhatsAppButton
          message="Halo Ardelia Bibit, saya ingin tahu lebih lanjut soal nursery-nya"
          label="Ngobrol via WhatsApp"
          variant="outline"
        />
      </div>
    </div>
  </section>

  <section class="nilai-section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Nilai-Nilai Kami</p>
        <h2>Yang Kami Pegang di Setiap Pesanan</h2>
      </div>

      <div class="nilai-grid">
        {
          nilaiKami.map((item) => (
            <div class="nilai-card">
              <span class="nilai-emoji" aria-hidden="true">{item.emoji}</span>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="galeri-section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Galeri</p>
        <h2>Sedikit Gambaran dari Kebun Kami</h2>
        <p>
          Foto asli dari aktivitas sehari-hari di nursery kami — mulai dari
          bibit yang tersusun rapi sampai proses packing dan pengiriman.
        </p>
      </div>
      <GaleriGrid tiles={galeriTiles} />
    </div>
  </section>

  <section class="penutup-section">
    <div class="wrap">
      <p class="penutup-text">
        Terima kasih telah mengunjungi website Ardelia Bibit. Semoga kami
        dapat membantu Anda menemukan bibit yang tepat dan menjadi bagian
        dari perjalanan menanam yang menyenangkan.
      </p>
    </div>
  </section>
</Layout>

<style>
  .cerita-lengkap {
    padding-top: 56px;
  }

  .cerita-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 48px;
    align-items: start;
  }

  .cerita-photo {
    aspect-ratio: 4 / 5;
    border-radius: 16px;
    background: var(--color-mist);
    overflow: hidden;
    position: sticky;
    top: 100px;
  }

  .cerita-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cerita-text p {
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--color-charcoal);
    margin-bottom: 18px;
  }

  .cerita-text :global(.btn) {
    margin-top: 6px;
  }

  @media (max-width: 880px) {
    .cerita-grid {
      grid-template-columns: 1fr;
    }

    .cerita-photo {
      position: static;
      aspect-ratio: 16 / 9;
    }
  }

  .galeri-section {
    background: var(--color-mist);
  }

  .nilai-section {
    background: var(--color-paper);
  }

  .nilai-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
  }

  .nilai-card {
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: 24px 18px;
    text-align: center;
  }

  .nilai-emoji {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    margin: 0 auto 14px;
    border-radius: 10px;
    background: var(--color-mist);
    font-size: 20px;
  }

  .nilai-card p {
    font-size: 13.5px;
    color: var(--color-charcoal-soft);
    line-height: 1.6;
  }

  @media (max-width: 980px) {
    .nilai-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 620px) {
    .nilai-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .penutup-section {
    padding: 0 0 var(--space-section);
  }

  .penutup-text {
    max-width: 620px;
    margin: 0 auto;
    text-align: center;
    font-family: var(--font-display);
    font-size: 19px;
    font-style: italic;
    color: var(--color-teal-dark);
    line-height: 1.6;
  }

  @media (max-width: 720px) {
    .penutup-section {
      padding-bottom: var(--space-section-mobile);
    }
  }
</style>
