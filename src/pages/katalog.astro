---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProdukCard from '../components/ProdukCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Icon from '../components/Icon.astro';
import ClosingCTA from '../components/home/ClosingCTA.astro';
import { kategoriBibit } from '../data/nav';

const semuaProduk = await getCollection('produk');

// Urutkan sesuai urutan grup di kategoriBibit, lalu alfabet dalam grup
const urutanGrup = kategoriBibit.map((k) => k.slug);
const produkTerurut = [...semuaProduk].sort((a, b) => {
  const grupDiff = urutanGrup.indexOf(a.data.grup) - urutanGrup.indexOf(b.data.grup);
  if (grupDiff !== 0) return grupDiff;
  return a.data.nama.localeCompare(b.data.nama, 'id');
});

const jumlahPerGrup = (slug: string) => semuaProduk.filter((p) => p.data.grup === slug).length;
---

<Layout
  title={`Katalog Bibit (${semuaProduk.length} Varietas) — Ardelia Bibit`}
  description={`Katalog ${semuaProduk.length} varietas bibit dari Ardelia Bibit: buah, tanaman hias, kayu keras, rempah, perkebunan, dan pakan ternak. Tanya stok & harga langsung via WhatsApp.`}
  breadcrumbs={[{ name: 'Katalog Bibit', path: '/katalog' }]}
>
  <section class="katalog-head">
    <div class="wrap">
      <p class="eyebrow">Katalog Bibit</p>
      <h1>{semuaProduk.length} Varietas dalam 6 Kategori</h1>
      <p class="katalog-sub">
        Harga dan stok kami infokan langsung lewat WhatsApp — tergantung
        ukuran dan jumlah pesanan. Tekan tombol di tiap kartu untuk tanya
        cepat.
      </p>
    </div>
  </section>

  <section class="katalog-body">
    <div class="wrap">
      <div class="filter-bar" role="group" aria-label="Filter kelompok bibit" data-filter-bar>
        <button class="filter-chip is-active" type="button" data-filter="semua">
          Semua <span>{semuaProduk.length}</span>
        </button>
        {
          kategoriBibit.map((kat) => (
            <button class="filter-chip" type="button" data-filter={kat.slug}>
              <Icon name={kat.icon} size={15} /> {kat.label} <span>{jumlahPerGrup(kat.slug)}</span>
            </button>
          ))
        }
      </div>

      <div class="katalog-toolbar">
        <p class="katalog-count" data-katalog-count>{semuaProduk.length} varietas ditemukan</p>
        <label class="katalog-sort">
          <span>Urutkan</span>
          <select data-sort aria-label="Urutkan produk">
            <option value="default">Rekomendasi</option>
            <option value="az">Nama A-Z</option>
            <option value="za">Nama Z-A</option>
          </select>
          <Icon name="chevron-down" size={12} class="katalog-sort-icon" />
        </label>
      </div>

      <p class="filter-empty" data-filter-empty hidden>
        Tidak ada produk di kelompok ini.
      </p>

      <h2 class="visually-hidden">Daftar Semua Varietas Bibit</h2>
      <div class="produk-grid" data-produk-grid>
        {
          produkTerurut.map((item) => (
            <div class="produk-item" data-grup={item.data.grup} data-nama={item.data.nama}>
              <ProdukCard
                nama={item.data.nama}
                ukuran={item.data.ukuran}
                perluKonfirmasi={item.data.perluKonfirmasi}
                foto={item.data.foto}
                placeholderEmoji={item.data.placeholderEmoji}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ClosingCTA
    heading="Tidak Ketemu Bibit yang Dicari?"
    subtitle="Kadang ada varietas yang belum sempat kami masukkan ke katalog."
    message="Halo Ardelia Bibit, saya mau tanya bibit yang tidak ada di katalog"
    label="Tanya via WhatsApp"
  />
</Layout>

<style>
  .katalog-head {
    padding: 48px 0 28px;
    background: var(--color-mist);
  }

  .katalog-head h1 {
    font-size: clamp(28px, 3.6vw, 40px);
    margin: 12px 0 12px;
  }

  .katalog-sub {
    color: var(--color-charcoal-soft);
    max-width: 560px;
    font-size: 15.5px;
  }

  .katalog-body {
    padding-top: 40px;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 20px;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-charcoal-soft);
    cursor: pointer;
    transition: 0.15s;
  }

  .filter-chip span {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--color-charcoal-soft);
    background: var(--color-mist);
    border-radius: 999px;
    padding: 1px 7px;
  }

  .filter-chip:hover {
    border-color: var(--color-teal);
    color: var(--color-teal-dark);
  }

  .filter-chip.is-active {
    background: var(--color-teal-dark);
    border-color: var(--color-teal-dark);
    color: #fff;
  }

  .filter-chip.is-active span {
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
  }

  .filter-empty {
    text-align: center;
    padding: 40px 0;
    color: var(--color-charcoal-soft);
  }

  /* --- Toolbar: jumlah hasil + sort --- */
  .katalog-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 14px;
    margin-bottom: 24px;
    border-top: 1px solid var(--color-line);
  }

  .katalog-count {
    font-size: 13px;
    color: var(--color-charcoal-soft);
  }

  .katalog-sort {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .katalog-sort span {
    font-size: 12.5px;
    color: var(--color-charcoal-soft);
    font-weight: 600;
  }

  .katalog-sort select {
    appearance: none;
    -webkit-appearance: none;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    border-radius: 999px;
    padding: 7px 30px 7px 14px;
    font-size: 13px;
    font-weight: 600;
    font-family: inherit;
    color: var(--color-charcoal);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .katalog-sort select:hover,
  .katalog-sort select:focus-visible {
    border-color: var(--color-teal);
    outline: none;
  }

  .katalog-sort :global(.katalog-sort-icon) {
    position: absolute;
    right: 12px;
    pointer-events: none;
    color: var(--color-charcoal-soft);
  }

  @media (max-width: 780px) {
    /* Chip kategori jadi satu baris yang bisa di-swipe, bukan wrap
       berantakan — lebih rapi di layar sempit. */
    .filter-bar {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      margin: 0 -24px 20px;
      padding: 0 24px 4px;
      scroll-padding-left: 24px;
    }

    .filter-bar::-webkit-scrollbar {
      display: none;
    }

    .filter-chip {
      flex-shrink: 0;
      white-space: nowrap;
    }

    /* Icon kategori dibuang di layar sempit — pada ukuran kecil bentuknya
       ambigu (mis. ikon bunga terbaca seperti tanda "+"), teks label saja
       sudah cukup jelas di chip sekecil ini. */
    .filter-chip :global(svg) {
      display: none;
    }

    .katalog-toolbar {
      gap: 10px;
    }

    .katalog-count {
      font-size: 12.5px;
    }
  }

  @media (max-width: 420px) {
    .katalog-sort span {
      display: none;
    }
  }

  .produk-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    padding-bottom: 32px;
  }

  @media (max-width: 980px) {
    .produk-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 700px) {
    .produk-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 420px) {
    .produk-grid {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
  }
</style>

<script>
  // Filter grid berdasarkan grup, murni client-side (tanpa reload).
  // Kalau datang dari link mega menu (#slug), filter otomatis ke grup itu.
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-produk-grid] [data-grup]');
  const emptyMsg = document.querySelector<HTMLElement>('[data-filter-empty]');
  const countEl = document.querySelector<HTMLElement>('[data-katalog-count]');
  const validSlugs = new Set(Array.from(chips).map((c) => c.dataset.filter));

  function updateCount(n: number) {
    if (countEl) countEl.textContent = `${n} varietas ditemukan`;
  }

  function applyFilter(slug: string) {
    let visibleCount = 0;
    items.forEach((item) => {
      const match = slug === 'semua' || item.dataset.grup === slug;
      item.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });

    chips.forEach((chip) => {
      chip.classList.toggle('is-active', chip.dataset.filter === slug);
    });

    // Fail-safe: kalau karena alasan apa pun tidak ada satu kartu pun yang
    // cocok (mis. slug dari URL hash tidak persis sama), JANGAN biarkan
    // grid kosong total — tampilkan semua daripada halaman kelihatan blank.
    if (visibleCount === 0) {
      items.forEach((item) => {
        item.style.display = '';
      });
      chips.forEach((chip) => chip.classList.toggle('is-active', chip.dataset.filter === 'semua'));
      visibleCount = items.length;
    }

    if (emptyMsg) emptyMsg.hidden = visibleCount !== 0;
    updateCount(visibleCount);
  }

  // Sort sederhana — cuma reorder DOM, tanpa reload. "Rekomendasi" adalah
  // urutan asli dari server (dikelompokkan per kategori, lalu alfabet).
  // Nggak ada opsi harga/ketersediaan karena datanya memang belum ada.
  const grid = document.querySelector<HTMLElement>('[data-produk-grid]');
  const sortSelect = document.querySelector<HTMLSelectElement>('[data-sort]');
  const defaultOrder = Array.from(items);

  function applySort(mode: string) {
    if (!grid) return;
    let ordered = defaultOrder;
    if (mode === 'az' || mode === 'za') {
      ordered = [...defaultOrder].sort((a, b) => {
        const cmp = (a.dataset.nama ?? '').localeCompare(b.dataset.nama ?? '', 'id');
        return mode === 'az' ? cmp : -cmp;
      });
    }
    ordered.forEach((item) => grid.appendChild(item));
  }

  sortSelect?.addEventListener('change', () => applySort(sortSelect.value));

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const slug = chip.dataset.filter ?? 'semua';
      applyFilter(slug);
      history.replaceState(null, '', slug === 'semua' ? '/katalog' : `/katalog#${slug}`);
    });
  });

  // Hanya jalankan filter otomatis dari hash URL kalau nilainya benar-benar
  // salah satu slug yang valid — kalau tidak dikenali, biarkan default
  // (semua kartu tampil) daripada memaksa filter ke nilai yang salah.
  const initialSlug = window.location.hash.replace('#', '');
  if (initialSlug && validSlugs.has(initialSlug)) {
    applyFilter(initialSlug);
  }

  // Pencarian dari ikon search di navbar (?cari=kata-kunci) — filter berdasarkan nama produk
  const cariParam = new URLSearchParams(window.location.search).get('cari');
  if (cariParam && cariParam.trim()) {
    const kata = cariParam.trim().toLowerCase();
    let visibleCount = 0;
    items.forEach((item) => {
      const match = (item.dataset.nama ?? '').toLowerCase().includes(kata);
      item.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });
    chips.forEach((chip) => chip.classList.remove('is-active'));
    if (emptyMsg) emptyMsg.hidden = visibleCount !== 0;
    updateCount(visibleCount);
  }
</script>
