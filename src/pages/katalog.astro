---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProdukCard from '../components/ProdukCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Icon from '../components/Icon.astro';
import ClosingCTA from '../components/home/ClosingCTA.astro';
import { kategoriBibit } from '../data/nav';

const semuaProduk = await getCollection('produk');

// Urutkan sesuai urutan grup di kategoriBibit, lalu alfabet dalam grup
const urutanGrup = kategoriBibit.map((k) => k.slug);
const produkTerurut = [...semuaProduk].sort((a, b) => {
  const grupDiff = urutanGrup.indexOf(a.data.grup) - urutanGrup.indexOf(b.data.grup);
  if (grupDiff !== 0) return grupDiff;
  return a.data.nama.localeCompare(b.data.nama, 'id');
});

const jumlahPerGrup = (slug: string) => semuaProduk.filter((p) => p.data.grup === slug).length;

// Cross-link balik (katalog -> artikel) untuk pengunjung yang landing di
// katalog duluan, bukan dari artikel. 1 artikel paling relevan per grup —
// diprioritaskan yang paling "menarik" (viral/harga) kalau grupnya punya
// lebih dari satu artikel terkait.
const artikelPerKategori: Record<string, { title: string; href: string }> = {
  'bibit-buah': {
    title: 'Cara Memilih Bibit Sehat Sebelum Beli',
    href: '/artikel/cara-memilih-bibit-sehat-sebelum-beli',
  },
  'tanaman-hias': {
    title: 'Viral! Ini Pohon "Sakura" yang Lagi Mekar di Purworejo',
    href: '/artikel/tabebuya-viral-purworejo',
  },
  'pohon-kayu': {
    title: 'Kayu Rp1,5 Miliar per Kg Ini Ternyata Tumbuh di Kutoarjo',
    href: '/artikel/gaharu-kayu-termahal-kutoarjo',
  },
  rempah: {
    title: 'Harga Cengkeh Tembus Rp150 Ribu/Kg',
    href: '/artikel/harga-cengkeh-tembus-150-ribu',
  },
  perkebunan: {
    title: 'Bibit Petai Unggul: Berapa Tahun Sampai Berbuah?',
    href: '/artikel/bibit-petai-unggul-berapa-tahun-berbuah',
  },
  'pakan-ternak': {
    title: 'Kaliandra vs Indigofera: Pilihan Hijauan Pakan Ternak',
    href: '/artikel/kaliandra-vs-indigofera-pakan-ternak',
  },
};
---

<Layout
  title={`Katalog Bibit (${semuaProduk.length} Varietas) — Ardelia Bibit`}
  description={`Katalog ${semuaProduk.length} varietas bibit dari Ardelia Bibit: buah, tanaman hias, kayu keras, rempah, perkebunan, dan pakan ternak. Tanya stok & harga langsung via WhatsApp.`}
  breadcrumbs={[{ name: 'Katalog Bibit', path: '/katalog' }]}
>
  <section class="katalog-head">
    <div class="wrap">
      <p class="eyebrow">Katalog Bibit</p>
      <h1>{semuaProduk.length} Varietas dalam 6 Kategori</h1>
      <p class="katalog-sub">
        Harga dan stok kami infokan langsung lewat WhatsApp — tergantung
        ukuran dan jumlah pesanan. Tekan tombol di tiap kartu untuk tanya
        cepat.
      </p>
    </div>
  </section>

  <section class="katalog-body">
    <div class="wrap">
      <button
        class="filter-toggle"
        type="button"
        data-filter-toggle
        aria-expanded="false"
        aria-controls="filter-bar-panel"
      >
        <span>Kategori: <strong data-filter-toggle-label>Semua</strong></span>
        <Icon name="chevron-down" size={14} class="filter-toggle-icon" />
      </button>

      <div
        class="filter-bar"
        role="group"
        aria-label="Filter kelompok bibit"
        data-filter-bar
        id="filter-bar-panel"
      >
        <button class="filter-chip is-active" type="button" data-filter="semua">
          <span class="filter-chip-label">Semua</span>
          <span class="filter-chip-count">{semuaProduk.length}</span>
        </button>
        {
          kategoriBibit.map((kat) => (
            <button class="filter-chip" type="button" data-filter={kat.slug}>
              <Icon name={kat.icon} size={15} />
              <span class="filter-chip-label">{kat.label}</span>
              <span class="filter-chip-count">{jumlahPerGrup(kat.slug)}</span>
            </button>
          ))
        }
      </div>

      <div class="katalog-toolbar">
        <p class="katalog-count" data-katalog-count>{semuaProduk.length} varietas ditemukan</p>
        <label class="katalog-sort">
          <span>Urutkan</span>
          <select data-sort aria-label="Urutkan produk">
            <option value="default">Rekomendasi</option>
            <option value="az">Nama A-Z</option>
            <option value="za">Nama Z-A</option>
          </select>
          <Icon name="chevron-down" size={12} class="katalog-sort-icon" />
        </label>
      </div>

      <a class="artikel-banner" data-artikel-banner href="#" hidden>
        <Icon name="document" size={16} class="artikel-banner-icon" />
        <span class="artikel-banner-text">
          Baca juga: <strong data-artikel-banner-title></strong>
        </span>
        <span class="artikel-banner-arrow" aria-hidden="true">→</span>
      </a>

      <p class="filter-empty" data-filter-empty hidden>
        Tidak ada produk di kelompok ini.
      </p>

      <h2 class="visually-hidden">Daftar Semua Varietas Bibit</h2>
      <div class="produk-grid" data-produk-grid>
        {
          produkTerurut.map((item) => (
            <div class="produk-item" data-grup={item.data.grup} data-nama={item.data.nama}>
              <ProdukCard
                nama={item.data.nama}
                ukuran={item.data.ukuran}
                perluKonfirmasi={item.data.perluKonfirmasi}
                foto={item.data.foto}
                placeholderEmoji={item.data.placeholderEmoji}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ClosingCTA
    heading="Tidak Ketemu Bibit yang Dicari?"
    subtitle="Kadang ada varietas yang belum sempat kami masukkan ke katalog."
    message="Halo Ardelia Bibit, saya mau tanya bibit yang tidak ada di katalog"
    label="Tanya via WhatsApp"
  />
</Layout>

<style>
  .katalog-head {
    padding: 48px 0 28px;
    background: var(--color-mist);
  }

  .katalog-head h1 {
    font-size: clamp(28px, 3.6vw, 40px);
    margin: 12px 0 12px;
  }

  .katalog-sub {
    color: var(--color-charcoal-soft);
    max-width: 560px;
    font-size: 15.5px;
  }

  .katalog-body {
    padding-top: 40px;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 20px;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-charcoal-soft);
    cursor: pointer;
    transition: 0.15s;
  }

  .filter-chip-count {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--color-charcoal-soft);
    background: var(--color-mist);
    border-radius: 999px;
    padding: 1px 7px;
  }

  .filter-chip.is-active .filter-chip-count {
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
  }

  /* Tombol dropdown kategori — cuma tampil di mobile (lihat media query
     di bawah). Di desktop filter-bar tetap row chip sejajar seperti biasa. */
  .filter-toggle {
    display: none;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 12px 16px;
    border-radius: 12px;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-charcoal);
    cursor: pointer;
    margin-bottom: 12px;
    text-align: left;
  }

  .filter-toggle strong {
    color: var(--color-teal-dark);
    font-weight: 700;
  }

  .filter-toggle :global(.filter-toggle-icon) {
    flex-shrink: 0;
    color: var(--color-charcoal-soft);
    transition: transform 0.15s ease;
  }

  .filter-toggle[aria-expanded='true'] :global(.filter-toggle-icon) {
    transform: rotate(180deg);
  }

  @media (hover: hover) {
    .filter-chip:hover {
      border-color: var(--color-teal);
      color: var(--color-teal-dark);
    }
  }

  .filter-chip.is-active {
    background: var(--color-teal-dark);
    border-color: var(--color-teal-dark);
    color: #fff;
  }

  .filter-empty {
    text-align: center;
    padding: 40px 0;
    color: var(--color-charcoal-soft);
  }

  .artikel-banner {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    padding: 12px 16px;
    border-radius: 12px;
    border: 1px solid var(--color-line);
    background: var(--color-mist);
    color: var(--color-charcoal);
    text-decoration: none;
    font-size: 13.5px;
    transition: 0.15s;
  }

  .artikel-banner :global(.artikel-banner-icon) {
    flex-shrink: 0;
    color: var(--color-teal-dark);
  }

  .artikel-banner-text {
    flex: 1;
  }

  .artikel-banner-text strong {
    color: var(--color-teal-dark);
    font-weight: 700;
  }

  .artikel-banner-arrow {
    flex-shrink: 0;
    color: var(--color-teal-dark);
    font-weight: 700;
    transition: transform 0.15s ease;
  }

  @media (hover: hover) {
    .artikel-banner:hover {
      border-color: var(--color-teal);
    }

    .artikel-banner:hover .artikel-banner-arrow {
      transform: translateX(3px);
    }
  }

  /* --- Toolbar: jumlah hasil + sort --- */
  .katalog-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 14px;
    margin-bottom: 24px;
    border-top: 1px solid var(--color-line);
  }

  .katalog-count {
    font-size: 13px;
    color: var(--color-charcoal-soft);
  }

  .katalog-sort {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .katalog-sort span {
    font-size: 12.5px;
    color: var(--color-charcoal-soft);
    font-weight: 600;
  }

  .katalog-sort select {
    appearance: none;
    -webkit-appearance: none;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    border-radius: 999px;
    padding: 7px 30px 7px 14px;
    font-size: 13px;
    font-weight: 600;
    font-family: inherit;
    color: var(--color-charcoal);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .katalog-sort select:focus-visible {
    border-color: var(--color-teal);
    outline: none;
  }

  @media (hover: hover) {
    .katalog-sort select:hover {
      border-color: var(--color-teal);
      outline: none;
    }
  }

  .katalog-sort :global(.katalog-sort-icon) {
    position: absolute;
    right: 12px;
    pointer-events: none;
    color: var(--color-charcoal-soft);
  }

  @media (max-width: 780px) {
    /* Ganti chip-geser dengan tombol dropdown "Kategori: ... ▾" — semua
       pilihan langsung kelihatan begitu dibuka, tidak ada kategori yang
       "ketutup" di luar layar seperti pola scroll sebelumnya. */
    .filter-toggle {
      display: flex;
    }

    .filter-bar {
      display: none;
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 4px;
      margin: 0 0 16px;
      padding: 8px;
      border: 1px solid var(--color-line);
      border-radius: 12px;
      background: var(--color-paper);
    }

    .filter-bar.is-open {
      display: flex;
    }

    .filter-chip {
      width: 100%;
      justify-content: space-between;
      border: none;
      border-radius: 8px;
      padding: 11px 12px;
    }

    @media (hover: hover) {
      .filter-chip:not(.is-active):hover {
        background: var(--color-mist);
        color: var(--color-charcoal);
      }
    }

    .katalog-toolbar {
      gap: 10px;
    }

    .katalog-count {
      font-size: 12.5px;
    }
  }

  @media (max-width: 420px) {
    .katalog-sort span {
      display: none;
    }
  }

  .produk-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    padding-bottom: 32px;
  }

  @media (max-width: 980px) {
    .produk-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 700px) {
    .produk-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 420px) {
    .produk-grid {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
  }
</style>

<script define:vars={{ artikelPerKategori }}>
  // Filter grid berdasarkan grup, murni client-side (tanpa reload).
  // Kalau datang dari link mega menu (#slug), filter otomatis ke grup itu.
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-produk-grid] [data-grup]');
  const emptyMsg = document.querySelector<HTMLElement>('[data-filter-empty]');
  const countEl = document.querySelector<HTMLElement>('[data-katalog-count]');
  const artikelBanner = document.querySelector<HTMLAnchorElement>('[data-artikel-banner]');
  const artikelBannerTitle = document.querySelector<HTMLElement>('[data-artikel-banner-title]');
  const validSlugs = new Set(Array.from(chips).map((c) => c.dataset.filter));

  // Update banner "Baca juga" (cross-link katalog -> artikel) sesuai
  // kategori yang lagi aktif. Disembunyikan waktu "Semua" dipilih.
  function updateArtikelBanner(slug: string) {
    if (!artikelBanner || !artikelBannerTitle) return;
    const artikel = (artikelPerKategori as Record<string, { title: string; href: string }>)[slug];
    if (slug === 'semua' || !artikel) {
      artikelBanner.hidden = true;
      return;
    }
    artikelBannerTitle.textContent = artikel.title;
    artikelBanner.href = artikel.href;
    artikelBanner.hidden = false;
  }

  // Dropdown kategori (mobile) — tombol "Kategori: ... ▾" yang buka/tutup
  // panel filter-bar. Di desktop elemen ini disembunyikan via CSS, jadi
  // logicnya aman dijalankan di semua ukuran layar.
  const filterToggle = document.querySelector<HTMLButtonElement>('[data-filter-toggle]');
  const filterBar = document.querySelector<HTMLElement>('[data-filter-bar]');
  const filterToggleLabel = document.querySelector<HTMLElement>('[data-filter-toggle-label]');

  function closeFilterPanel() {
    filterBar?.classList.remove('is-open');
    filterToggle?.setAttribute('aria-expanded', 'false');
  }

  function openFilterPanel() {
    filterBar?.classList.add('is-open');
    filterToggle?.setAttribute('aria-expanded', 'true');
  }

  function updateCount(n: number) {
    if (countEl) countEl.textContent = `${n} varietas ditemukan`;
  }

  function applyFilter(slug: string) {
    let visibleCount = 0;
    items.forEach((item) => {
      const match = slug === 'semua' || item.dataset.grup === slug;
      item.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });

    chips.forEach((chip) => {
      chip.classList.toggle('is-active', chip.dataset.filter === slug);
    });

    // Sinkronkan label tombol dropdown mobile dengan chip yang aktif.
    const activeChip =
      Array.from(chips).find((c) => c.dataset.filter === slug) ??
      Array.from(chips).find((c) => c.dataset.filter === 'semua');
    if (filterToggleLabel && activeChip) {
      filterToggleLabel.textContent =
        activeChip.querySelector('.filter-chip-label')?.textContent ?? 'Semua';
    }

    // Fail-safe: kalau karena alasan apa pun tidak ada satu kartu pun yang
    // cocok (mis. slug dari URL hash tidak persis sama), JANGAN biarkan
    // grid kosong total — tampilkan semua daripada halaman kelihatan blank.
    if (visibleCount === 0) {
      items.forEach((item) => {
        item.style.display = '';
      });
      chips.forEach((chip) => chip.classList.toggle('is-active', chip.dataset.filter === 'semua'));
      visibleCount = items.length;
    }

    if (emptyMsg) emptyMsg.hidden = visibleCount !== 0;
    updateCount(visibleCount);
    updateArtikelBanner(slug);
  }

  // Sort sederhana — cuma reorder DOM, tanpa reload. "Rekomendasi" adalah
  // urutan asli dari server (dikelompokkan per kategori, lalu alfabet).
  // Nggak ada opsi harga/ketersediaan karena datanya memang belum ada.
  const grid = document.querySelector<HTMLElement>('[data-produk-grid]');
  const sortSelect = document.querySelector<HTMLSelectElement>('[data-sort]');
  const defaultOrder = Array.from(items);

  function applySort(mode: string) {
    if (!grid) return;
    let ordered = defaultOrder;
    if (mode === 'az' || mode === 'za') {
      ordered = [...defaultOrder].sort((a, b) => {
        const cmp = (a.dataset.nama ?? '').localeCompare(b.dataset.nama ?? '', 'id');
        return mode === 'az' ? cmp : -cmp;
      });
    }
    ordered.forEach((item) => grid.appendChild(item));
  }

  sortSelect?.addEventListener('change', () => applySort(sortSelect.value));

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const slug = chip.dataset.filter ?? 'semua';
      applyFilter(slug);
      history.replaceState(null, '', slug === 'semua' ? '/katalog' : `/katalog#${slug}`);
      closeFilterPanel();
    });
  });

  filterToggle?.addEventListener('click', () => {
    if (filterBar?.classList.contains('is-open')) {
      closeFilterPanel();
    } else {
      openFilterPanel();
    }
  });

  // Tutup panel kalau user tap di luar tombol/panel (khusus mobile,
  // di desktop panel selalu tampil jadi ini tidak berpengaruh).
  document.addEventListener('click', (e) => {
    if (!filterBar || !filterToggle) return;
    const target = e.target as Node;
    if (!filterBar.contains(target) && !filterToggle.contains(target)) {
      closeFilterPanel();
    }
  });

  // Hanya jalankan filter otomatis dari hash URL kalau nilainya benar-benar
  // salah satu slug yang valid — kalau tidak dikenali, biarkan default
  // (semua kartu tampil) daripada memaksa filter ke nilai yang salah.
  const initialSlug = window.location.hash.replace('#', '');
  if (initialSlug && validSlugs.has(initialSlug)) {
    applyFilter(initialSlug);
  }

  // Pencarian dari ikon search di navbar (?cari=kata-kunci) — filter berdasarkan nama produk
  const cariParam = new URLSearchParams(window.location.search).get('cari');
  if (cariParam && cariParam.trim()) {
    const kata = cariParam.trim().toLowerCase();
    let visibleCount = 0;
    items.forEach((item) => {
      const match = (item.dataset.nama ?? '').toLowerCase().includes(kata);
      item.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });
    chips.forEach((chip) => chip.classList.remove('is-active'));
    if (emptyMsg) emptyMsg.hidden = visibleCount !== 0;
    updateCount(visibleCount);
  }
</script>
