---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

const links = [
  { icon: 'leaf', title: 'Katalog Bibit', desc: 'Lihat berbagai pilihan bibit unggulan', href: '/katalog' },
  { icon: 'root', title: 'Artikel', desc: 'Tips & informasi seputar tanaman', href: '/artikel' },
  { icon: 'shield-check', title: 'Cara Beli', desc: 'Panduan mudah pemesanan bibit', href: '/cara-beli' },
  { icon: 'whatsapp', title: 'Hubungi Kami', desc: 'Konsultasi langsung via WhatsApp', href: 'https://wa.me/6282221085354' },
] as const;
---

<Layout
  title="Halaman Tidak Ditemukan — Ardelia Bibit"
  description="Halaman yang Anda cari tidak ditemukan. Kembali ke beranda Ardelia Bibit atau jelajahi katalog bibit tanaman kami."
>
  <section class="notfound">
    <div class="wrap notfound-wrap">
      <p class="code">404</p>
      <h1>Halaman Tidak Ditemukan</h1>
      <p class="desc">
        Maaf, halaman yang Anda cari mungkin sudah dipindahkan, dihapus, atau
        alamatnya salah.
      </p>
      <a class="btn btn-primary" href="/"><Icon name="leaf" size={16} /> Kembali ke Beranda</a>
    </div>

    <div class="wrap">
      <div class="section-head" style="margin: 56px auto 0; text-align:center; max-width:520px;">
        <h2 style="font-size:22px;">Mungkin Anda mencari ini?</h2>
      </div>
      <div class="notfound-links">
        {
          links.map((l) => (
            <a class="notfound-link card" href={l.href}>
              <span class="icon"><Icon name={l.icon} size={20} /></span>
              <b>{l.title}</b>
              <span class="desc-sm">{l.desc}</span>
            </a>
          ))
        }
      </div>

      <div class="notfound-cta">
        <div>
          <b>Masih bingung mencari bibit yang cocok?</b>
          <p>Tim kami siap membantu Anda menemukan bibit terbaik.</p>
        </div>
        <WhatsAppButton label="Chat WhatsApp" message="Halo Ardelia Bibit, saya nyasar di halaman yang tidak ada — boleh dibantu?" />
      </div>
    </div>
  </section>
</Layout>

<style>
  .notfound {
    padding: 64px 0 72px;
  }

  .notfound-wrap {
    text-align: center;
    max-width: 560px;
  }

  .code {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(64px, 12vw, 120px);
    line-height: 1;
    color: var(--color-teal-dark);
    margin: 0;
  }

  .notfound h1 {
    font-size: clamp(24px, 3vw, 32px);
    margin: 8px 0 14px;
  }

  .desc {
    color: var(--color-charcoal-soft);
    margin-bottom: 26px;
  }

  .notfound-wrap .btn {
    margin: 0 auto;
  }

  .notfound-links {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 28px;
  }

  .notfound-link {
    padding: 22px 18px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .notfound-link .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--color-mist);
    color: var(--color-leaf-dark);
    margin-bottom: 6px;
  }

  .notfound-link b {
    font-size: 14.5px;
    color: var(--color-charcoal);
  }

  .desc-sm {
    font-size: 12.5px;
    color: var(--color-charcoal-soft);
  }

  .notfound-cta {
    margin-top: 40px;
    background: var(--color-mist);
    border-radius: var(--radius);
    padding: 24px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .notfound-cta b {
    display: block;
    font-size: 15.5px;
    color: var(--color-teal-dark);
    margin-bottom: 4px;
  }

  .notfound-cta p {
    font-size: 13.5px;
    color: var(--color-charcoal-soft);
  }

  @media (max-width: 720px) {
    .notfound-links {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
