---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Icon from '../components/Icon.astro';

const langkah = [
  {
    no: '1',
    title: 'Pilih Bibit',
    desc: 'Lihat-lihat dulu di katalog, atau langsung chat kalau sudah tahu mau tanam apa.',
  },
  {
    no: '2',
    title: 'Chat WhatsApp',
    desc: 'Kami infokan stok, ukuran, dan harga saat itu — sesuaikan jumlah yang Anda butuhkan.',
  },
  {
    no: '3',
    title: 'Sepakati Pengiriman',
    desc: 'Mau diambil sendiri ke nursery atau dikirim, kita bicarakan detailnya di chat.',
  },
  {
    no: '4',
    title: 'Bibit Siap',
    desc: 'Setelah sepakat, bibit kami siapkan untuk diambil atau dikirim.',
  },
];

const faq = [
  {
    q: 'Apakah bisa kirim ke luar kota?',
    a: 'Bisa — kami pernah mengirim sampai ke Jepara. Untuk kota lain, konfirmasi dulu via WhatsApp supaya kami cek ongkos kirim dan cara pengiriman yang paling aman untuk jenis bibitnya.',
  },
  {
    q: 'Bagaimana cara pembayarannya?',
    a: 'Detail pembayaran kami sepakati langsung saat chat WhatsApp, menyesuaikan jumlah pesanan dan cara pengambilan/pengirimannya.',
  },
  {
    q: 'Bisa datang langsung ke lokasi nursery?',
    a: 'Bisa, kami senang kalau calon pembeli mau lihat langsung kondisi bibitnya. Alamat lengkap dan peta ada di halaman Kontak.',
  },
  {
    q: 'Ukuran bibit yang saya terima sama seperti yang saya minta?',
    a: 'Ukuran bisa sedikit bervariasi tergantung stok saat itu — kami selalu infokan ukuran aktual sebelum Anda pesan, jadi tidak ada yang mengejutkan.',
  },
  {
    q: 'Bagaimana kalau bibit rusak/mati saat perjalanan?',
    a: 'Untuk pengiriman jarak jauh, tanyakan dulu ke kami sebelum order — kami jelaskan cara pengemasan dan opsi yang tersedia sesuai jenis bibit dan tujuan kirimnya.',
  },
];
---

<Layout
  title="Cara Beli Bibit — Ardelia Bibit"
  description="Cara pesan bibit di Ardelia Bibit: pilih bibit, chat WhatsApp, sepakati pengiriman, bibit siap. Termasuk info pesanan partai besar dan pertanyaan yang sering ditanyakan."
  breadcrumbs={[{ name: 'Cara Beli', path: '/cara-beli' }]}
>
  <PageIntro
    eyebrow="Cara Beli"
    title="Prosesnya Sederhana, Semua Lewat Chat"
    subtitle="Kami tidak pakai keranjang belanja online — semua pesanan dibicarakan langsung via WhatsApp supaya Anda dapat kepastian stok dan ukuran sebelum bayar."
  />

  <section class="langkah-section">
    <div class="wrap">
      <h2 class="visually-hidden">Langkah-Langkah Pemesanan</h2>
      <div class="langkah-grid">
        {
          langkah.map((item, i) => (
            <div class="langkah-card">
              <span class="langkah-no">{item.no}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
              {i < langkah.length - 1 && <span class="langkah-connector" aria-hidden="true" />}
            </div>
          ))
        }
      </div>
      <div class="langkah-cta">
        <WhatsAppButton message="Halo Ardelia Bibit, saya mau mulai pesan bibit" label="Mulai Chat Sekarang" />
      </div>
    </div>
  </section>

  <section class="partai-besar">
    <div class="wrap partai-inner">
      <div>
        <p class="eyebrow eyebrow-light">Kebutuhan Lebih Besar</p>
        <h2>Pesan untuk Proyek atau Partai Besar?</h2>
        <p>
          Kalau kebutuhannya untuk penghijauan, proyek landscape, atau
          pesanan dalam jumlah banyak, sebutkan saja jumlah dan jenis
          bibitnya lewat WhatsApp — kami bantu cek ketersediaan stoknya.
        </p>
      </div>
      <WhatsAppButton
        message="Halo Ardelia Bibit, saya mau tanya untuk pesanan partai besar/proyek"
        label="Tanya Partai Besar"
      />
    </div>
  </section>

  <section class="faq-section" id="faq">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Pertanyaan Umum</p>
        <h2>Yang Sering Ditanyakan</h2>
      </div>

      <div class="faq-list">
        {
          faq.map((item) => (
            <details class="faq-item">
              <summary>
                {item.q}
                <Icon name="chevron-down" size={16} class="faq-chevron" />
              </summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>

      <p class="faq-more">
        Pertanyaan lain belum kejawab? <a href="https://wa.me/6282221085354" target="_blank" rel="noopener">Tanya langsung via WhatsApp →</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .langkah-section {
    padding-top: 56px;
  }

  .langkah-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-bottom: 36px;
  }

  .langkah-card {
    position: relative;
    padding: 0 20px;
    text-align: center;
  }

  .langkah-card:first-child {
    padding-left: 0;
  }

  .langkah-card:last-child {
    padding-right: 0;
  }

  .langkah-no {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--color-teal-dark);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    margin-bottom: 14px;
  }

  .langkah-card h3 {
    font-size: 16px;
    margin-bottom: 8px;
  }

  .langkah-card p {
    font-size: 13.5px;
    color: var(--color-charcoal-soft);
    line-height: 1.55;
  }

  .langkah-connector {
    display: none;
  }

  @media (min-width: 781px) {
    .langkah-connector {
      display: block;
      position: absolute;
      top: 21px;
      left: calc(50% + 41px);
      right: calc(-50% + 41px);
      height: 2px;
      background: var(--color-line);
    }
  }

  .langkah-cta {
    text-align: center;
  }

  @media (max-width: 780px) {
    .langkah-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .langkah-card {
      padding: 0;
    }
  }

  .partai-besar {
    background: var(--color-teal-dark);
  }

  .partai-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    flex-wrap: wrap;
  }

  .partai-inner > div {
    max-width: 520px;
  }

  .eyebrow-light {
    color: var(--color-leaf);
  }

  .partai-besar h2 {
    color: #fff;
    font-size: clamp(22px, 2.6vw, 30px);
    margin: 10px 0 10px;
  }

  .partai-besar p {
    color: rgba(255, 255, 255, 0.75);
    font-size: 14.5px;
    line-height: 1.6;
  }

  @media (max-width: 700px) {
    .partai-inner {
      flex-direction: column;
      text-align: center;
    }
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 720px;
  }

  .faq-item {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    padding: 4px 18px;
    background: var(--color-paper);
  }

  .faq-item summary {
    padding: 16px 0;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item :global(.faq-chevron) {
    flex-shrink: 0;
    transition: transform 0.15s;
    color: var(--color-teal);
  }

  .faq-item[open] :global(.faq-chevron) {
    transform: rotate(180deg);
  }

  .faq-item p {
    padding-bottom: 16px;
    font-size: 14px;
    color: var(--color-charcoal-soft);
    line-height: 1.6;
  }

  .faq-more {
    margin-top: 24px;
    font-size: 14px;
    color: var(--color-charcoal-soft);
  }

  .faq-more a {
    color: var(--color-teal-dark);
    font-weight: 600;
  }
</style>
