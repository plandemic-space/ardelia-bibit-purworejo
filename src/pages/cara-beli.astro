---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Icon from '../components/Icon.astro';
import ClosingCTA from '../components/home/ClosingCTA.astro';
import { waLink } from '../data/site';

const langkah = [
  {
    no: '1',
    title: 'Pilih Bibit',
    desc: 'Lihat-lihat dulu di katalog, atau langsung chat kalau sudah tahu mau tanam apa.',
  },
  {
    no: '2',
    title: 'Chat WhatsApp',
    desc: 'Kami infokan stok, ukuran, dan harga saat itu — sesuaikan jumlah yang Anda butuhkan.',
  },
  {
    no: '3',
    title: 'Sepakati Pengiriman',
    desc: 'Mau diambil sendiri ke nursery atau dikirim, kita bicarakan detailnya di chat.',
  },
  {
    no: '4',
    title: 'Bibit Siap',
    desc: 'Setelah sepakat, bibit kami siapkan untuk diambil atau dikirim.',
  },
];

const faq = [
  {
    icon: 'truck' as const,
    q: 'Apakah bisa kirim ke luar kota?',
    a: 'Bisa, kami kirim ke seluruh Indonesia. Sebutkan kota tujuan via WhatsApp, kami langsung infokan ongkos kirim dan cara pengemasan paling aman untuk jenis bibit yang Anda pesan.',
  },
  {
    icon: 'leaf' as const,
    q: 'Ada jumlah minimal pembelian, atau bisa beli satuan/eceran?',
    a: 'Tidak ada minimum — sesuai tagline kami "Mulai dari Satu Tanaman", satu bibit atau ratusan untuk proyek, kami layani sama. Untuk pesanan kecil ke lokasi jauh, ada 2 hal yang perlu diketahui: ongkos kirim kadang lebih mahal dari harga bibitnya, dan pengirimannya biasa dijadwalkan bareng pesanan lain yang searah dulu — bukan langsung berangkat — supaya ongkirnya tetap masuk akal. Chat WhatsApp untuk estimasi ongkir & waktu kirim yang lebih pasti, atau kalau dekat Purworejo, datang langsung ke nursery biasanya paling hemat.',
  },
  {
    icon: 'cart' as const,
    q: 'Bagaimana cara pembayarannya?',
    a: 'Fleksibel — bisa transfer langsung, DP dulu, atau COD, tergantung situasi dan kesepakatan. Semua dibicarakan dan disepakati dulu saat chat WhatsApp, jadi jelas di awal sebelum bibit disiapkan.',
  },
  {
    icon: 'map-pin' as const,
    q: 'Bisa datang langsung ke lokasi nursery?',
    a: 'Bisa, dan kami sarankan janjian dulu via WhatsApp sebelum berangkat — lokasi kami agak masuk ke pelosok, jadi dengan dikabari dulu, kami bisa pastikan ada yang siap menemani Anda lihat-lihat langsung dan kasih arah supaya tidak kesasar. Kebanyakan pengunjung memang sudah mengobrol dulu lewat WhatsApp sebelum datang.',
  },
  {
    icon: 'search' as const,
    q: 'Kenapa harga dan ukuran bibit tidak dicantumkan pasti di website?',
    a: 'Karena harga dan ukuran bibit bisa berubah mengikuti musim dan stok yang tersedia saat itu — kalau kami patok angka tetap di web, risikonya malah menyesatkan begitu stok berganti. Kami selalu infokan harga dan ukuran aktual dulu via WhatsApp sebelum Anda bayar, jadi apa yang disepakati di chat itu yang Anda terima — tidak ada yang mengejutkan. Pembelian jumlah besar biasanya juga dapat harga lebih kompetitif.',
  },
  {
    icon: 'document' as const,
    q: 'Gimana alurnya kalau pesan partai besar atau untuk proyek?',
    a: 'Sebutkan kebutuhan Anda via WhatsApp — jenis bibit, perkiraan jumlah, dan kota tujuan (belum tahu varietas yang cocok? kami bantu pilihkan). Kami cek stok lalu kirim rincian penawaran: varietas, ukuran, harga, dan opsi pengiriman yang paling pas. Setelah sepakat dan DP masuk, bibit disiapkan dan dikirimkan foto/videonya dulu sebelum berangkat — pelunasan menyusul.',
    waButton: {
      message:
        'Halo Ardelia Bibit, saya mau tanya soal pemesanan partai besar/proyek — jenis bibit: ___, perkiraan jumlah: ___, kota tujuan: ___',
      label: 'Tanya Partai Besar',
    },
  },
  {
    icon: 'message-circle' as const,
    q: 'Bagaimana kalau bibit rusak/mati saat perjalanan?',
    a: 'Untuk pengiriman jarak jauh, kami tentukan dulu cara packing yang paling sesuai untuk jenis bibitnya sebelum Anda order — bukan asal kirim. Anda bisa lihat sendiri contoh proses packing asli kami di halaman Dokumentasi Pengiriman.',
    link: '/dokumentasi',
    linkText: 'Lihat dokumentasi pengiriman →',
  },
  {
    icon: 'tree' as const,
    q: 'Stok bibitnya selalu ready?',
    a: 'Kami kerja sama dengan banyak petani mitra pembibitan di sekitar Purworejo — jadi kalau satu varietas kebetulan kosong di kami, biasanya masih bisa dicarikan dari mitra lain. Supaya pasti, tanyakan dulu ketersediaan dan ukurannya via WhatsApp sebelum Anda berangkat ke lokasi.',
  },
  {
    icon: 'root' as const,
    q: 'Pohonnya dijamin hidup setelah ditanam?',
    a: 'Kami bekali Anda panduan lengkap perawatan pasca-tanam supaya peluang hidupnya maksimal. Khusus pesanan proyek dalam jumlah besar, ada opsi garansi tersendiri yang bisa dibicarakan dan disepakati bareng sebelum order, menyesuaikan jenis bibit dan skala proyeknya.',
    link: '/artikel/panduan-perawatan-pasca-tanam',
    linkText: 'Baca panduan lengkapnya →',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<Layout
  title="Cara Beli Bibit Tanaman — Ardelia Bibit Purworejo"
  description="Cara pesan bibit di Ardelia Bibit: pilih bibit, chat WhatsApp, sepakati pengiriman, bibit siap. Termasuk info pesanan partai besar dan pertanyaan yang sering ditanyakan."
  breadcrumbs={[{ name: 'Cara Beli', path: '/cara-beli' }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <PageIntro
    eyebrow="Cara Beli"
    title="4 Langkah Mudah Pesan Bibit"
    subtitle="Kami tidak pakai keranjang belanja online — semua pesanan dibicarakan langsung via WhatsApp supaya Anda dapat kepastian stok dan ukuran sebelum bayar."
  />

  <section class="langkah-section">
    <div class="wrap">
      <h2 class="visually-hidden">Langkah-Langkah Pemesanan</h2>
      <div class="langkah-grid">
        {
          langkah.map((item, i) => (
            <div class="langkah-card">
              <span class="langkah-no">{item.no}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
              {i < langkah.length - 1 && <span class="langkah-connector" aria-hidden="true" />}
            </div>
          ))
        }
      </div>
      <div class="langkah-cta">
        <WhatsAppButton message="Halo Ardelia Bibit, saya mau mulai pesan bibit" label="Mulai Chat Sekarang" />
      </div>
    </div>
  </section>

  <ClosingCTA
    heading="Pesan untuk Proyek atau Partai Besar?"
    subtitle="Sebutkan jumlah dan jenis bibitnya, kami bantu cek ketersediaan stok."
    message="Halo Ardelia Bibit, saya mau tanya untuk pesanan partai besar/proyek"
    label="Tanya Partai Besar"
  />

  <section class="faq-section" id="faq">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Pertanyaan Umum</p>
        <h2>Yang Sering Ditanyakan</h2>
      </div>

      <div class="faq-list">
        {
          faq.map((item) => (
            <details class="faq-item">
              <summary>
                <span class="faq-icon" aria-hidden="true">
                  <Icon name={item.icon} size={16} />
                </span>
                <span class="faq-q">{item.q}</span>
                <Icon name="chevron-down" size={16} class="faq-chevron" />
              </summary>
              <p>{item.a}</p>
              {(item as any).link && (
                <a class="faq-link" href={(item as any).link}>{(item as any).linkText}</a>
              )}
              {(item as any).waButton && (
                <div class="faq-wa-cta">
                  <WhatsAppButton
                    message={(item as any).waButton.message}
                    label={(item as any).waButton.label}
                    variant="outline"
                    size="sm"
                  />
                </div>
              )}
            </details>
          ))
        }
      </div>

      <p class="faq-more">
        Pertanyaan lain belum kejawab? <a href={waLink('Halo Ardelia Bibit, saya mau tanya (belum kejawab di FAQ)')} target="_blank" rel="noopener" data-wa-track="FAQ Belum Kejawab">Tanya langsung via WhatsApp →</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .langkah-section {
    padding-top: 56px;
  }

  .langkah-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-bottom: 36px;
  }

  .langkah-card {
    position: relative;
    padding: 0 20px;
    text-align: center;
  }

  .langkah-card:first-child {
    padding-left: 0;
  }

  .langkah-card:last-child {
    padding-right: 0;
  }

  .langkah-no {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--color-teal-dark);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    margin-bottom: 14px;
  }

  .langkah-card h3 {
    font-size: 16px;
    margin-bottom: 8px;
  }

  .langkah-card p {
    font-size: 13.5px;
    color: var(--color-charcoal-soft);
    line-height: 1.55;
  }

  .langkah-connector {
    display: none;
  }

  @media (min-width: 781px) {
    .langkah-connector {
      display: block;
      position: absolute;
      top: 21px;
      left: calc(50% + 41px);
      right: calc(-50% + 41px);
      height: 2px;
      background: var(--color-line);
    }
  }

  .langkah-cta {
    text-align: center;
  }

  @media (max-width: 780px) {
    .langkah-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .langkah-card {
      padding: 0;
    }
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 720px;
    margin: 0 auto;
  }

  .faq-item {
    border: 1px solid var(--color-line);
    border-left: 3px solid transparent;
    border-radius: var(--radius-sm);
    padding: 0 18px;
    background: var(--color-paper);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  @media (hover: hover) {
    .faq-item:hover {
      box-shadow: 0 6px 18px rgba(14, 53, 53, 0.07);
    }
  }

  .faq-item[open] {
    border-left-color: var(--color-leaf);
    box-shadow: 0 10px 24px rgba(14, 53, 53, 0.09);
  }

  .faq-item summary {
    padding: 16px 0;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-mist);
    color: var(--color-teal-dark);
    transition: background-color 0.15s ease;
  }

  .faq-item[open] .faq-icon {
    background: var(--color-leaf);
    color: var(--color-paper);
  }

  .faq-q {
    flex: 1;
  }

  .faq-item :global(.faq-chevron) {
    flex-shrink: 0;
    transition: transform 0.15s;
    color: var(--color-teal);
  }

  .faq-item[open] :global(.faq-chevron) {
    transform: rotate(180deg);
  }

  .faq-item p {
    padding: 0 0 18px 44px;
    font-size: 14px;
    color: var(--color-charcoal-soft);
    line-height: 1.6;
  }

  .faq-link {
    display: block;
    margin: -12px 0 18px 44px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-teal-dark);
    text-decoration: none;
  }

  .faq-link:hover {
    text-decoration: underline;
  }

  .faq-wa-cta {
    margin: -12px 0 18px 44px;
  }

  .faq-more {
    max-width: 720px;
    margin: 24px auto 0;
    font-size: 14px;
    color: var(--color-charcoal-soft);
    text-align: center;
  }

  .faq-more a {
    color: var(--color-teal-dark);
    font-weight: 600;
  }
</style>
