---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Icon from '../components/Icon.astro';
import ClosingCTA from '../components/home/ClosingCTA.astro';
import { waLink } from '../data/site';

const langkah = [
  {
    no: '1',
    title: 'Pilih Bibit',
    desc: 'Lihat-lihat dulu di katalog, atau langsung chat kalau sudah tahu mau tanam apa.',
  },
  {
    no: '2',
    title: 'Chat WhatsApp',
    desc: 'Kami infokan stok, ukuran, dan harga saat itu — sesuaikan jumlah yang Anda butuhkan.',
  },
  {
    no: '3',
    title: 'Sepakati Pengiriman',
    desc: 'Mau diambil sendiri ke nursery atau dikirim, kita bicarakan detailnya di chat.',
  },
  {
    no: '4',
    title: 'Bibit Siap',
    desc: 'Setelah sepakat, bibit kami siapkan untuk diambil atau dikirim.',
  },
];

const faq = [
  {
    icon: 'truck' as const,
    q: 'Apakah bisa kirim ke luar kota?',
    a: 'Bisa, kami kirim ke seluruh Indonesia. Sebutkan kota tujuan via WhatsApp, kami langsung infokan ongkos kirim dan cara pengemasan paling aman untuk jenis bibit yang Anda pesan.',
  },
  {
    icon: 'leaf' as const,
    q: 'Ada jumlah minimal pembelian?',
    a: 'Tidak ada, dan ini bukan basa-basi — sesuai tagline kami "Mulai dari Satu Tanaman". Mau beli satu bibit untuk pekarangan atau ratusan untuk proyek penghijauan, kami layani dengan cara yang sama.',
  },
  {
    icon: 'cart' as const,
    q: 'Bagaimana cara pembayarannya?',
    a: 'Fleksibel — bisa transfer langsung, DP dulu, atau COD, tergantung situasi dan kesepakatan. Semua dibicarakan dan disepakati dulu saat chat WhatsApp, jadi jelas di awal sebelum bibit disiapkan.',
  },
  {
    icon: 'map-pin' as const,
    q: 'Bisa datang langsung ke lokasi nursery?',
    a: 'Bisa, dan kami sarankan janjian dulu via WhatsApp sebelum berangkat — lokasi kami agak masuk ke pelosok, jadi dengan dikabari dulu, kami bisa pastikan ada yang siap menemani Anda lihat-lihat langsung dan kasih arah supaya tidak kesasar. Kebanyakan pengunjung memang sudah mengobrol dulu lewat WhatsApp sebelum datang.',
  },
  {
    icon: 'check' as const,
    q: 'Ukuran bibit yang saya terima sama seperti yang saya minta?',
    a: 'Kami selalu infokan ukuran aktual yang tersedia sebelum Anda bayar, bukan setelahnya — jadi apa yang disepakati di chat, itu yang Anda terima. Tidak ada yang mengejutkan.',
  },
  {
    icon: 'document' as const,
    q: 'Gimana alurnya kalau pesan partai besar atau untuk proyek?',
    a: 'Sebutkan dulu kebutuhan Anda via WhatsApp — jenis bibit, perkiraan jumlah, dan kota tujuan. Belum tahu varietas yang cocok untuk daerah Anda? Kami bantu pilihkan. Setelah itu kami cek stok dan kirimkan rincian penawarannya — varietas, ukuran, harga, dan opsi pengiriman yang paling pas untuk jumlah pesanan. Kalau sudah sepakat dan DP masuk, bibit kami siapkan lalu kirimkan foto dan videonya dulu sebelum berangkat — pelunasan menyusul setelah itu.',
  },
  {
    icon: 'message-circle' as const,
    q: 'Bagaimana kalau bibit rusak/mati saat perjalanan?',
    a: 'Untuk pengiriman jarak jauh, kami tentukan dulu cara packing yang paling sesuai untuk jenis bibitnya sebelum Anda order — bukan asal kirim. Anda bisa lihat sendiri contoh proses packing asli kami di halaman Dokumentasi Pengiriman.',
  },
  {
    icon: 'tree' as const,
    q: 'Stok bibitnya selalu ready?',
    a: 'Kami kerja sama dengan banyak petani mitra pembibitan di sekitar Purworejo — jadi kalau satu varietas kebetulan kosong di kami, biasanya masih bisa dicarikan dari mitra lain. Supaya pasti, tanyakan dulu ketersediaan dan ukurannya via WhatsApp sebelum Anda berangkat ke lokasi.',
  },
  {
    icon: 'root' as const,
    q: 'Pohonnya dijamin hidup setelah ditanam?',
    a: 'Kami bekali Anda panduan lengkap perawatan pasca-tanam supaya peluang hidupnya maksimal. Khusus pesanan proyek dalam jumlah besar, ada opsi garansi tersendiri yang bisa dibicarakan dan disepakati bareng sebelum order, menyesuaikan jenis bibit dan skala proyeknya.',
    link: '/artikel/panduan-perawatan-pasca-tanam',
    linkText: 'Baca panduan lengkapnya →',
  },
  {
    icon: 'clock' as const,
    q: 'Pesanan saya kecil tapi lokasinya jauh, apa tetap dikirim cepat?',
    a: 'Untuk pesanan dalam jumlah besar, pengiriman bisa langsung jalan kapan saja. Tapi kalau pesanannya kecil dan tujuannya jauh di luar kota, biasanya kami jadwalkan bareng pengiriman lain yang searah lebih dulu — supaya ongkos kirimnya tetap masuk akal, bukan satu mobil jalan jauh cuma untuk satu bibit kecil. Estimasi waktunya selalu kami infokan di awal lewat WhatsApp, jadi Anda tahu perkiraan kapan bibit sampai.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<Layout
  title="Cara Beli Bibit Tanaman — Ardelia Bibit Purworejo"
  description="Cara pesan bibit di Ardelia Bibit: pilih bibit, chat WhatsApp, sepakati pengiriman, bibit siap. Termasuk info pesanan partai besar dan pertanyaan yang sering ditanyakan."
  breadcrumbs={[{ name: 'Cara Beli', path: '/cara-beli' }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <PageIntro
    eyebrow="Cara Beli"
    title="4 Langkah Mudah Pesan Bibit"
    subtitle="Kami tidak pakai keranjang belanja online — semua pesanan dibicarakan langsung via WhatsApp supaya Anda dapat kepastian stok dan ukuran sebelum bayar."
  />

  <section class="langkah-section">
    <div class="wrap">
      <h2 class="visually-hidden">Langkah-Langkah Pemesanan</h2>
      <div class="langkah-grid">
        {
          langkah.map((item, i) => (
            <div class="langkah-card">
              <span class="langkah-no">{item.no}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
              {i < langkah.length - 1 && <span class="langkah-connector" aria-hidden="true" />}
            </div>
          ))
        }
      </div>
      <div class="langkah-cta">
        <WhatsAppButton message="Halo Ardelia Bibit, saya mau mulai pesan bibit" label="Mulai Chat Sekarang" />
      </div>
    </div>
  </section>

  <ClosingCTA
    heading="Pesan untuk Proyek atau Partai Besar?"
    subtitle="Sebutkan jumlah dan jenis bibitnya, kami bantu cek ketersediaan stok."
    message="Halo Ardelia Bibit, saya mau tanya untuk pesanan partai besar/proyek"
    label="Tanya Partai Besar"
  />

  <section class="faq-section" id="faq">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Pertanyaan Umum</p>
        <h2>Yang Sering Ditanyakan</h2>
      </div>

      <div class="faq-list">
        {
          faq.map((item) => (
            <details class="faq-item">
              <summary>
                <span class="faq-icon" aria-hidden="true">
                  <Icon name={item.icon} size={16} />
                </span>
                <span class="faq-q">{item.q}</span>
                <Icon name="chevron-down" size={16} class="faq-chevron" />
              </summary>
              <p>{item.a}</p>
              {(item as any).link && (
                <a class="faq-link" href={(item as any).link}>{(item as any).linkText}</a>
              )}
            </details>
          ))
        }
      </div>

      <p class="faq-more">
        Pertanyaan lain belum kejawab? <a href={waLink('Halo Ardelia Bibit, saya mau tanya (belum kejawab di FAQ)')} target="_blank" rel="noopener">Tanya langsung via WhatsApp →</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .langkah-section {
    padding-top: 56px;
  }

  .langkah-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-bottom: 36px;
  }

  .langkah-card {
    position: relative;
    padding: 0 20px;
    text-align: center;
  }

  .langkah-card:first-child {
    padding-left: 0;
  }

  .langkah-card:last-child {
    padding-right: 0;
  }

  .langkah-no {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--color-teal-dark);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    margin-bottom: 14px;
  }

  .langkah-card h3 {
    font-size: 16px;
    margin-bottom: 8px;
  }

  .langkah-card p {
    font-size: 13.5px;
    color: var(--color-charcoal-soft);
    line-height: 1.55;
  }

  .langkah-connector {
    display: none;
  }

  @media (min-width: 781px) {
    .langkah-connector {
      display: block;
      position: absolute;
      top: 21px;
      left: calc(50% + 41px);
      right: calc(-50% + 41px);
      height: 2px;
      background: var(--color-line);
    }
  }

  .langkah-cta {
    text-align: center;
  }

  @media (max-width: 780px) {
    .langkah-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .langkah-card {
      padding: 0;
    }
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 720px;
    margin: 0 auto;
  }

  .faq-item {
    border: 1px solid var(--color-line);
    border-left: 3px solid transparent;
    border-radius: var(--radius-sm);
    padding: 0 18px;
    background: var(--color-paper);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  @media (hover: hover) {
    .faq-item:hover {
      box-shadow: 0 6px 18px rgba(14, 53, 53, 0.07);
    }
  }

  .faq-item[open] {
    border-left-color: var(--color-leaf);
    box-shadow: 0 10px 24px rgba(14, 53, 53, 0.09);
  }

  .faq-item summary {
    padding: 16px 0;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-mist);
    color: var(--color-teal-dark);
    transition: background-color 0.15s ease;
  }

  .faq-item[open] .faq-icon {
    background: var(--color-leaf);
    color: var(--color-paper);
  }

  .faq-q {
    flex: 1;
  }

  .faq-item :global(.faq-chevron) {
    flex-shrink: 0;
    transition: transform 0.15s;
    color: var(--color-teal);
  }

  .faq-item[open] :global(.faq-chevron) {
    transform: rotate(180deg);
  }

  .faq-item p {
    padding: 0 0 18px 44px;
    font-size: 14px;
    color: var(--color-charcoal-soft);
    line-height: 1.6;
  }

  .faq-link {
    display: block;
    margin: -12px 0 18px 44px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-teal-dark);
    text-decoration: none;
  }

  .faq-link:hover {
    text-decoration: underline;
  }

  .faq-more {
    max-width: 720px;
    margin: 24px auto 0;
    font-size: 14px;
    color: var(--color-charcoal-soft);
    text-align: center;
  }

  .faq-more a {
    color: var(--color-teal-dark);
    font-weight: 600;
  }
</style>
