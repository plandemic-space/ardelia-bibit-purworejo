---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const telHref = `tel:+${site.contact.whatsappNumber}`;

const kunjungiPoin = [
  { icon: 'leaf', text: 'Lihat langsung kondisi bibit sebelum memutuskan beli' },
  { icon: 'message-circle', text: 'Konsultasi gratis soal jenis & perawatan bibit' },
  { icon: 'clock', text: 'Waktu fleksibel — konfirmasi dulu via WhatsApp' },
];
---

<Layout
  title="Kontak & Lokasi — Ardelia Bibit"
  description="Hubungi Ardelia Bibit via WhatsApp atau kunjungi langsung nursery kami di Dusun Ngemplak, Kemiri, Purworejo. Lihat lokasi di peta dan ikuti media sosial kami."
  breadcrumbs={[{ name: 'Kontak', path: '/kontak' }]}
>
  <PageIntro
    eyebrow="Kontak"
    title="Hubungi atau Kunjungi Langsung"
    subtitle="Cara tercepat menghubungi kami adalah WhatsApp. Kalau mau lihat kondisi bibit dulu, nursery kami juga terbuka untuk kunjungan langsung."
  />

  <section class="kontak-cara">
    <div class="wrap kontak-cara-grid">
      <div class="cara-card">
        <div class="cara-icon"><Icon name="whatsapp" size={20} /></div>
        <h2>WhatsApp</h2>
        <p>Konsultasi & Pemesanan</p>
        <strong>{site.contact.whatsappDisplay}</strong>
        <WhatsAppButton size="sm" variant="outline" label="Chat via WhatsApp" class="btn-sm-link" />
      </div>

      <div class="cara-card">
        <div class="cara-icon"><Icon name="phone" size={20} /></div>
        <h2>Telepon</h2>
        <p>Untuk yang tidak pakai WhatsApp</p>
        <strong>{site.contact.whatsappDisplay}</strong>
        <a class="btn btn-outline btn-sm-link" href={telHref}>Telepon Sekarang →</a>
      </div>

      <div class="cara-card">
        <div class="cara-icon"><Icon name="map-pin" size={20} /></div>
        <h2>Lokasi Nursery</h2>
        <p>Nursery bisa dikunjungi langsung</p>
        <strong>Kemiri, Purworejo</strong>
        <a class="btn btn-outline btn-sm-link" href={site.contact.googleMapsUrl} target="_blank" rel="noopener">
          Lihat di Google Maps →
        </a>
      </div>

      <div class="cara-card">
        <div class="cara-icon"><Icon name="clock" size={20} /></div>
        <h2>Waktu Kunjungan</h2>
        <p>Jam kami fleksibel, menyesuaikan kebutuhan Anda</p>
        <strong>Setiap hari</strong>
        <WhatsAppButton
          size="sm"
          variant="outline"
          label="Konfirmasi Dulu"
          message="Halo Ardelia Bibit, saya mau tanya waktu yang pas untuk berkunjung ke nursery"
          class="btn-sm-link"
        />
      </div>
    </div>
  </section>

  <section class="kontak-section">
    <div class="wrap kontak-grid">
      <div class="kunjungi-block">
        <p class="eyebrow">Datang Langsung</p>
        <h2>Kunjungi Langsung Nursery Kami</h2>
        <p class="kunjungi-desc">
          Kami terbuka untuk kunjungan langsung — datang saja ke nursery
          untuk melihat koleksi bibit dan berkonsultasi dengan kami.
        </p>

        <ul class="kunjungi-poin">
          {
            kunjungiPoin.map((poin) => (
              <li>
                <Icon name={poin.icon} size={18} />
                <span>{poin.text}</span>
              </li>
            ))
          }
        </ul>

        <p class="kunjungi-alamat">
          <Icon name="map-pin" size={16} />
          {site.contact.address.full}
        </p>

        <div class="kunjungi-social">
          <span>Ikuti Kami</span>
          <a href={site.social.youtube} target="_blank" rel="noopener" aria-label="YouTube Ardelia Bibit">
            <Icon name="youtube" size={17} />
          </a>
          <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook Ardelia Bibit">
            <Icon name="facebook" size={17} />
          </a>
          <a href={site.social.tiktok} target="_blank" rel="noopener" aria-label="TikTok Ardelia Bibit">
            <Icon name="tiktok" size={17} />
          </a>
        </div>
      </div>

      <div class="kontak-map">
        <a class="map-open-link" href={site.contact.googleMapsUrl} target="_blank" rel="noopener">
          Buka di Google Maps <Icon name="arrow-up" size={14} class="map-open-icon" />
        </a>
        <div
          id="peta-lokasi"
          data-lat={site.contact.coordinates.lat}
          data-lng={site.contact.coordinates.lng}
          data-nama={site.name}
        >
        </div>
      </div>
    </div>
  </section>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script is:inline>
    // Peta custom (OpenStreetMap via Leaflet) — sengaja bukan Google Maps
    // embed, supaya hanya menampilkan SATU pin (nursery kami sendiri) tanpa
    // pin bisnis pesaing di sekitar yang ikut muncul di embed Google biasa.
    (function () {
      const el = document.getElementById('peta-lokasi');
      if (!el || typeof L === 'undefined') return;

      const lat = parseFloat(el.dataset.lat);
      const lng = parseFloat(el.dataset.lng);
      const nama = el.dataset.nama || 'Lokasi';

      const map = L.map('peta-lokasi', {
        scrollWheelZoom: false,
        zoomControl: false,
      }).setView([lat, lng], 16);

      L.control.zoom({ position: 'topright' }).addTo(map);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors',
        maxZoom: 19,
      }).addTo(map);

      const icon = L.divIcon({
        className: 'peta-marker',
        html: '<span></span>',
        iconSize: [22, 22],
        iconAnchor: [11, 11],
      });

      L.marker([lat, lng], { icon }).addTo(map).bindPopup(nama).openPopup();
    })();
  </script>
</Layout>

<style>
  .kontak-cara {
    padding-top: 56px;
  }

  .kontak-cara-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .cara-card {
    padding: 22px 18px;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
  }

  .cara-card :global(.btn) {
    margin-top: auto;
  }

  .cara-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: var(--color-mist);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-teal-dark);
    font-size: 18px;
    margin-bottom: 12px;
  }

  .cara-card h2 {
    font-size: 15px;
    margin-bottom: 4px;
  }

  .cara-card p {
    font-size: 12.5px;
    color: var(--color-charcoal-soft);
    margin-bottom: 8px;
  }

  .cara-card strong {
    font-size: 13.5px;
    color: var(--color-teal-dark);
    margin-bottom: 12px;
  }

  .btn-sm-link {
    padding: 8px 14px;
    font-size: 13px;
  }

  .kontak-section {
    padding-top: 8px;
  }

  .kontak-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 32px;
    align-items: stretch;
  }

  .kunjungi-block {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: 32px;
  }

  .kunjungi-block h2 {
    font-size: clamp(19px, 2vw, 23px);
    margin: 8px 0 14px;
  }

  .kunjungi-desc {
    font-size: 14.5px;
    color: var(--color-charcoal-soft);
    line-height: 1.65;
    margin-bottom: 24px;
  }

  .kunjungi-poin {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-line);
  }

  .kunjungi-poin li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    color: var(--color-charcoal);
  }

  .kunjungi-poin :global(svg) {
    flex-shrink: 0;
    margin-top: 1px;
    color: var(--color-leaf-dark);
  }

  .kunjungi-alamat {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 13px;
    color: var(--color-charcoal-soft);
    line-height: 1.5;
  }

  .kunjungi-alamat :global(svg) {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .kunjungi-social {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-charcoal-soft);
  }

  .kunjungi-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--color-mist);
    color: var(--color-teal-dark);
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .kunjungi-social a:hover {
    background: var(--color-teal-dark);
    color: #fff;
  }

  .kontak-map {
    position: relative;
    isolation: isolate;
    min-height: 380px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--color-line);
  }

  #peta-lokasi {
    width: 100%;
    height: 100%;
    min-height: 380px;
    background: var(--color-mist);
  }

  .map-open-link {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 500;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fff;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-teal-dark);
    box-shadow: 0 4px 12px rgba(14, 53, 41, 0.18);
  }

  .map-open-link :global(.map-open-icon) {
    transform: rotate(45deg);
  }

  :global(.peta-marker span) {
    display: block;
    width: 22px;
    height: 22px;
    border-radius: 50% 50% 50% 0;
    background: var(--color-teal-dark);
    transform: rotate(-45deg);
    border: 2px solid #fff;
    box-shadow: 0 2px 6px rgba(14, 53, 41, 0.4);
  }

  @media (max-width: 900px) {
    .kontak-cara-grid {
      grid-template-columns: 1fr 1fr;
    }

    .kontak-grid {
      grid-template-columns: 1fr;
    }

    .kontak-map {
      min-height: 300px;
      order: -1;
    }
  }

  @media (max-width: 560px) {
    .kontak-cara-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
