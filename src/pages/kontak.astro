---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const mapEmbedSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.contact.address.full)}&z=15&output=embed`;
const telHref = `tel:+${site.contact.whatsappNumber}`;

const kunjungiPoin = [
  { icon: 'leaf', text: 'Lihat langsung kondisi bibit sebelum memutuskan beli' },
  { icon: 'message-circle', text: 'Konsultasi gratis soal jenis & perawatan bibit' },
  { icon: 'clock', text: 'Waktu fleksibel — konfirmasi dulu via WhatsApp' },
];
---

<Layout
  title="Kontak & Lokasi — Ardelia Bibit"
  description="Hubungi Ardelia Bibit via WhatsApp atau kunjungi langsung nursery kami di Dsn. Ngemplak, Kemiri, Purworejo. Lihat lokasi di peta dan ikuti media sosial kami."
  breadcrumbs={[{ name: 'Kontak', path: '/kontak' }]}
>
  <PageIntro
    eyebrow="Kontak"
    title="Hubungi atau Kunjungi Langsung"
    subtitle="Cara tercepat menghubungi kami adalah WhatsApp. Kalau mau lihat kondisi bibit dulu, nursery kami juga terbuka untuk kunjungan langsung."
  />

  <section class="kontak-cara">
    <div class="wrap kontak-cara-grid">
      <div class="cara-card">
        <div class="cara-icon"><Icon name="whatsapp" size={20} /></div>
        <h2>WhatsApp</h2>
        <p>Konsultasi & Pemesanan</p>
        <strong>{site.contact.whatsappDisplay}</strong>
        <WhatsAppButton size="sm" label="Chat via WhatsApp" />
      </div>

      <div class="cara-card">
        <div class="cara-icon"><Icon name="phone" size={20} /></div>
        <h2>Telepon</h2>
        <p>Untuk yang tidak pakai WhatsApp</p>
        <strong>{site.contact.whatsappDisplay}</strong>
        <a class="btn btn-outline btn-sm-link" href={telHref}>Telepon Sekarang →</a>
      </div>

      <div class="cara-card">
        <div class="cara-icon"><Icon name="map-pin" size={20} /></div>
        <h2>Lokasi Nursery</h2>
        <p>Kemiri, Purworejo, Jawa Tengah</p>
        <a class="btn btn-outline btn-sm-link" href={site.contact.googleMapsUrl} target="_blank" rel="noopener">
          Lihat di Google Maps →
        </a>
      </div>

      <div class="cara-card">
        <div class="cara-icon" aria-hidden="true">🕒</div>
        <h2>Waktu Kunjungan</h2>
        <p>Jam kami fleksibel, menyesuaikan</p>
        <strong>Konfirmasi dulu via WhatsApp</strong>
      </div>
    </div>
  </section>

  <section class="kontak-section">
    <div class="wrap kontak-grid">
      <div class="kunjungi-block">
        <p class="eyebrow">Datang Langsung</p>
        <h2>Kunjungi Langsung Nursery Kami</h2>
        <p class="kunjungi-desc">
          Kami terbuka untuk kunjungan langsung. Anda bisa melihat koleksi
          bibit dan berkonsultasi langsung dengan kami di nursery.
        </p>

        <ul class="kunjungi-poin">
          {
            kunjungiPoin.map((poin) => (
              <li>
                <Icon name={poin.icon} size={18} />
                <span>{poin.text}</span>
              </li>
            ))
          }
        </ul>

        <p class="kunjungi-alamat">
          <Icon name="map-pin" size={16} />
          {site.contact.address.full}
        </p>
      </div>

      <div class="kontak-map">
        <iframe
          src={mapEmbedSrc}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Peta lokasi ${site.name}`}
        ></iframe>
      </div>
    </div>
  </section>
</Layout>

<style>
  .kontak-cara {
    padding-top: 48px;
  }

  .kontak-cara-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .cara-card {
    padding: 22px 18px;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cara-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: var(--color-mist);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-teal-dark);
    font-size: 18px;
    margin-bottom: 12px;
  }

  .cara-card h2 {
    font-size: 15px;
    margin-bottom: 4px;
  }

  .cara-card p {
    font-size: 12.5px;
    color: var(--color-charcoal-soft);
    margin-bottom: 8px;
  }

  .cara-card strong {
    font-size: 13.5px;
    color: var(--color-teal-dark);
    margin-bottom: 12px;
  }

  .btn-sm-link {
    padding: 8px 14px;
    font-size: 13px;
  }

  .kontak-section {
    padding-top: 8px;
  }

  .kontak-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 32px;
    align-items: stretch;
  }

  .kunjungi-block {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: 28px;
  }

  .kunjungi-block h2 {
    font-size: clamp(19px, 2vw, 23px);
    margin: 6px 0 12px;
  }

  .kunjungi-desc {
    font-size: 13.5px;
    color: var(--color-charcoal-soft);
    line-height: 1.6;
    margin-bottom: 18px;
  }

  .kunjungi-poin {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 20px;
  }

  .kunjungi-poin li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13.5px;
    color: var(--color-charcoal);
  }

  .kunjungi-poin :global(svg) {
    flex-shrink: 0;
    margin-top: 1px;
    color: var(--color-leaf-dark);
  }

  .kunjungi-alamat {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 12.5px;
    color: var(--color-charcoal-soft);
    padding-top: 16px;
    border-top: 1px solid var(--color-line);
  }

  .kunjungi-alamat :global(svg) {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .kontak-map {
    min-height: 380px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--color-line);
  }

  @media (max-width: 900px) {
    .kontak-cara-grid {
      grid-template-columns: 1fr 1fr;
    }

    .kontak-grid {
      grid-template-columns: 1fr;
    }

    .kontak-map {
      min-height: 300px;
      order: -1;
    }
  }

  @media (max-width: 560px) {
    .kontak-cara-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
