---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const mapEmbedSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.contact.address.full)}&output=embed`;
---

<Layout
  title="Kontak & Lokasi — Ardelia Bibit"
  description="Hubungi Ardelia Bibit via WhatsApp atau kunjungi langsung nursery kami di Dsn. Ngemplak, Kemiri, Purworejo. Lihat lokasi di peta dan ikuti media sosial kami."
  breadcrumbs={[{ name: 'Kontak', path: '/kontak' }]}
>
  <PageIntro
    eyebrow="Kontak"
    title="Kontak Kami"
    accent="Ardelia Bibit"
    subtitle="Cara tercepat menghubungi kami adalah WhatsApp. Kalau mau lihat kondisi bibit dulu, nursery kami juga terbuka untuk kunjungan langsung."
  />

  <section class="kontak-section">
    <div class="wrap kontak-grid">
      <div class="kontak-info">
        <div class="info-card">
          <div class="info-icon"><Icon name="whatsapp" size={22} /></div>
          <div>
            <h2>WhatsApp</h2>
            <p>{site.contact.whatsappDisplay}</p>
            <WhatsAppButton size="sm" label="Chat Sekarang" />
          </div>
        </div>

        <div class="info-card">
          <div class="info-icon"><Icon name="map-pin" size={22} /></div>
          <div>
            <h2>Alamat Nursery</h2>
            <p>{site.contact.address.full}</p>
            <a class="btn btn-outline btn-sm-link" href={site.contact.googleMapsUrl} target="_blank" rel="noopener">
              Buka di Google Maps →
            </a>
          </div>
        </div>

        <div class="info-card">
          <div class="info-icon" aria-hidden="true">🕒</div>
          <div>
            <h2>Jam Kunjungan</h2>
            <p>
              Jam kunjungan cukup fleksibel — supaya tidak kosong, konfirmasi
              dulu waktu kedatangan Anda via WhatsApp.
            </p>
          </div>
        </div>

        <div class="info-card">
          <div class="info-icon" aria-hidden="true">📣</div>
          <div>
            <h2>Media Sosial</h2>
            <p>Lihat dokumentasi kegiatan nursery dan pengiriman kami.</p>
            <div class="sosmed-links">
              <a href={site.social.youtube} target="_blank" rel="noopener">
                <Icon name="youtube" size={18} /> YouTube
              </a>
              <a href={site.social.facebook} target="_blank" rel="noopener">
                <Icon name="facebook" size={18} /> Facebook
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="kontak-map">
        <iframe
          src={mapEmbedSrc}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Peta lokasi ${site.name}`}
        ></iframe>
      </div>
    </div>
  </section>
</Layout>

<style>
  .kontak-section {
    padding-top: 48px;
  }

  .kontak-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 32px;
    align-items: start;
  }

  .kontak-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .info-card {
    display: flex;
    gap: 14px;
    padding: 20px;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
  }

  .info-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: var(--color-mist);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-teal-dark);
    font-size: 18px;
    flex-shrink: 0;
  }

  .info-card h2 {
    font-size: 15.5px;
    margin-bottom: 6px;
  }

  .info-card p {
    font-size: 13.5px;
    color: var(--color-charcoal-soft);
    line-height: 1.55;
    margin-bottom: 10px;
  }

  .btn-sm-link {
    padding: 8px 14px;
    font-size: 13px;
  }

  .sosmed-links {
    display: flex;
    gap: 14px;
  }

  .sosmed-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-teal-dark);
  }

  .sosmed-links a:hover {
    color: var(--color-leaf-dark);
  }

  .kontak-map {
    min-height: 420px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--color-line);
  }

  @media (max-width: 900px) {
    .kontak-grid {
      grid-template-columns: 1fr;
    }

    .kontak-map {
      min-height: 320px;
      order: -1;
    }
  }
</style>
