---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import ClosingCTA from '../components/home/ClosingCTA.astro';

/**
 * Dokumentasi pengiriman — pakai foto asli yang sudah ada di
 * /public/images/dokumentasi (bukan video, situs belum punya video).
 * Sinkron dengan preview di homepage (DokumentasiPreview.astro), tapi
 * di sini ditampilkan lengkap dengan keterangan lebih detail per foto.
 */
const dokumentasi = [
  {
    image: '/images/dokumentasi/kirim-semarang.webp',
    label: 'Kirim ke Semarang',
    desc: 'Pengiriman bibit jambu, kelengkeng, mangga, pucuk merah, dan palem ke Semarang.',
  },
  {
    image: '/images/dokumentasi/kirim-kuningan.webp',
    label: 'Terkirim ke Kuningan',
    desc: 'Bibit alpukat dan durian terkirim aman ke Kuningan, Jawa Barat.',
  },
  {
    image: '/images/dokumentasi/kirim-kelapa-gading-kuning.webp',
    label: 'Muat Bibit Kelapa Gading Kuning',
    desc: 'Proses muat bibit kelapa gading kuning sebelum dikirim ke pembeli.',
  },
  {
    image: '/images/dokumentasi/dongkel-kelapa-gading-kuning.webp',
    label: 'Dongkel Kelapa Gading Kuning',
    desc: 'Proses dongkel/bongkar bibit kelapa gading kuning dari lahan nursery.',
  },
  {
    image: '/images/dokumentasi/packing-jabon.webp',
    label: 'Packing Bibit Jabon',
    desc: 'Bibit jabon dikemas rapi sebelum dikirim ke lokasi tujuan.',
  },
  {
    image: '/images/dokumentasi/pengunjung-pucuk-merah.webp',
    label: 'Kunjungan & Pucuk Merah',
    desc: 'Pengunjung nursery melihat langsung koleksi bibit pucuk merah.',
  },
  {
    image: '/images/dokumentasi/kirim-bibit-alpukat.webp',
    label: 'Bibit Alpukat Siap Kirim',
    desc: 'Bibit alpukat sudah dikemas rapi, siap dikirim ke pembeli.',
  },
  {
    image: '/images/dokumentasi/proses-kirim-bibit.webp',
    label: 'Proses Pengiriman Bibit',
    desc: 'Proses pengiriman bibit ke lokasi pembeli, dikemas aman untuk perjalanan.',
  },
  {
    image: '/images/dokumentasi/siap-kirim.webp',
    label: 'Bibit Siap Diantar',
    desc: 'Bibit yang sudah dikemas dan siap naik kendaraan untuk diantar.',
  },
  {
    image: '/images/dokumentasi/tabebuya-perindang-jalan.webp',
    label: 'Bibit Tabebuya Siap Tanam',
    desc: 'Bibit tabebuya untuk perindang jalan dan taman, siap dikirim ke pembeli.',
  },
  {
    image: '/images/dokumentasi/pengunjung-nursery.webp',
    label: 'Kunjungan Langsung ke Nursery',
    desc: 'Pengunjung datang langsung melihat koleksi bibit di nursery Ardelia Bibit.',
  },
];

const stats = [
  { label: 'Foto Pengiriman', value: `${dokumentasi.length}+` },
  { label: 'Wilayah Terjangkau', value: 'Seluruh Indonesia' },
  { label: 'Cara Kirim', value: 'Ekspedisi & ambil sendiri di nursery' },
];
---

<Layout
  title="Dokumentasi Pengiriman Bibit — Ardelia Bibit Purworejo"
  description="Lihat dokumentasi asli proses pengemasan dan pengiriman bibit Ardelia Bibit ke berbagai daerah di Indonesia — dikemas rapi dan aman sampai tujuan."
  breadcrumbs={[{ name: 'Dokumentasi', path: '/dokumentasi' }]}
>
  <PageIntro
    eyebrow="Dokumentasi"
    title="Dokumentasi Pengiriman Bibit"
    subtitle="Supaya Anda tenang, ini bukti nyata bagaimana bibit kami kemas dan kirim ke pelanggan di berbagai daerah."
  />

  <section class="dok-stats">
    <div class="wrap dok-stats-grid">
      {
        stats.map((item) => (
          <div class="dok-stat">
            <b>{item.value}</b>
            <span>{item.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="dok-gallery">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Bukti Kirim</p>
        <h2>Yang Sudah Kami Kirim</h2>
        <p>Beberapa contoh terbaru — akan terus bertambah seiring pengiriman berjalan.</p>
      </div>

      <div class="dok-grid">
        {
          dokumentasi.map((item) => (
            <figure class="dok-card">
              <div class="dok-card-photo">
                <img src={item.image} alt={item.label} loading="lazy" decoding="async" />
              </div>
              <figcaption>
                <b>{item.label}</b>
                <p>{item.desc}</p>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <ClosingCTA
    heading="Mau Kirim ke Daerah Anda?"
    subtitle="Tanyakan ketersediaan bibit dan ongkos kirimnya langsung lewat WhatsApp."
    message="Halo Ardelia Bibit, saya mau tanya soal pengiriman bibit ke daerah saya"
    label="Tanya Pengiriman"
  />
</Layout>

<style>
  .dok-stats {
    padding: 40px 0 8px;
  }

  .dok-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    text-align: center;
  }

  .dok-stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px;
    background: var(--color-mist);
    border-radius: var(--radius);
  }

  .dok-stat b {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--color-teal-dark);
  }

  .dok-stat span {
    font-size: 12.5px;
    color: var(--color-charcoal-soft);
  }

  .dok-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .dok-card {
    margin: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-paper);
  }

  .dok-card-photo {
    aspect-ratio: 4 / 3;
    background: var(--color-mist);
  }

  .dok-card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .dok-card figcaption {
    padding: 14px 16px 16px;
  }

  .dok-card figcaption b {
    display: block;
    font-size: 14.5px;
    color: var(--color-charcoal);
    margin-bottom: 4px;
  }

  .dok-card figcaption p {
    font-size: 13px;
    color: var(--color-charcoal-soft);
    line-height: 1.55;
  }

  @media (max-width: 720px) {
    .dok-stats-grid {
      grid-template-columns: 1fr;
    }

    .dok-grid {
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
  }

  @media (max-width: 480px) {
    .dok-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
