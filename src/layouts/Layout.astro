---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  /** Meta title halaman — WAJIB unik per halaman (checklist playbook §7) */
  title: string;
  /** Meta description halaman — WAJIB unik per halaman */
  description: string;
  /** Path gambar OG (opsional, fallback ke gambar default) */
  ogImage?: string;
  /** Breadcrumb untuk JSON-LD BreadcrumbList. "Beranda" ditambah otomatis di depan. */
  breadcrumbs?: { name: string; path: string }[];
}

const { title, description, ogImage = '/images/og-default.jpg', breadcrumbs = [] } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, site.url).toString();

const breadcrumbItems = [{ name: 'Beranda', path: '/' }, ...breadcrumbs];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="ctXkL6KuBMznNHbs9jCUApY6yQh5nB_k7ubTmcG5HVM" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#164a3b" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, site.url).toString()} />
    <meta property="og:locale" content="id_ID" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!--
      Dimuat async (media="print" trick) supaya CSS font ini tidak
      nge-block render pertama — begitu selesai load, browser langsung
      terapkan ke "all". <noscript> jadi fallback kalau JS/onload
      diblokir. Lihat playbook §QA performa Agustus 2026.
    -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
      />
    </noscript>

    <!-- Schema.org: Organization dasar — disinkronkan dengan konten visible -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'GardenStore',
      name: site.name,
      description: 'Nursery bibit tanaman: buah-buahan, kayu keras & penghijauan, palem hias, dan rempah/rimpang.',
      image: new URL('/images/og-default.jpg', site.url).toString(),
      priceRange: '$$',
      telephone: `+${site.contact.whatsappNumber}`,
      url: site.url,
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.contact.address.street,
        addressLocality: site.contact.address.locality,
        addressRegion: site.contact.address.province,
        postalCode: site.contact.address.postalCode,
        addressCountry: 'ID',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: site.contact.coordinates.lat,
        longitude: site.contact.coordinates.lng,
      },
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: [
          'Monday',
          'Tuesday',
          'Wednesday',
          'Thursday',
          'Friday',
          'Saturday',
          'Sunday',
        ],
        opens: '00:00',
        closes: '23:59',
      },
      sameAs: [site.social.youtube, site.social.facebook, site.social.tiktok, site.contact.googleMapsUrl],
    })} />

    <!-- Schema.org: WebSite (satu kali, dipakai semua halaman) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: site.name,
      url: site.url,
    })} />

    <!-- Schema.org: BreadcrumbList (per halaman, dari prop breadcrumbs) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbItems.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: item.name,
        item: new URL(item.path, site.url).toString(),
      })),
    })} />
  </head>
  <body>
    <a class="skip-link" href="#konten-utama">Langsung ke konten utama</a>

    <Header />

    <main id="konten-utama">
      {
        breadcrumbItems.length > 1 && (
          <nav class="breadcrumb-visual" aria-label="Breadcrumb">
            <div class="wrap">
              <ol>
                {breadcrumbItems.map((item, i) => (
                  <li>
                    {i < breadcrumbItems.length - 1 ? (
                      <a href={item.path}>{item.name}</a>
                    ) : (
                      <span aria-current="page">{item.name}</span>
                    )}
                    {i < breadcrumbItems.length - 1 && (
                      <span class="breadcrumb-sep" aria-hidden="true">/</span>
                    )}
                  </li>
                ))}
              </ol>
            </div>
          </nav>
        )
      }
      <slot />
    </main>

    <Footer />
    <FloatingActions />
  </body>
</html>

<style>
  /*
   * Item 0.6 — breadcrumb visual. Data-nya (breadcrumbItems) sudah ada
   * sejak awal (dipakai untuk schema BreadcrumbList di <head>), di sini
   * cuma dirender jadi elemen visual. Disembunyikan otomatis di Home
   * karena breadcrumbItems cuma berisi "Beranda" sendirian di sana
   * (length === 1) — tidak perlu logic tambahan per halaman.
   */
  .breadcrumb-visual {
    padding: 12px 0;
  }

  .breadcrumb-visual ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumb-visual li {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .breadcrumb-visual a,
  .breadcrumb-visual span {
    font-size: 13px;
    color: var(--color-charcoal-soft);
  }

  .breadcrumb-visual a {
    text-decoration: none;
  }

  .breadcrumb-visual a:hover {
    color: var(--color-teal-dark);
    text-decoration: underline;
  }

  .breadcrumb-visual [aria-current='page'] {
    color: var(--color-charcoal-soft);
  }

  .breadcrumb-sep {
    color: var(--color-line);
  }
</style>
